/* encode_64 and decode_64 of the GF(2^64) additive-FFT reference (target/hqc-fft/gf264_ref/dencoder.c),
   at the hqc-1 sizes: 256 input words (16384 bits) to 512 field elements, and 512 elements back to
   512 words (32768 bits, the product's size).

   Both are F2-linear maps given by the 64-entry matrices _enc_mat and _dec_mat. Reading the byte
   gathers and the 8x8 transposes of the C as bit positions: with the input viewed as 32 rows of 512
   bits (bit 512 j + e is row j, column e), element e of the encoding is the image of column e
   (32 bits) under _enc_mat; and bit 512 t + e of the decoding (t < 64) is bit t of the image of
   element e (64 bits) under _dec_mat. */
module FFTEnc where

encMat : [64][64]
encMat =
 [0x0000000000000001,0xED57CE778F0D6244,0xB66864E6EC14B4D2,0x9CEDEBC39773A213,
  0x54E5BF3774B3F850,0xAA41EC72ACA4D601,0x4943D209FDC449B8,0x6E9A7C0E6D89DC84,
  0xEB42E79F91F49F8C,0x5DC314ADA2848BA2,0x503CDEDAB981D32C,0x21D93AB94919CFD3,
  0x4553B41BDA2FBEC8,0xCB47A62D21DF0B4D,0x4639691AA527DBBA,0xE032E7A43C3D150F,
  0xB0F502E4CD60039A,0xF8287767660AD2B4,0x1DBF8D7727FC654E,0x19B12A51DACBA79E,
  0xE691D7C0794C614D,0x28CF418FAF97A29F,0x0FC5C2BCA45C931C,0x4CB433E14292028E,
  0x189B29840C130E7F,0x315F35290C617710,0x01F4A9DE7438026B,0x6AEA5DF783DD08EF,
  0xB36AE8E530273635,0x837B54AC6006165D,0x49216693BB420E26,0xFD50E246BA0FE1A8,
  0x57A3104FCD0E5F34,0xBFBBCC4E6E818CE9,0x4FF85CDBB8B5A385,0xE5836AC7D88636FF,
  0xACAEE33D357E7115,0xD5591C1E1FCD94AC,0x5A80DDB4EB880892,0x557FEEC300CDAAB7,
  0x5A3FD6353EE07E37,0x5C467F7D2CAF0E9F,0xEAAC97005F61500B,0x9554E988C2331D19,
  0x46FC62831B042EEB,0xE89BD07EBE5CBADC,0x0E442A47D4AB744E,0x492FCD9722316B93,
  0xB86431A85814F803,0xA3C96AFF342C82B8,0x4716CCF6CBC75A1A,0x5B71BEA40E882374,
  0x54AC9EE9B21EBE6E,0x1AAC7F922B29C823,0x49A5F74A2ECB3E44,0x4A5A968CC3B566D1,
  0x0641DDCF92A60AA5,0xEE004D8F989DBA16,0x1C2242E610C9CD6A,0x59F1654505010E32,
  0x0D8DF39E76C0E7B7,0x8CF8E69EB14ECFB4,0x0CB8C5396572FC44,0x3B278B84A916E44C]

decMat : [64][64]
decMat =
 [0x0000000000000001,0x08961B8A7841BFC6,0xFD56DC6306E45EC6,0x77332469D0404105,
  0xD110EB4A970FEAF5,0x9C94931DE38226FE,0x52BF8C5BA0978896,0xBCE2B823BEBF0166,
  0x7AF3356B5D818E41,0x1E7B94C935B698D0,0xBCB73D9AABDD6DDF,0x5F75970481F366A8,
  0xB33F7074D9B6E3FE,0x2ADB64D29A93EF96,0x59DAB92A69394E60,0x3C8004790328459C,
  0xADCB0001CDAA3D05,0x9BB38FD76D5E0C0B,0xABCADD426CB54B4D,0xF042A8F93E8A48B9,
  0x47B25AAB146986F6,0xE750955BE42931A1,0x9BF1D4A1535A0D17,0x91564F9A406D933C,
  0xDED3254B42D33AAA,0xBD1F32C59E84E45D,0xFA018660E3165396,0xA2F911A00F5BAA7B,
  0xE958695BC8926ACD,0xC8C10606A8EC8D6B,0x8E6CFEF54B2E9AC6,0x88007D210E507CF4,
  0x17A89B9796A48397,0x1BDD636A99F218BE,0x7CB821D83481A449,0xFF39584957728D46,
  0x9CD7C0F7B4D02DE7,0x779FCA946B676EDB,0x5235A7728B715838,0x70EF0482C08984A5,
  0xBB1C3DBFE2B5150B,0xEE767356051FE0E1,0x1B5C98D75CC93FE8,0x4C25EE1FB1C8CEB6,
  0xB7310079067F9E51,0x4BE2A5AE359E2594,0x0FE86864026631C3,0x5B4CD59958434683,
  0xE550B2539A848707,0x6E50D13B6A7A5997,0x7FD8FB00A5AEF99A,0xCDBD262AC16E806B,
  0xC021427B4F7646E0,0xD7F262605A9BCDD0,0x0B046630A7EFEDDC,0xA869F3DFCBE24FAB,
  0xA00150323BE9B1DE,0x01294D8724AE3D0D,0x4AB517F07F03A4B1,0xFDC5AF3BB370E266,
  0x2AFF63EFA8285238,0xFBA0ACE42227357A,0xC208107E1C3E5AC1,0xB2DBB5CB68D0DC74]

// The image of a bit vector (bit j = v ! j, as in a word) under a matrix given as rows: XOR of row j for each set bit j.
linmap : {n} (fin n, n <= 64) => [64][64] -> [n] -> [64]
linmap mat v = foldl (^) 0 [ if v ! j then mat @ j else 0 | j <- [0 ..< n] ]

// The 16384 bits of 256 little-endian words, bit p at index p (word p / 64, bit p % 64).
flat : [256][64] -> [16384]
flat fx = join (reverse fx)

unflat : [16384] -> [256][64]
unflat v = reverse (split v)

// encode_64(rfx, 512, fx, 32): element e = _enc_mat applied to column e of the 32 x 512 bit view.
encodeIdx : [256][64] -> [512][64]
encodeIdx fx = [ linmap`{32} encMat (reverse [ fb ! (512 * j + e) | j <- [0 ..< 32] ]) | e <- [0 ..< 512] : [512][14] ]
  where fb = flat fx

// decode_64(rfx, fx, 512), two ways. decodeIdx is the statement: bit 512 t + e of the output (t < 64,
// so 32768 bits = 512 words) is bit t of _dec_mat applied to element e. decode mirrors the C, which
// handles eight elements per batch, builds the eight images rr, and for each byte position k
// transposes the 8 x 8 bit matrix of the k-th bytes of rr and scatters its rows 64 bytes apart; the
// SAW proof of decode_64 is against decode (with transpose_8x8 as an override), and decode == decodeIdx
// is a lemma about the model alone (ref_3.saw).
decodeIdx : [512][64] -> [512][64]
decodeIdx fx = unflat2 (reverse [ (img @ (p % 512)) ! (p / 512) | p <- [0 ..< 32768] : [32768][15] ])
  where img = [ linmap`{64} decMat x | x <- fx ]

unflat2 : [32768] -> [512][64]
unflat2 v = reverse (split v)

// transpose_8x8 (the SWAPMOVE network): row j of the result holds, at bit c, bit j of row c.
transpose8 : [8][8] -> [8][8]
transpose8 m = [ [ (m @ c) ! j | c <- [7, 6 .. 0] : [8][3] ] | j <- [0 .. 7] : [8][3] ]

// Byte k (little-endian) of a 64-bit word.
byteOf : [64] -> [3] -> [8]
byteOf w k = (reverse (split`{8} w)) @ k

decode : [512][64] -> [512][64]
decode fx = unflat2 (join (reverse [ outByte q | q <- [0 ..< 4096] : [4096][12] ]))
  where
    outByte : [12] -> [8]
    outByte q = (transpose8 [ byteOf r k | r <- rr ]) @ j
      where i = drop`{6} q            // output byte q = i + 64 (8 k + j)
            t = take`{6} q
            k = take`{3} t
            j = drop`{3} t
            rr = rows @ i
    rows : [64][8][64]
    rows = [ [ linmap`{64} decMat x | x <- blk ] | blk <- split`{64} fx ]

// ---- hqc-3 size: 1024 elements, 512 input words, 1024 output words ----

// The same for the other sizes: flat3 / flat5 are flat at 512 and 1024 input words.
flat3 : [512][64] -> [32768]
flat3 fx = join (reverse fx)
flat5 : [1024][64] -> [65536]
flat5 fx = join (reverse fx)
// encode_64(rfx, 1024, fx, 32): element e = _enc_mat applied to column e of the 32 x 512 bit view.
encodeIdx3 : [512][64] -> [1024][64]
encodeIdx3 fx = [ linmap`{32} encMat (reverse [ fb ! (1024 * j + e) | j <- [0 ..< 32] ]) | e <- [0 ..< 1024] : [1024][16] ]
  where fb = flat3 fx

// decode_64(rfx, fx, 1024), two ways. decodeIdx3 is the statement: bit 512 t + e of the output (t < 64,
// so 32768 bits = 512 words) is bit t of _dec_mat applied to element e. decode3 mirrors the C, which
// handles eight elements per batch, builds the eight images rr, and for each byte position k
// transposes the 8 x 8 bit matrix of the k-th bytes of rr and scatters its rows 64 bytes apart; the
// SAW proof of decode_64 is against decode3 (with transpose_8x8 as an override), and decode3 == decodeIdx3
// is a lemma about the model alone (ref_3.saw).
decodeIdx3 : [1024][64] -> [1024][64]
decodeIdx3 fx = unflat23 (reverse [ (img @ (p % 1024)) ! (p / 1024) | p <- [0 ..< 65536] : [65536][16] ])
  where img = [ linmap`{64} decMat x | x <- fx ]

unflat23 : [65536] -> [1024][64]
unflat23 v = reverse (split v)



decode3 : [1024][64] -> [1024][64]
decode3 fx = unflat23 (join (reverse [ outByte q | q <- [0 ..< 8192] : [8192][13] ]))
  where
    outByte : [13] -> [8]
    outByte q = (transpose8 [ byteOf r k | r <- rr ]) @ j
      where i = drop`{6} q            // output byte q = i + 64 (8 k + j)
            t = take`{6} q
            k = take`{3} t
            j = drop`{3} t
            rr = rows @ i
    rows : [128][8][64]
    rows = [ [ linmap`{64} decMat x | x <- blk ] | blk <- split`{128} fx ]

// ---- hqc-5 size (generic path, 1024 input words): 2048 elements, 2048 output words ----
// encode_64(rfx, 2048, fx, 32): element e = _enc_mat applied to column e of the 32 x 512 bit view.
encodeIdx5 : [1024][64] -> [2048][64]
encodeIdx5 fx = [ linmap`{32} encMat (reverse [ fb ! (2048 * j + e) | j <- [0 ..< 32] ]) | e <- [0 ..< 2048] : [2048][17] ]
  where fb = flat5 fx

// decode_64(rfx, fx, 2048), two ways. decodeIdx5 is the statement: bit 512 t + e of the output (t < 64,
// so 32768 bits = 512 words) is bit t of _dec_mat applied to element e. decode5 mirrors the C, which
// handles eight elements per batch, builds the eight images rr, and for each byte position k
// transposes the 8 x 8 bit matrix of the k-th bytes of rr and scatters its rows 64 bytes apart; the
// SAW proof of decode_64 is against decode5 (with transpose_8x8 as an override), and decode5 == decodeIdx5
// is a lemma about the model alone (ref_3.saw).
decodeIdx5 : [2048][64] -> [2048][64]
decodeIdx5 fx = unflat25 (reverse [ (img @ (p % 2048)) ! (p / 2048) | p <- [0 ..< 131072] : [131072][17] ])
  where img = [ linmap`{64} decMat x | x <- fx ]

unflat25 : [131072] -> [2048][64]
unflat25 v = reverse (split v)



decode5 : [2048][64] -> [2048][64]
decode5 fx = unflat25 (join (reverse [ outByte q | q <- [0 ..< 16384] : [16384][14] ]))
  where
    outByte : [14] -> [8]
    outByte q = (transpose8 [ byteOf r k | r <- rr ]) @ j
      where i = drop`{6} q            // output byte q = i + 64 (8 k + j)
            t = take`{6} q
            k = take`{3} t
            j = drop`{3} t
            rr = rows @ i
    rows : [256][8][64]
    rows = [ [ linmap`{64} decMat x | x <- blk ] | blk <- split`{256} fx ]

// encode_64 as the C computes it: batch i (of 64) and byte position kk give element 8 i + kk, which is
// the XOR over j < 32 of _enc_mat[j] when bit kk of input byte j * 64 + i is set (collect_inputbits_x8
// gathers those bytes, linear_map_x8 applies the mask). The SAW proof of encode_64 is against this;
// encode == encodeIdx is a lemma about the model alone.
encode : [256][64] -> [512][64]
encode fx = join [ [ foldl (^) 0 [ if (bytes @ (j * 64 + i)) ! kk then encMat @ j else 0 | j <- [0 ..< 32] : [32][11] ]
                      | kk <- [0 ..< 8] : [8][3] ] | i <- [0 ..< 64] : [64][11] ]
  where bytes = reverse (split`{2048} (flat fx))

// encode_64 as the C computes it: batch i (of 128) and byte position kk give element 8 i + kk, which is
// the XOR over j < 32 of _enc_mat[j] when bit kk of input byte j * 128 + i is set (collect_inputbits_x8
// gathers those bytes, linear_map_x8 applies the mask). The SAW proof of encode_64 is against this;
// encode3 == encodeIdx3 is a lemma about the model alone.
encode3 : [512][64] -> [1024][64]
encode3 fx = join [ [ foldl (^) 0 [ if (bytes @ (j * 128 + i)) ! kk then encMat @ j else 0 | j <- [0 ..< 32] : [32][12] ]
                      | kk <- [0 ..< 8] : [8][3] ] | i <- [0 ..< 128] : [128][12] ]
  where bytes = reverse (split`{4096} (flat3 fx))

// encode_64 as the C computes it: batch i (of 256) and byte position kk give element 8 i + kk, which is
// the XOR over j < 32 of _enc_mat[j] when bit kk of input byte j * 256 + i is set (collect_inputbits_x8
// gathers those bytes, linear_map_x8 applies the mask). The SAW proof of encode_64 is against this;
// encode5 == encodeIdx5 is a lemma about the model alone.
encode5 : [1024][64] -> [2048][64]
encode5 fx = join [ [ foldl (^) 0 [ if (bytes @ (j * 256 + i)) ! kk then encMat @ j else 0 | j <- [0 ..< 32] : [32][13] ]
                      | kk <- [0 ..< 8] : [8][3] ] | i <- [0 ..< 256] : [256][13] ]
  where bytes = reverse (split`{8192} (flat5 fx))
