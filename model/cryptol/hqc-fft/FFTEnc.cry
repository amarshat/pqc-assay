/* encode_64 and decode_64 of the GF(2^64) additive-FFT reference (target/hqc-fft/gf264_ref/dencoder.c),
   at the hqc-1 sizes: 256 input words (16384 bits) to 512 field elements, and 512 elements back to
   512 words (32768 bits, the product's size).

   Both are F2-linear maps given by the 64-entry matrices _enc_mat and _dec_mat. Reading the byte
   gathers and the 8x8 transposes of the C as bit positions: with the input viewed as 32 rows of 512
   bits (bit 512 j + e is row j, column e), element e of the encoding is the image of column e
   (32 bits) under _enc_mat; and bit 512 t + e of the decoding (t < 64) is bit t of the image of
   element e (64 bits) under _dec_mat. */
module FFTEnc where

encMat : [64][64]
encMat =
 [0x0000000000000001,0xED57CE778F0D6244,0xB66864E6EC14B4D2,0x9CEDEBC39773A213,
  0x54E5BF3774B3F850,0xAA41EC72ACA4D601,0x4943D209FDC449B8,0x6E9A7C0E6D89DC84,
  0xEB42E79F91F49F8C,0x5DC314ADA2848BA2,0x503CDEDAB981D32C,0x21D93AB94919CFD3,
  0x4553B41BDA2FBEC8,0xCB47A62D21DF0B4D,0x4639691AA527DBBA,0xE032E7A43C3D150F,
  0xB0F502E4CD60039A,0xF8287767660AD2B4,0x1DBF8D7727FC654E,0x19B12A51DACBA79E,
  0xE691D7C0794C614D,0x28CF418FAF97A29F,0x0FC5C2BCA45C931C,0x4CB433E14292028E,
  0x189B29840C130E7F,0x315F35290C617710,0x01F4A9DE7438026B,0x6AEA5DF783DD08EF,
  0xB36AE8E530273635,0x837B54AC6006165D,0x49216693BB420E26,0xFD50E246BA0FE1A8,
  0x57A3104FCD0E5F34,0xBFBBCC4E6E818CE9,0x4FF85CDBB8B5A385,0xE5836AC7D88636FF,
  0xACAEE33D357E7115,0xD5591C1E1FCD94AC,0x5A80DDB4EB880892,0x557FEEC300CDAAB7,
  0x5A3FD6353EE07E37,0x5C467F7D2CAF0E9F,0xEAAC97005F61500B,0x9554E988C2331D19,
  0x46FC62831B042EEB,0xE89BD07EBE5CBADC,0x0E442A47D4AB744E,0x492FCD9722316B93,
  0xB86431A85814F803,0xA3C96AFF342C82B8,0x4716CCF6CBC75A1A,0x5B71BEA40E882374,
  0x54AC9EE9B21EBE6E,0x1AAC7F922B29C823,0x49A5F74A2ECB3E44,0x4A5A968CC3B566D1,
  0x0641DDCF92A60AA5,0xEE004D8F989DBA16,0x1C2242E610C9CD6A,0x59F1654505010E32,
  0x0D8DF39E76C0E7B7,0x8CF8E69EB14ECFB4,0x0CB8C5396572FC44,0x3B278B84A916E44C]

decMat : [64][64]
decMat =
 [0x0000000000000001,0x08961B8A7841BFC6,0xFD56DC6306E45EC6,0x77332469D0404105,
  0xD110EB4A970FEAF5,0x9C94931DE38226FE,0x52BF8C5BA0978896,0xBCE2B823BEBF0166,
  0x7AF3356B5D818E41,0x1E7B94C935B698D0,0xBCB73D9AABDD6DDF,0x5F75970481F366A8,
  0xB33F7074D9B6E3FE,0x2ADB64D29A93EF96,0x59DAB92A69394E60,0x3C8004790328459C,
  0xADCB0001CDAA3D05,0x9BB38FD76D5E0C0B,0xABCADD426CB54B4D,0xF042A8F93E8A48B9,
  0x47B25AAB146986F6,0xE750955BE42931A1,0x9BF1D4A1535A0D17,0x91564F9A406D933C,
  0xDED3254B42D33AAA,0xBD1F32C59E84E45D,0xFA018660E3165396,0xA2F911A00F5BAA7B,
  0xE958695BC8926ACD,0xC8C10606A8EC8D6B,0x8E6CFEF54B2E9AC6,0x88007D210E507CF4,
  0x17A89B9796A48397,0x1BDD636A99F218BE,0x7CB821D83481A449,0xFF39584957728D46,
  0x9CD7C0F7B4D02DE7,0x779FCA946B676EDB,0x5235A7728B715838,0x70EF0482C08984A5,
  0xBB1C3DBFE2B5150B,0xEE767356051FE0E1,0x1B5C98D75CC93FE8,0x4C25EE1FB1C8CEB6,
  0xB7310079067F9E51,0x4BE2A5AE359E2594,0x0FE86864026631C3,0x5B4CD59958434683,
  0xE550B2539A848707,0x6E50D13B6A7A5997,0x7FD8FB00A5AEF99A,0xCDBD262AC16E806B,
  0xC021427B4F7646E0,0xD7F262605A9BCDD0,0x0B046630A7EFEDDC,0xA869F3DFCBE24FAB,
  0xA00150323BE9B1DE,0x01294D8724AE3D0D,0x4AB517F07F03A4B1,0xFDC5AF3BB370E266,
  0x2AFF63EFA8285238,0xFBA0ACE42227357A,0xC208107E1C3E5AC1,0xB2DBB5CB68D0DC74]

// The image of a bit vector (bit j = v ! j, as in a word) under a matrix given as rows: XOR of row j for each set bit j.
linmap : {n} (fin n, n <= 64) => [64][64] -> [n] -> [64]
linmap mat v = foldl (^) 0 [ if v ! j then mat @ j else 0 | j <- [0 ..< n] ]

// The 16384 bits of 256 little-endian words, bit p at index p (word p / 64, bit p % 64).
flat : [256][64] -> [16384]
flat fx = join (reverse fx)

unflat : [16384] -> [256][64]
unflat v = reverse (split v)

// encode_64(rfx, 512, fx, 32): element e = _enc_mat applied to column e of the 32 x 512 bit view.
encode : [256][64] -> [512][64]
encode fx = [ linmap`{32} encMat (reverse [ fb ! (512 * j + e) | j <- [0 ..< 32] ]) | e <- [0 ..< 512] : [512][14] ]
  where fb = flat fx

// decode_64(rfx, fx, 512): bit 512 t + e of the output (t < 64, so 32768 bits = 512 words) is bit t
// of _dec_mat applied to element e.
decode : [512][64] -> [512][64]
decode fx = unflat2 (reverse [ (img @ (p % 512)) ! (p / 512) | p <- [0 ..< 32768] : [32768][15] ])
  where img = [ linmap`{64} decMat x | x <- fx ]

unflat2 : [32768] -> [512][64]
unflat2 v = reverse (split v)
