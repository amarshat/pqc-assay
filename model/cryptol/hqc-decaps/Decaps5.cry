// GENERATED by scripts/hqc_decaps_gen.py from Decaps1.cry; do not edit.
// HQC v5.0.0 decapsulation (crypto_kem_dec), hqc-5: the FO transform with implicit rejection,
// written from the KEM structure, with the PKE and the hash functions as uninterpreted symbols.
// The SAW proof keeps pkeDec, pkeEncU, pkeEncV, hashH, hashG and hashJ uninterpreted, so it holds
// for every decryption, encryption and hash function with these signatures: the rejection logic is
// proved independently of the decoder and of SHA-3.
module Decaps5 where

type NB   = 7205   // VEC_N_SIZE_BYTES
type VB   = 7200   // VEC_N1N2_SIZE_BYTES
type W    = 901    // VEC_N_SIZE_64
type EK   = 7237   // PUBLIC_KEY_BYTES
type SK   = 7333   // SECRET_KEY_BYTES
type CT   = 14421   // CIPHERTEXT_BYTES = NB + VB + SALT
type SEC  = 32     // PARAM_SECURITY_BYTES
type SEED = 32
type SALT = 16
type SS   = 32     // SHARED_SECRET_BYTES

// Stand-ins. Only the names and types matter: the proofs never unfold them.
pkeDec  : [SEED][8] -> [W][64] -> [W][64] -> [SEC][8]
pkeDec _ _ _ = zero
pkeEncU : [EK][8] -> [SEC][8] -> [SEED][8] -> [W][64]
pkeEncU _ _ _ = zero
pkeEncV : [EK][8] -> [SEC][8] -> [SEED][8] -> [W][64]
pkeEncV _ _ _ = zero
hashH   : [EK][8] -> [SEED][8]
hashH _ = zero
hashG   : [SEED][8] -> [SEC][8] -> [SALT][8] -> [SS + SEED][8]
hashG _ _ _ = zero
hashJ   : [SEED][8] -> [SEC][8] -> [W][64] -> [W][64] -> [SALT][8] -> [SS][8]
hashJ _ _ _ _ _ = zero

// Little-endian bytes to 64-bit words, as the C reads a uint8_t buffer through a uint64_t pointer.
toWords : {k} (fin k) => [8 * k][8] -> [k][64]
toWords bs = [ join (reverse b) | b <- groupBy`{8} bs ]

toBytes : {k} (fin k) => [k][64] -> [8 * k][8]
toBytes ws = join [ reverse (split`{8} w) | w <- ws ]

// The ciphertext fields as the C stores them: u and v zero-padded to W words.
ctU : [CT][8] -> [W][64]
ctU c = toWords (take`{NB} c # zero)
ctV : [CT][8] -> [W][64]
ctV c = toWords (take`{VB} (drop`{NB} c) # zero)
ctSalt : [CT][8] -> [SALT][8]
ctSalt c = drop`{NB + VB} c

skEk    : [SK][8] -> [EK][8]
skEk sk = take sk
skDk    : [SK][8] -> [SEED][8]
skDk sk = take (drop`{EK} sk)
skSigma : [SK][8] -> [SEC][8]
skSigma sk = take (drop`{EK + SEED} sk)

// Re-encryption check: the ciphertext's u (first NB bytes) and v (first VB bytes) equal those of the
// re-encryption. The salt of the re-encryption is the ciphertext's own, so it always agrees.
accepts : [CT][8] -> [SK][8] -> Bit
accepts c sk = take`{NB} (toBytes u') == take`{NB} c
            /\ take`{VB} (toBytes v') == take`{VB} (drop`{NB} c)
  where
    ek  = skEk sk
    m   = pkeDec (skDk sk) (ctU c) (ctV c)
    kt  = hashG (hashH ek) m (ctSalt c)
    th  = drop`{SS} kt
    u'  = pkeEncU ek m th
    v'  = pkeEncV ek m th

// The shared secret: G's first SS bytes if the ciphertext re-encrypts, else the rejection key J.
decaps : [CT][8] -> [SK][8] -> [SS][8]
decaps c sk = if accepts c sk then take`{SS} kt else kbar
  where
    ek   = skEk sk
    hek  = hashH ek
    m    = pkeDec (skDk sk) (ctU c) (ctV c)
    kt   = hashG hek m (ctSalt c)
    kbar = hashJ hek (skSigma sk) (ctU c) (ctV c) (ctSalt c)

// The rejection key J(H(ek), sigma, c), and the implicit-rejection property used by the fault
// analysis: on a ciphertext that does not re-encrypt, the output is the rejection key.
rejKey : [CT][8] -> [SK][8] -> [SS][8]
rejKey c sk = hashJ (hashH (skEk sk)) (skSigma sk) (ctU c) (ctV c) (ctSalt c)

rejects : [CT][8] -> [SK][8] -> [SS][8] -> Bit
rejects c sk k = ~ accepts c sk ==> k == rejKey c sk

// Leak check (self-composition): hash_g is the function hashGe e, with e = 0 in the first run and
// 1 in the second, so the two runs see independent G outputs and the same everything else.
hashGe : [8] -> [SEED][8] -> [SEC][8] -> [SALT][8] -> [SS + SEED][8]
hashGe _ _ _ _ = zero

acceptsE : [8] -> [CT][8] -> [SK][8] -> Bit
acceptsE e c sk = take`{NB} (toBytes u') == take`{NB} c
               /\ take`{VB} (toBytes v') == take`{VB} (drop`{NB} c)
  where
    ek  = skEk sk
    m   = pkeDec (skDk sk) (ctU c) (ctV c)
    kt  = hashGe e (hashH ek) m (ctSalt c)
    th  = drop`{SS} kt
    u'  = pkeEncU ek m th
    v'  = pkeEncV ek m th

// Rejected in both runs implies equal outputs: the output on rejection does not depend on G.
noLeak : [CT][8] -> [SK][8] -> [SS][8] -> [SS][8] -> Bit
noLeak c sk k1 k2 = (~ acceptsE 0 c sk /\ ~ acceptsE 1 c sk) ==> k1 == k2

// A secret key of distinct-looking bytes (period 251), for refutations in a pinned sub-domain:
// slices of it at different offsets differ.
skRamp : [SK][8]
skRamp = [ drop`{8} (i % 251) | (i : [16]) <- [0 .. 7332] ]
