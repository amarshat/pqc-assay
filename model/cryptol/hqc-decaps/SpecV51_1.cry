// HQC-KEM.Decaps at hqc-1, written from the HQC specification of 12 October 2026
// (pqc-hqc.org/doc/hqc_specifications_2026_10_12.pdf, sha256 00970347...e5a9d5): Section 3.1
// (Table 3), HQC-KEM.Keygen (p. 41) and HQC-KEM.Decaps (p. 43). Written without reference to
// DecapsV51_1.cry. Byte strings follow the document: c_KEM = u || v || salt, G and J take the
// concatenations the document gives, and HQC-PKE.Decrypt may return the failure symbol (bottom).
// XOF.Init, XOF.GetBytes, HQC-PKE.Keygen/Encrypt/Decrypt, G, H and J are uninterpreted.
module SpecV51_1 where

type NB   = 2209          // ceil(n / 8), n = 17669
type VB   = 2208          // ceil(n1 n2' / 8)
type SALT = 16
type CT   = NB + VB + SALT
type SEED = 32
type EK   = SEED + NB     // |ek_KEM| = |seed| + ceil(n / 8)
type MB   = 16            // ceil(k / 8), k = 128
type KB   = 32            // |K|
type XS   = 26            // XOF context, opaque

XOF_Init      : [SEED][8] -> [8] -> [XS][64]
XOF_Init _ _ = zero
// The second argument of XOF_Init is the byte v5.1.0 appends to the seed, k / 8. The document's
// XOF.Init (Table 3) absorbs the seed alone; here the specification follows the C.
XofSep : [8]
XofSep = 16
XOF_Get_seed  : [XS][64] -> ([XS][64], [SEED][8])
XOF_Get_seed _ = zero
XOF_Get_sigma : [XS][64] -> ([XS][64], [MB][8])
XOF_Get_sigma _ = zero
PKE_Keygen    : [SEED][8] -> ([EK][8], [SEED][8])
PKE_Keygen _ = zero
PKE_Decrypt   : [SEED][8] -> [NB][8] -> [VB][8] -> (Bit, [MB][8])    // (bottom?, m)
PKE_Decrypt _ _ _ = zero
PKE_Encrypt   : [EK][8] -> [MB][8] -> [SEED][8] -> ([NB][8], [VB][8])
PKE_Encrypt _ _ _ = zero
H : [EK][8] -> [SEED][8]
H _ = zero
G : [SEED + MB + SALT][8] -> [KB + SEED][8]
G _ = zero
J : [SEED + MB + CT][8] -> [KB][8]
J _ = zero

// HQC-KEM.Decaps(dk_KEM, c_KEM), steps 1 to 15.
Decaps : [SEED][8] -> [CT][8] -> [KB][8]
Decaps dkKEM cKEM = if bot \/ cKEM' != cKEM then Kbar else K'
  where
    ctx0            = XOF_Init dkKEM XofSep                // 2
    (ctx1, seedPKE) = XOF_Get_seed ctx0                    // 3
    (ekPKE, dkPKE)  = PKE_Keygen seedPKE                   // 4
    (_, sigma)      = XOF_Get_sigma ctx1                   // 6
    (u, v, salt)    = (take`{NB} cKEM, take`{VB} (drop`{NB} cKEM), drop`{NB + VB} cKEM)   // 8
    (bot, m')       = PKE_Decrypt dkPKE u v                // 10
    Kt              = G (H ekPKE # m' # salt)              // 12
    (K', theta')    = (take`{KB} Kt, drop`{KB} Kt)
    (u', v')        = PKE_Encrypt ekPKE m' theta'          // 13
    cKEM'           = u' # v' # salt
    Kbar            = J (H ekPKE # sigma # cKEM)           // 14

// Bytes of a little-endian word array, for the C's word-array buffers.
toBytes : {k} (fin k) => [k][64] -> [8 * k][8]
toBytes ws = join [ reverse (split`{8} w) | w <- ws ]
toWords : {k} (fin k) => [8 * k][8] -> [k][64]
toWords bs = [ join (reverse b) | b <- groupBy`{8} bs ]

// The 7 bytes of the C's u' buffer after the 2209 bytes of u' (not compared, not hashed).
PKE_EncPad : [EK][8] -> [MB][8] -> [SEED][8] -> [7][8]
PKE_EncPad _ _ _ = zero
