/* Toom-Cook 3 over GF(2)[x] as the AVX2 toom_3_mult computes it for hqc-1 and hqc-3: three p-word
   thirds, each padded to p + 2 words for the 3-way Karatsuba m below, evaluated at 0, 1, y, 1 + y and
   infinity with y = x^64 (one word). Interpolation divides by y (drop one word) and by 1 + y (prefix
   XOR of words). The steps are separate functions so each has its own Isabelle lemma. */
module Toom where

// Prefix XOR over words: exact division by 1 + x^64 when the input is a multiple of it
// (divide_by_x_plus_one_256).
pxor : {n} (fin n, n >= 1) => [n][64] -> [n][64]
pxor t = drop`{1} (scanl (^) zero t)

// The three p-word thirds of a 3p-word operand, each padded to p + 2 words.
tU0 : {p} (fin p) => [3*p][64] -> [p+2][64]
tU0 a = take`{p} a # zero
tU1 : {p} (fin p) => [3*p][64] -> [p+2][64]
tU1 a = take`{p,p} (drop`{p} a) # zero
tU2 : {p} (fin p) => [3*p][64] -> [p+2][64]
tU2 a = drop`{2*p} a # zero

// U(1) = u0 + u1 + u2, and (u1 + u2 y) y = u1 y + u2 y^2 (the C's W0 before adding U0).
tS : {p} (fin p) => [3*p][64] -> [p+2][64]
tS a = tU0`{p} a ^ tU1`{p} a ^ tU2`{p} a
tY : {p} (fin p, p >= 1) => [3*p][64] -> [p+2][64]
tY a = take`{p+2} ([zero] # tU1`{p} a) ^ take`{p+2} ([zero, zero] # tU2`{p} a)

// Interpolation from W(0) = p0, W(1) = w1, W(y) = p2, W(1 + y) = p3, W(inf) = p4.
// (W(y) + W(0)) / y
tQ2 : {p} (fin p) => [2*p+4][64] -> [2*p+4][64] -> [2*p+4][64]
tQ2 p0 p2 = drop`{1,2*p+3} (p2 ^ p0) # [zero]
// W2 + W3 = (Q2 + W(1 + y) + W(y) + W(inf) (1 + y^3)) / (1 + y), in 2p words
tD2 : {p} (fin p, p >= 1) => [2*p+4][64] -> [2*p+4][64] -> [2*p+4][64] -> [2*p+4][64] -> [2*p+4][64]
tD2 p0 p2 p3 p4 = take`{2*p,4} (pxor`{2*p+4} (tQ2`{p} p0 p2 ^ p3 ^ p2 ^ p4 ^ take`{2*p+4,3} ([zero, zero, zero] # p4))) # zero
// W3 = (W(1 + y) + W(y) + W(1) + W(0)) / (y (1 + y)), in 2p words
tD3 : {p} (fin p, p >= 1) => [2*p+4][64] -> [2*p+4][64] -> [2*p+4][64] -> [2*p+4][64] -> [2*p+4][64]
tD3 w1 p0 p2 p3 = take`{2*p,4} (pxor`{2*p+4} (drop`{1} (p3 ^ p2 ^ w1 ^ p0) # [zero])) # zero
// W1 = W(1) + W(0) + (W2 + W3) + W(inf);  W2 = (W2 + W3) + W3
tE1 : {p} (fin p, p >= 1) => [2*p+4][64] -> [2*p+4][64] -> [2*p+4][64] -> [2*p+4][64] -> [2*p+4][64] -> [2*p+4][64]
tE1 w1 p0 p2 p3 p4 = w1 ^ p0 ^ tD2`{p} p0 p2 p3 p4 ^ p4
tE2 : {p} (fin p, p >= 1) => [2*p+4][64] -> [2*p+4][64] -> [2*p+4][64] -> [2*p+4][64] -> [2*p+4][64] -> [2*p+4][64]
tE2 w1 p0 p2 p3 p4 = tD2`{p} p0 p2 p3 p4 ^ tD3`{p} w1 p0 p2 p3

// W0 + W1 Y + W2 Y^2 + W3 Y^3 + W4 Y^4 with Y = x^(64 p), in 6p + 4 words.
tR : {p} (fin p) => [2*p+4][64] -> [2*p+4][64] -> [2*p+4][64] -> [2*p+4][64] -> [2*p+4][64] -> [6*p+4][64]
tR w0 w1 w2 w3 w4 = take`{6*p+4} (r0 ^ r1 ^ r2 ^ r3 ^ r4)
  where
    r0 = w0 # (zero : [4*p+8][64])
    r1 = (zero : [p][64]) # w1 # (zero : [3*p+8][64])
    r2 = (zero : [2*p][64]) # w2 # (zero : [2*p+8][64])
    r3 = (zero : [3*p][64]) # w3 # (zero : [p+8][64])
    r4 = (zero : [4*p][64]) # w4 # (zero : [8][64])

toom3 : {p} (fin p, p >= 4) => ([p+2][64] -> [p+2][64] -> [2*p+4][64]) -> [3*p][64] -> [3*p][64] -> [6*p+4][64]
toom3 m a b = tR`{p} p0 (tE1`{p} w1 p0 p2 p3 p4) (tE2`{p} w1 p0 p2 p3 p4) (tD3`{p} w1 p0 p2 p3) p4
  where
    w1 = m (tS`{p} b) (tS`{p} a)
    p3 = m (tS`{p} a ^ tY`{p} a) (tS`{p} b ^ tY`{p} b)
    p2 = m (tY`{p} a ^ tU0`{p} a) (tY`{p} b ^ tU0`{p} b)
    p4 = m (tU2`{p} a) (tU2`{p} b)
    p0 = m (tU0`{p} a) (tU0`{p} b)
