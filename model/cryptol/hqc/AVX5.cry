/* The AVX2 vect_mul of HQC v5.0.0 for hqc-5 (target/hqc/avx2/hqc-5/gf2x.c): a Karatsuba ladder over
   256-bit vectors up to 64 words, the 5-way level karat_mult_5 on 320 words, Toom-3 on 936 words at
   256-bit granularity (y = x^256, arrays padded by two vectors), and the fold mod x^57637 - 1. */
module AVX5 where

import GF2X
import KM5
import AVXK
import Toom5
import Fold

km16 : [16][64] -> [16][64] -> [32][64]
km16 = kstep`{8,8} km8 km8
km32 : [32][64] -> [32][64] -> [64][64]
km32 = kstep`{16,16} km16 km16
km64 : [64][64] -> [64][64] -> [128][64]
km64 = kstep`{32,32} km32 km32
km320 : [320][64] -> [320][64] -> [640][64]
km320 = k5step`{64} km64

// toom_3_mult: 936 words = three thirds of 78 blocks, each padded by two blocks for karat_mult_5.
tm5 : [936][64] -> [936][64] -> [1872][64]
tm5 = toom5 km320

// vect_mul: the Toom product folded mod x^57637 - 1, as 901 words; vmulBytes is the 7205 bytes the
// C writes (little-endian words).
vmulA : [936][64] -> [936][64] -> [901][64]
vmulA a b = fold`{57637} (take`{1802} (tm5 a b))

vmulBytes : [936][64] -> [936][64] -> [7205][8]
vmulBytes a b = take`{7205} (join [ reverse (split`{8} x) | x <- vmulA a b ])
