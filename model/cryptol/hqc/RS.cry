/* HQC's Reed-Solomon code over GF(2^8), as a property: a codeword c of length n1 (c[i] the
   coefficient of x^i) is in the code iff c(alpha^i) = 0 for i = 1 .. 2*delta, alpha = 2. For
   systematic encoding the message occupies the top k positions; together these determine the
   n1 - k = 2*delta parity positions uniquely. */
module RS where

import GF256

// c(x), Horner from the top coefficient.
rsEval : {n} (fin n) => [n]GF -> GF -> GF
rsEval c x = foldr (\ci acc -> ci ^ gfMul x acc) 0 c

isRS : {n, d} (fin n, fin d, d >= 1, 8 >= width (2 * d)) => [n]GF -> Bit
isRS c = and [ rsEval c (gfPow 2 i) == 0 | i <- [1 .. 2 * d] : [2 * d][8] ]
