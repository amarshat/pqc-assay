/* Lift-friendly variant of fips204_ntt.cry for the Tier-2 Isabelle proof.
 * IDENTICAL to fips204_ntt EXCEPT the zeta table is built with a FINITE
 * self-referential stream (`take`{255}`) instead of the infinite `powseq`:
 * cryptol-to-isabelle rejects the `inf` type (Unsupported cryptol type: inf).
 * Table equality with the original is machine-checked in lift_table_eq.cry
 * (`:prove tables_equal` => Q.E.D.), so this introduces no spec drift.
 */

module fips204_ntt_lift where

type W = [64]

q : W
q = 8380417

// zeta^BitRev_8(k) mod q, zeta = 1753 — the table FIPS 204 Appendix B tabulates
zetabrv : [256][32]
zetabrv = [ drop`{32} (pows @ (reverse k)) | k <- [0..255] : [256][8] ]
  where pows = powseq
        powseq : [256][64]
        powseq = [1] # [ (p * 1753) % q | p <- take`{255} powseq ]

// one forward layer (Algorithm 41 body at a given len, iter = 128/len, m0)
nttLayerFwd : W -> W -> W -> [256][32] -> [256][32]
nttLayerFwd len iter m0 w = [ f (zext p) | p <- [0..255] : [256][8] ]
  where
    wAt : W -> W
    wAt i = zext (w @ i)
    f : W -> [32]
    f p = if blk >= iter then w @ p             // position not touched this layer
          else if off < len
          then drop`{32} ((wAt p + t) % q)                 // w[j] = w[j] + t
          else drop`{32} ((wAt (p - len) + q - tHi) % q)   // w[j+len] = w[j] - t
      where
        blk = p / (2 * len)
        off = p % (2 * len)
        z   = zext (zetabrv @ (m0 + blk + 1))
        t   = (z * wAt (p + len)) % q          // for the lower-half position
        tHi = (z * wAt p) % q                  // same t, seen from the upper half

// one inverse layer (Algorithm 42 body; m pre-decremented from m0 per block)
nttLayerInv : W -> W -> W -> [256][32] -> [256][32]
nttLayerInv len iter m0 w = [ f (zext p) | p <- [0..255] : [256][8] ]
  where
    wAt : W -> W
    wAt i = zext (w @ i)
    f : W -> [32]
    f p = if blk >= iter then w @ p
          else if off < len
          then drop`{32} ((wAt p + wAt (p + len)) % q)       // w[j] = t + w[j+len]
          else drop`{32} ((z * tHi) % q)                     // w[j+len] = -zeta * (t - w[j+len])
      where
        blk = p / (2 * len)
        off = p % (2 * len)
        z   = (q - zext (zetabrv @ (m0 - 1 - blk))) % q
        tHi = (wAt (p - len) + q - wAt p) % q

// Reference (plain `% q` transcription) full Alg 41/42 loops, for the Tier-1
// composition faithfulness check against the compositional version.
fwdParamsRef : [8]([64], [64], [64])
fwdParamsRef = [ (128,1,0), (64,2,1), (32,4,3), (16,8,7),
                 (8,16,15), (4,32,31), (2,64,63), (1,128,127) ]

invParamsRef : [8]([64], [64], [64])
invParamsRef = [ (1,128,256), (2,64,128), (4,32,64), (8,16,32),
                 (16,8,16), (32,4,8), (64,2,4), (128,1,2) ]

nttFwdAllRef : [256][32] -> [256][32]
nttFwdAllRef w0 = foldl step w0 fwdParamsRef
  where step w (len, iter, m0) = nttLayerFwd len iter m0 w

nttInvAllRef : [256][32] -> [256][32]
nttInvAllRef w0 = foldl step w0 invParamsRef
  where step w (len, iter, m0) = nttLayerInv len iter m0 w
