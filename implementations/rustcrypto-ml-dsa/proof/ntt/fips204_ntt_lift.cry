/* Lift-friendly variant of fips204_ntt.cry for the Tier-2 Isabelle proof.
 * IDENTICAL to fips204_ntt EXCEPT the zeta table is an explicit 256-entry
 * LITERAL instead of the recursive `powseq` stream: cryptol-to-isabelle
 * rejects both the infinite stream (Unsupported type: inf) AND the finite
 * self-referential stream (recursive let in cryptol_definition). The literal
 * is machine-checked equal to the original recursive table in lift_table_eq.cry
 * (`:prove tables_equal` => Q.E.D.), so this introduces no spec drift.
 */

module fips204_ntt_lift where

type W = [64]

q : W
q = 8380417

// zeta^BitRev_8(k) mod q, zeta = 1753 — explicit literal (see header).
zetabrv : [256][32]
zetabrv = [ 1, 4808194, 3765607, 3761513, 5178923, 5496691, 5234739, 5178987, 7778734, 3542485, 2682288, 2129892, 3764867, 7375178, 557458, 7159240, 5010068, 4317364, 2663378, 6705802, 4855975, 7946292, 676590, 7044481, 5152541, 1714295, 2453983, 1460718, 7737789, 4795319, 2815639, 2283733, 3602218, 3182878, 2740543, 4793971, 5269599, 2101410, 3704823, 1159875, 394148, 928749, 1095468, 4874037, 2071829, 4361428, 3241972, 2156050, 3415069, 1759347, 7562881, 4805951, 3756790, 6444618, 6663429, 4430364, 5483103, 3192354, 556856, 3870317, 2917338, 1853806, 3345963, 1858416, 3073009, 1277625, 5744944, 3852015, 4183372, 5157610, 5258977, 8106357, 2508980, 2028118, 1937570, 4564692, 2811291, 5396636, 7270901, 4158088, 1528066, 482649, 1148858, 5418153, 7814814, 169688, 2462444, 5046034, 4213992, 4892034, 1987814, 5183169, 1736313, 235407, 5130263, 3258457, 5801164, 1787943, 5989328, 6125690, 3482206, 4197502, 7080401, 6018354, 7062739, 2461387, 3035980, 621164, 3901472, 7153756, 2925816, 3374250, 1356448, 5604662, 2683270, 5601629, 4912752, 2312838, 7727142, 7921254, 348812, 8052569, 1011223, 6026202, 4561790, 6458164, 6143691, 1744507, 1753, 6444997, 5720892, 6924527, 2660408, 6600190, 8321269, 2772600, 1182243, 87208, 636927, 4415111, 4423672, 6084020, 5095502, 4663471, 8352605, 822541, 1009365, 5926272, 6400920, 1596822, 4423473, 4620952, 6695264, 4969849, 2678278, 4611469, 4829411, 635956, 8129971, 5925040, 4234153, 6607829, 2192938, 6653329, 2387513, 4768667, 8111961, 5199961, 3747250, 2296099, 1239911, 4541938, 3195676, 2642980, 1254190, 8368000, 2998219, 141835, 8291116, 2513018, 7025525, 613238, 7070156, 6161950, 7921677, 6458423, 4040196, 4908348, 2039144, 6500539, 7561656, 6201452, 6757063, 2105286, 6006015, 6346610, 586241, 7200804, 527981, 5637006, 6903432, 1994046, 2491325, 6987258, 507927, 7192532, 7655613, 6545891, 5346675, 8041997, 2647994, 3009748, 5767564, 4148469, 749577, 4357667, 3980599, 2569011, 6764887, 1723229, 1665318, 2028038, 1163598, 5011144, 3994671, 8368538, 7009900, 3020393, 3363542, 214880, 545376, 7609976, 3105558, 7277073, 508145, 7826699, 860144, 3430436, 140244, 6866265, 6195333, 3123762, 2358373, 6187330, 5365997, 6663603, 2926054, 7987710, 8077412, 3531229, 4405932, 4606686, 1900052, 7598542, 1054478, 7648983 ]

// one forward layer (Algorithm 41 body at a given len, iter = 128/len, m0)
nttLayerFwd : W -> W -> W -> [256][32] -> [256][32]
nttLayerFwd len iter m0 w = [ f (zext p) | p <- [0..255] : [256][8] ]
  where
    wAt : W -> W
    wAt i = zext (w @ i)
    f : W -> [32]
    f p = if blk >= iter then w @ p             // position not touched this layer
          else if off < len
          then drop`{32} ((wAt p + t) % q)                 // w[j] = w[j] + t
          else drop`{32} ((wAt (p - len) + q - tHi) % q)   // w[j+len] = w[j] - t
      where
        blk = p / (2 * len)
        off = p % (2 * len)
        z   = zext (zetabrv @ (m0 + blk + 1))
        t   = (z * wAt (p + len)) % q          // for the lower-half position
        tHi = (z * wAt p) % q                  // same t, seen from the upper half

// one inverse layer (Algorithm 42 body; m pre-decremented from m0 per block)
nttLayerInv : W -> W -> W -> [256][32] -> [256][32]
nttLayerInv len iter m0 w = [ f (zext p) | p <- [0..255] : [256][8] ]
  where
    wAt : W -> W
    wAt i = zext (w @ i)
    f : W -> [32]
    f p = if blk >= iter then w @ p
          else if off < len
          then drop`{32} ((wAt p + wAt (p + len)) % q)       // w[j] = t + w[j+len]
          else drop`{32} ((z * tHi) % q)                     // w[j+len] = -zeta * (t - w[j+len])
      where
        blk = p / (2 * len)
        off = p % (2 * len)
        z   = (q - zext (zetabrv @ (m0 - 1 - blk))) % q
        tHi = (wAt (p - len) + q - wAt p) % q

// Reference (plain `% q` transcription) full Alg 41/42 loops, for the Tier-1
// composition faithfulness check against the compositional version.
fwdParamsRef : [8]([64], [64], [64])
fwdParamsRef = [ (128,1,0), (64,2,1), (32,4,3), (16,8,7),
                 (8,16,15), (4,32,31), (2,64,63), (1,128,127) ]

invParamsRef : [8]([64], [64], [64])
invParamsRef = [ (1,128,256), (2,64,128), (4,32,64), (8,16,32),
                 (16,8,16), (32,4,8), (64,2,4), (128,1,2) ]

nttFwdAllRef : [256][32] -> [256][32]
nttFwdAllRef w0 = foldl step w0 fwdParamsRef
  where step w (len, iter, m0) = nttLayerFwd len iter m0 w

nttInvAllRef : [256][32] -> [256][32]
nttInvAllRef w0 = foldl step w0 invParamsRef
  where step w (len, iter, m0) = nttLayerInv len iter m0 w
