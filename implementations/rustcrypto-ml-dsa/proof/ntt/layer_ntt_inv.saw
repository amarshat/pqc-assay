enable_experimental;
// INVERSE NTT layers: RustCrypto `ntt_inverse_layer<LEN,ITERATIONS>` == FIPS 204
// Algorithm 42 layer body, for ALL 8 inverse layers (LEN = 1,2,...,128).
//
// Same tractability technique as layer_ntt_fwd.saw: compositional spec
// (fips204_ntt_comp.cry nttLayerInv) + field ops kept UNINTERPRETED so the goal
// is the structural Alg-42 butterfly routing
//   t = w[j]; w[j] = t + w[j+len]; w[j+len] = (-zeta) * (t - w[j+len])
// (the (-zeta) is the impl's Elem neg = negS). Field-op correctness (== mod q)
// is the separate field_ops_bridged.saw obligation. The per-layer m counter
// DECREMENTS from m0 (256,128,...,2); the layer advances it by -ITERATIONS.
//
// The final scaling by 256^{-1} (INVERSE_256) lives OUTSIDE the layers, in
// Algorithm 42's caller -- not part of the per-layer claim (matches the spec).
import "fips204_ntt_comp.cry";

m <- mir_load_module "../../build/mldsa_harness.linked-mir.json";

let bf_adt = mir_find_adt m "ml_dsa::algebra::BaseField" [];
let elem_adt = mir_find_adt m "module_lattice::algebra::Elem" [mir_adt bf_adt];
let elem x = mir_struct_value elem_adt [mir_term x];

let unop_spec spec = do {
    a <- mir_fresh_var "a" mir_u32;
    mir_execute_func [elem a];
    mir_return (elem (spec a));
};
let binop_spec spec = do {
    a <- mir_fresh_var "a" mir_u32;
    b <- mir_fresh_var "b" mir_u32;
    mir_execute_func [elem a, elem b];
    mir_return (elem (spec a b));
};
neg_ov <- mir_unsafe_assume_spec m "module_lattice::algebra::{impl#3}::neg::_instd1dae7dc341bae50"
    (unop_spec (\a -> {{ negS a }}));
add_ov <- mir_unsafe_assume_spec m "module_lattice::algebra::{impl#4}::add::_instd1dae7dc341bae50"
    (binop_spec (\a b -> {{ addS a b }}));
sub_ov <- mir_unsafe_assume_spec m "module_lattice::algebra::{impl#5}::sub::_instd1dae7dc341bae50"
    (binop_spec (\a b -> {{ subS a b }}));
mul_ov <- mir_unsafe_assume_spec m "module_lattice::algebra::{impl#6}::mul::_instd1dae7dc341bae50"
    (binop_spec (\a b -> {{ mulS a b }}));
let field_ovs = [neg_ov, add_ov, sub_ov, mul_ov];

idxs <- eval_list {{ [0..255] : [256][8] }};

let layer_inv_spec lenv iterv m0v = do {
    ws <- mir_fresh_var "w" (mir_array 256 mir_u32);
    mir_precond {{ all (\c -> c < 8380417) ws }};
    in_els <- for idxs (\i -> return (mir_struct_value elem_adt [mir_term {{ ws @ i }}]));
    w_ref <- mir_alloc_mut (mir_array 256 (mir_adt elem_adt));
    mir_points_to w_ref (mir_array_value (mir_adt elem_adt) in_els);

    m_ref <- mir_alloc_mut mir_usize;
    mir_points_to m_ref (mir_term m0v);

    mir_execute_func [w_ref, m_ref];

    out_els <- for idxs (\i -> return (mir_struct_value elem_adt
                  [mir_term {{ (nttLayerInv lenv iterv m0v ws) @ i }}]));
    mir_points_to w_ref (mir_array_value (mir_adt elem_adt) out_els);
    mir_points_to m_ref (mir_term {{ m0v - iterv }});
};

let prove_inv lenv iterv m0v label instname = do {
    print (str_concat "Proving inverse layer " label);
    mir_verify m (str_concat "ml_dsa::ntt::ntt_inverse_layer::_inst" instname) field_ovs false
        (layer_inv_spec lenv iterv m0v)
        // negS is interpreted (it only ever applies to the concrete zeta
        // constants, where the impl const-folds -ZETA[m]; keeping it uninterpreted
        // would not match that folded literal). add/sub/mul stay uninterpreted so
        // the symbolic-w routing goal stays structural.
        do { simplify (cryptol_ss ()); w4_unint_z3 ["addS","subS","mulS"]; };
};

i1   <- prove_inv {{ 1:[64] }}   {{ 128:[64] }} {{ 256:[64] }} "LEN=1"   "c0748752eb2ed297";
i2   <- prove_inv {{ 2:[64] }}   {{ 64:[64] }}  {{ 128:[64] }} "LEN=2"   "48c7fd486167401c";
i4   <- prove_inv {{ 4:[64] }}   {{ 32:[64] }}  {{ 64:[64] }}  "LEN=4"   "66b65a364dc120b6";
i8   <- prove_inv {{ 8:[64] }}   {{ 16:[64] }}  {{ 32:[64] }}  "LEN=8"   "9471875d66adb9c1";
i16  <- prove_inv {{ 16:[64] }}  {{ 8:[64] }}   {{ 16:[64] }}  "LEN=16"  "a45600aa48b5ca91";
i32  <- prove_inv {{ 32:[64] }}  {{ 4:[64] }}   {{ 8:[64] }}   "LEN=32"  "ddc4e2b69758b719";
i64  <- prove_inv {{ 64:[64] }}  {{ 2:[64] }}   {{ 4:[64] }}   "LEN=64"  "afa961b366089a1e";
i128 <- prove_inv {{ 128:[64] }} {{ 1:[64] }}   {{ 2:[64] }}   "LEN=128" "4c08bb177e505583";

// Non-vacuity: a spec whose output[0] is perturbed by +1 must be REJECTED.
let layer_inv_spec_bad lenv iterv m0v = do {
    ws <- mir_fresh_var "w" (mir_array 256 mir_u32);
    mir_precond {{ all (\c -> c < 8380417) ws }};
    in_els <- for idxs (\i -> return (mir_struct_value elem_adt [mir_term {{ ws @ i }}]));
    w_ref <- mir_alloc_mut (mir_array 256 (mir_adt elem_adt));
    mir_points_to w_ref (mir_array_value (mir_adt elem_adt) in_els);
    m_ref <- mir_alloc_mut mir_usize;
    mir_points_to m_ref (mir_term m0v);
    mir_execute_func [w_ref, m_ref];
    out_els <- for idxs (\i -> return (mir_struct_value elem_adt
                  [mir_term {{ ((nttLayerInv lenv iterv m0v ws) @ i) + (if i == (0:[8]) then 1 else 0) }}]));
    mir_points_to w_ref (mir_array_value (mir_adt elem_adt) out_els);
    mir_points_to m_ref (mir_term {{ m0v - iterv }});
};
fails (mir_verify m "ml_dsa::ntt::ntt_inverse_layer::_inst48c7fd486167401c" field_ovs false
    (layer_inv_spec_bad {{ 2:[64] }} {{ 64:[64] }} {{ 128:[64] }})
    do { simplify (cryptol_ss ()); w4_unint_z3 ["addS","subS","mulS"]; });
print "NON-VACUITY (inverse): perturbed layer spec correctly REJECTED";

print "ALL 8 INVERSE NTT LAYERS VERIFIED: ntt_inverse_layer<LEN,ITER> == FIPS 204 Algorithm 42 (field ops uninterpreted; correctness in field_ops_bridged.saw; 256^-1 scaling is outside the layers)";
