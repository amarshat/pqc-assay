enable_experimental;
// module_lattice Elem<BaseField> field arithmetic == arithmetic mod q,
// WITH the escape-2 admit: this file ASSUMES barrett_reduce(x) == x mod q at the
// full product domain x < 2^46 via mir_unsafe_assume_spec (br_ov, below). This is
// the Path-1 build from the path fork.
//
// Trust decomposition (auditable; recorded in docs/ASSUMPTIONS.md). Be precise about
// what THIS file does vs what is mechanized elsewhere:
//   WHAT THIS FILE DOES:
//     - ASSUME (mir_unsafe_assume_spec, br_ov): impl barrett_reduce == x mod q for x < 2^46.
//       This is the whole-function admit. Nothing in this file proves it.
//   MECHANIZED ELSEWHERE (supporting evidence, NOT wired into br_ov):
//     - escape2_core.saw (z3): barrettInt X == X % q for all X in [0,2^46)  (Integer identity)
//     - barrett_bridge_evidence.saw (z3): barrettBV x == x % q for x < 2^24  (BV model, small width)
//     - Route Y, Isabelle `Barrett` session (no smt, no oracle -- kernel-checked):
//         barrettBV x == x mod q for x < 2^46, over the tool-lifted barrettBV
//         (Barrett_Lift.thy == cryptol-to-isabelle(barrett_bridge.cry), gated by
//          scripts/lift_check_barrett.sh). This de-admits the earlier "nine bvToInt
//          homomorphisms" spike (spike2_lift.saw), but is a statement about barrettBV.
//   STILL UN-MECHANIZED (the reason br_ov stays an assume):
//     - the structural equivalence  MIR barrett_reduce == barrettBV  at full width (~66+ bits):
//       bare SMT stalls on it (z3 ran 3h15m without converging; saw-script #3306). Route Y does
//       NOT address this link. Closing the admit would need MIR==barrettBV proven, then chained
//       with Route Y's barrettBV==x mod q. barrettBV mirrors the impl arithmetic by inspection
//       (barrett_bridge.cry) and matches it at width < 2^24 (barrett_bridge_evidence.saw).
//
//   neg(a)   = (q - a) mod q
//   add(a,b) = (a + b) mod q
//   sub(a,b) = (a - b) mod q
//   mul(a,b) = (a * b) mod q   (via bridged barrett_reduce override)

m <- mir_load_module "../../build/mldsa_harness.linked-mir.json";

let bf_adt = mir_find_adt m "ml_dsa::algebra::BaseField" [];
let elem_adt = mir_find_adt m "module_lattice::algebra::Elem" [mir_adt bf_adt];
let elem x = mir_struct_value elem_adt [mir_term x];

let unop_spec spec = do {
    a <- mir_fresh_var "a" mir_u32;
    mir_precond {{ a < 8380417 }};
    mir_execute_func [elem a];
    mir_return (elem (spec a));
};

let binop_spec spec = do {
    a <- mir_fresh_var "a" mir_u32;
    b <- mir_fresh_var "b" mir_u32;
    mir_precond {{ a < 8380417 }};
    mir_precond {{ b < 8380417 }};
    mir_execute_func [elem a, elem b];
    mir_return (elem (spec a b));
};

neg_ov <- mir_verify m "module_lattice::algebra::{impl#3}::neg::_instd1dae7dc341bae50" [] false
    (unop_spec (\a -> {{ drop`{32} ((8380417 - zext a) % 8380417) : [32] }})) z3;
print "VERIFIED: Elem neg == (q - a) mod q";

add_ov <- mir_verify m "module_lattice::algebra::{impl#4}::add::_instd1dae7dc341bae50" [] false
    (binop_spec (\a b -> {{ drop`{32} ((zext a + zext b) % 8380417) : [32] }})) z3;
print "VERIFIED: Elem add == (a + b) mod q";

sub_ov <- mir_verify m "module_lattice::algebra::{impl#5}::sub::_instd1dae7dc341bae50" [] false
    (binop_spec (\a b -> {{ drop`{32} ((zext a + 8380417 - zext b) % 8380417) : [32] }})) z3;
print "VERIFIED: Elem sub == (a - b) mod q";

// ---- The escape-2 admit-bridge (ASSUMED barrett override) ----------------
// barrett_reduce(x) == x mod q for x < 2^46 is ADMITTED here via
// mir_unsafe_assume_spec. This is the deliberate Path-1 trust expansion from
// the HANDOFF path fork. It is NOT a blind assumption -- its content is
// decomposed and the math is mechanized in two companion files run THIS session:
//
//   EARNED (z3, this session):
//     * escape2_core.saw          : barrettInt X == X % q  for all X in [0,2^46)
//                                   (the Barrett identity as an UNBOUNDED Integer
//                                    goal -- the form that dodges bit-blasting).
//     * barrett_bridge_evidence.saw : barrettBV x == x % q  for x < 2^24
//                                   (the EXACT bit-vector mirror of the impl
//                                    arithmetic is correct at tractable width).
//   ADMITTED (the irreducible gap, recorded in docs/ASSUMPTIONS.md):
//     * the BV<->bounded-Integer lift at width ~66+ (product < 2^69). SAW has no
//       native tactic for it; bridge lemmas themselves cliff at W=64 (HANDOFF),
//       and the direct mir_verify residual (impl == barrettBV) bit-blasts the
//       wide multiply + >>46 -- empirically z3 ran 3h15m without converging.
//
// So: the math is proved (integer core) and the model is validated (BV evidence);
// only the width-lifting that connects them is assumed. saw-script #3306,
// confirmed by maintainer RyanGlScott, documents that SMT tools fundamentally
// struggle with exactly this.
let barrett_spec = do {
    x <- mir_fresh_var "x" mir_u64;
    mir_precond {{ x < (1 << 46) }};
    mir_execute_func [mir_term x];
    mir_return (mir_term {{ drop`{32} (x % 8380417) : [32] }});
};
br_ov <- mir_unsafe_assume_spec m "ml_dsa::algebra::{impl#6}::barrett_reduce" barrett_spec;
print "ASSUMED (escape-2 trust base): barrett_reduce(x) == x mod q for all x < 2^46";

mul_ov <- mir_verify m "module_lattice::algebra::{impl#6}::mul::_instd1dae7dc341bae50" [br_ov] false
    (binop_spec (\a b -> {{ drop`{32} ((zext a * zext b) % 8380417) : [32] }})) z3;
print "VERIFIED: Elem mul == (a * b) mod q";

print "FIELD CORE CONFORMS (bridged): module_lattice Elem<BaseField> neg/add/sub/mul == arithmetic mod q (shared with ml-kem)";
