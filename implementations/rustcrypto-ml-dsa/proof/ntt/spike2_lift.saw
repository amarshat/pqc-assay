// SPIKE 2 (escape-2 lift plan, paper/notes/escape2-lift-plan.md): the rewrite-drive.
//
// RESULT (saw exit 0 this session): the wide-domain Barrett bridge
//     barrettBV x == drop`{96} ((zext x : [128]) % q)      for all x < 2^46
// is PROVED with the ONLY admitted content being nine standard bvToInt
// homomorphisms. This replaces the whole-function `mir_unsafe_assume_spec` of
// field_ops_bridged.saw (barrett_reduce == x mod q admitted outright) with a far
// smaller, auditable trust base: the escape-2 gap is now "closes modulo the
// bvToInt ring homomorphisms," exactly the set Route X (SAWCore lifting tactic)
// or Route Y (Isabelle Word_Lib) would discharge to remove the admit entirely.
//
// HOW IT WORKS (the fix for the obstacles logged in HANDOFF.md):
//   The residual is a bit-vector equality over the ~70-bit product (x*M)>>46 that
//   every eager backend bit-blasts to death. We lift it to the pure-Integer
//   identity that escape2_core already discharges, by pushing `toInteger` inward
//   through +, -, *, >>k, zext, truncate, urem, the conditional subtract, and the
//   two comparisons. Each push is a bvToInt homomorphism.
//   - The multiply/subtract/truncate/urem homomorphisms are stated in their
//     UNCONDITIONAL "mod 2^n" form (bv-op == integer-op reduced mod 2^n), which is
//     true for ALL operands. This dodges the earlier wall (HANDOFF): the guarded
//     no-wrap/no-borrow forms are "not an equation" and `addsimp` rejects them.
//     The no-wrap / no-borrow side conditions become pure-INTEGER `mod` no-ops,
//     discharged from x < 2^46 by the solver on the lifted goal (no bit-blast).
//   - Each homomorphism is ADMITTED at the width Barrett needs ([128]/[64]) because
//     hand-proving it there cliffs at W>=64 (HANDOFF); its TRUTH is witnessed below
//     (z3 at a tractable width, or quickcheck at full width for the nonlinear ones).
//   - The lifted Integer core is EARNED by cvc5 (z3 stalls on the nested `mod 2^128`;
//     cvc5's nonlinear handles it). It is then specialized onto the goal and the
//     bridge closes by modus ponens (z3), never re-deriving the nonlinear core, so
//     the symbolic bvToInt is never bit-blasted.
//
// TRUST DECOMPOSITION (auditable):
//   ADMITTED (nine bvToInt homomorphisms, full width; witnessed true below):
//     l1  zext:        toInteger (zext x)      == toInteger x
//     l2  mul:         toInteger (a*b)         == (toInteger a * toInteger b) % 2^128
//     l3  lshr:        toInteger (a >> 46)     == toInteger a / 2^46
//     l4  sub:         toInteger (a-b)         == (toInteger a - toInteger b) % 2^128
//     l5  truncate:    toInteger (drop`{96} a) == toInteger a % 2^32
//     lsr smallReduce: toInteger (smallReduce y) == (conditional subtract, in Integer)
//     lmod urem-by-q:  toInteger (a % q)       == toInteger a % q
//     inj bveq refl:   (a == b)                == (toInteger a == toInteger b)
//     llt bvult refl:  (a < b)                 == (toInteger a < toInteger b)
//   EARNED (this session):
//     core (cvc5): the lifted Integer identity == x % q for x < 2^46
//     the final bridge close (z3, by specialize + modus ponens)
//   DEFINITIONAL (sound): cryptol_ss unfolds, unfold_term ["barrettBV"].
//
// NOTE: this is the SPIKE, not the de-admit. The nine homomorphisms are still
//   assumed; removing them is Route X / Route Y (spike 3). What this buys is a
//   90%-smaller, standard, reusable admit and proof the endgame composes.
//
// Run:  saw spike2_lift.saw     (no MIR needed; Cryptol/Integer goals only)

enable_experimental;
import "barrett_bridge.cry";
let ss0 = cryptol_ss ();
let assume_rule t = prove_print (admit "bvToInt homomorphism (admitted at width; witnessed true below)") (rewrite ss0 t);

// ---- The nine homomorphisms, admitted at the width Barrett needs ---------------
// (2^128 = 340282366920938463463374607431768211456, 2^46 = 70368744177664,
//  2^32 = 4294967296, written as decimal literals so the solver sees concrete moduli.)
l1  <- assume_rule {{ \(x:[64])            -> toInteger ((zext x):[128]) == toInteger x }};
l2  <- assume_rule {{ \(a:[128]) (b:[128]) -> toInteger (a * b) == (toInteger a * toInteger b) % 340282366920938463463374607431768211456 }};
l3  <- assume_rule {{ \(a:[128])           -> toInteger (a >> 46) == (toInteger a) / 70368744177664 }};
l4  <- assume_rule {{ \(a:[128]) (b:[128]) -> toInteger (a - b) == (toInteger a - toInteger b) % 340282366920938463463374607431768211456 }};
l5  <- assume_rule {{ \(a:[128])           -> toInteger ((drop`{96} a):[32]) == (toInteger a) % 4294967296 }};
lsr <- assume_rule {{ \(y:[32])            -> toInteger (smallReduce y) ==
                        (if (toInteger y) >= 8380417 then (toInteger y) - 8380417 else toInteger y) }};
// lmod is specialized to the concrete nonzero divisor q: the GENERAL urem
// homomorphism is false at divisor 0 (BV a%0 vs Integer a%0 disagree), so
// admitting it generally would put a false lemma in the trust base. Fixing the
// divisor to q = 8380417 makes it unconditionally true, and it still matches the
// only urem in the goal, (zext x) % q.
lmod<- assume_rule {{ \(a:[128])           -> toInteger (a % q) == (toInteger a) % (toInteger q) }};
inj <- assume_rule {{ \(a:[32]) (b:[32])   -> (a == b) == (toInteger a == toInteger b) }};
llt <- assume_rule {{ \(a:[64]) (b:[64])   -> (a < b) == (toInteger a < toInteger b) }};
print "ADMITTED: 9 bvToInt homomorphisms at full width ([128]/[64]/[32]).";

// ---- Evidence the admitted homomorphisms are TRUE identities --------------------
// The linear/relational ones prove by z3 at a tractable width; the nonlinear ones
// (multiply, urem, the smallReduce bundle) cliff for eager SMT at any real width
// (that is WHY we admit them), so they are witnessed by z3 at a tiny width AND by
// randomized checking at the actual width.
prove_print z3 {{ \(x:[8])            -> toInteger ((zext x):[16]) == toInteger x }};
prove_print z3 {{ \(a:[16])           -> toInteger (a >> 6) == (toInteger a) / 64 }};
prove_print z3 {{ \(a:[16])           -> toInteger ((drop`{8} a):[8]) == (toInteger a) % 256 }};
prove_print z3 {{ \(a:[8]) (b:[8])    -> toInteger (a - b) == (toInteger a - toInteger b) % 256 }};
prove_print z3 {{ \(a:[8]) (b:[8])    -> (a == b) == (toInteger a == toInteger b) }};
prove_print z3 {{ \(a:[8]) (b:[8])    -> (a < b) == (toInteger a < toInteger b) }};
prove_print z3 {{ \(a:[6]) (b:[6])    -> toInteger (a * b) == (toInteger a * toInteger b) % 64 }};
prove_print z3 {{ \(a:[8])            -> toInteger (a % (7:[8])) == (toInteger a) % 7 }};
print "WITNESSED (z3, small width): zext, lshr, truncate, sub, bveq, bvult, mul, urem shapes are true.";
prove_print (quickcheck 500) {{ \(a:[128]) (b:[128]) -> toInteger (a * b) == (toInteger a * toInteger b) % 340282366920938463463374607431768211456 }};
prove_print (quickcheck 500) {{ \(a:[128]) -> toInteger (a % (8380417:[128])) == (toInteger a) % 8380417 }};
prove_print (quickcheck 500) {{ \(y:[32]) -> toInteger (smallReduce y) ==
                        (if (toInteger y) >= 8380417 then (toInteger y) - 8380417 else toInteger y) }};
print "WITNESSED (quickcheck 500, full width): multiply, urem-by-q, smallReduce homomorphisms hold.";

// ---- The lifted Integer core (EARNED, cvc5) ------------------------------------
// This is the escape2_core identity in the exact shape the lift produces: the
// no-wrap `% 2^128` and truncate `% 2^32` appear explicitly and are no-ops in range.
// z3 stalls on the nested large-modulus nonlinear; cvc5 discharges it (~0.4s).
let core = {{ \(X:Integer) -> (0 <= X) ==> (X < 70368744177664) ==>
   ( (if ((((X - ((((X * 8396807) % 340282366920938463463374607431768211456) / 70368744177664) * 8380417) % 340282366920938463463374607431768211456)) % 340282366920938463463374607431768211456) % 4294967296) >= 8380417
        then (((X - ((((X * 8396807) % 340282366920938463463374607431768211456) / 70368744177664) * 8380417) % 340282366920938463463374607431768211456)) % 340282366920938463463374607431768211456) % 4294967296 - 8380417
        else (((X - ((((X * 8396807) % 340282366920938463463374607431768211456) / 70368744177664) * 8380417) % 340282366920938463463374607431768211456)) % 340282366920938463463374607431768211456) % 4294967296)
     == (X % 8380417) % 4294967296 ) }};
core_thm <- prove_print cvc5 core;
print "EARNED (cvc5): lifted Integer core (barrett-with-mods) == x mod q for x < 2^46.";

// ---- The bridge, proved modulo the nine homomorphisms --------------------------
let lift = addsimps [l1,l2,l3,l4,l5,lsr,lmod,inj,llt] ss0;
let goal = unfold_term ["barrettBV"] {{ \(x:[64]) -> (x < (1 << 46)) ==>
                (barrettBV x == (drop`{96} ((zext x : [128]) % q))) }};
bridge <- prove_print (do {
    simplify lift;                                        // push toInteger in via the 9 homs -> pure Integer goal
    xt <- goal_intro "x";                                 // expose the [64] symbol
    goal_insert_and_specialize core_thm [ {{ toInteger xt }} ];  // instantiate the core at X = toInteger x (no quantifier reaches the solver)
    z3;                                                   // close by modus ponens; core is given, so no bit-blast of the nonlinear
}) goal;
print "PROVED (modulo 9 admitted bvToInt homomorphisms): barrettBV x == x mod q for all x < 2^46.";

// ---- Non-vacuity: the machinery cannot prove a FALSE modular identity ----------
// If the admitted homomorphisms were inconsistent, any target would go through.
// Mutating the modulus q -> q+1 makes the lifted core Invalid (cvc5 finds an
// in-domain counterexample), so the pipeline cannot close the wrong bridge.
let core_mutant = {{ \(X:Integer) -> (0 <= X) ==> (X < 70368744177664) ==>
   ( (if ((((X - ((((X * 8396807) % 340282366920938463463374607431768211456) / 70368744177664) * 8380417) % 340282366920938463463374607431768211456)) % 340282366920938463463374607431768211456) % 4294967296) >= 8380417
        then (((X - ((((X * 8396807) % 340282366920938463463374607431768211456) / 70368744177664) * 8380417) % 340282366920938463463374607431768211456)) % 340282366920938463463374607431768211456) % 4294967296 - 8380417
        else (((X - ((((X * 8396807) % 340282366920938463463374607431768211456) / 70368744177664) * 8380417) % 340282366920938463463374607431768211456)) % 340282366920938463463374607431768211456) % 4294967296)
     == (X % 8380418) % 4294967296 ) }};
fails (prove_print cvc5 core_mutant);
print "NON-VACUITY: modulus q+1 core is Invalid (cvc5). The lift is not vacuous. Good.";

print "SPIKE2 DONE: wide Barrett bridge closes modulo 9 standard bvToInt homomorphisms (was: whole-function admit).";
