(* WIP — Tier-2 FFT-correctness (negacyclic NTT == ML-DSA layer composition).
   SEPARATE from `Assay` (the make-verify no-sorry gate) until discharged.

   Split for fast iteration: Tier2_Base holds the stable deps (incl. the proven
   per-layer butterfly laws in Bridge_Word) as a prebuilt heap image
   (build once: `isabelle build -b -d . Tier2_Base`); active proof work lives in
   the thin child session Tier2 (work/CT_Routing only), so editing it reprocesses
   one theory on the mmap'd base — seconds, not minutes. *)
session Tier2_Base = "Number_Theoretic_Transform" +
  options [document = false]
  sessions
    Cryptol
  theories
    Bitrev
    Negacyclic_NTT
    "fips204_ntt_lift"
    Bridge_Word

session Tier2 in "work" = Tier2_Base +
  options [document = false]
  sessions
    Assay
  theories
    CT_Routing
    Negacyclic_Bridge
    Mont_Bridge

(* Inverse leg (fork 1, piece 4). Thin child on Tier2_Base so the bounded
   sub-step 1 (negacyclic invertibility) iterates without rebuilding the forward
   Mont_Bridge. *)
session Tier2_Inv in "inv" = Tier2_Base +
  options [document = false]
  theories
    Negacyclic_Inv

(* Inverse montgomery bridge (sub-step 2): the SAW-checked montgomery invntt model
   == the normal-domain nttInvAllRef mod q, plus the invf=mont^2/256 final scale.
   Thin child on the forward Tier2 (work) session so it reuses butterfly_cong /
   mont_mod_q / zeta_rel / sint_seq_add_eq and iterates without reproving the
   forward chain. One-time parent build materializes the Tier2 + Assay heaps. *)
session Tier2_InvWork in "invwork" = Tier2 +
  options [document = false]
  theories
    Inv_Mont_Bridge
