theory HQC_Seq
  imports HQC_Poly GF2X Fold
begin

text \<open>The lifted Cryptol models (\<open>GF2X\<close>, \<open>Fold\<close>, generated by cryptol-to-isabelle from
  model/cryptol/hqc) read as polynomials over GF(2): \<open>L\<close> lists the 64-bit words of a vector,
  \<open>Pl (L x)\<close> is its polynomial. Main results: \<open>km1_correct\<close> (the one-word product),
  \<open>kstep_correct\<close> (one Karatsuba level over correct products is correct), and
  \<open>fold_correct\<close> (fold is reduction mod x^n - 1 on products of degree below 2n).\<close>

context includes cryptol_syntax begin

definition L :: "('n, (64, bool) seq) seq \<Rightarrow> 64 word list" where
  "L x = map seq_to_word (seq_to_list x)"

lemma L_len[simp]: "length (L (x :: ('n, (64, bool) seq) seq)) = LEN('n)"
  by (simp add: L_def)

lemma L_coerce: "LEN('n) = LEN('m) \<Longrightarrow> L (coerce_seq_len (x :: ('n, (64, bool) seq) seq) :: ('m, (64, bool) seq) seq) = L x"
  by (simp add: L_def coerce_seq_len.rep_eq)

lemma L_take: "L (take'`{'front,'back,[64]} xs) = take LEN('front) (L xs)"
  by (simp add: L_def seq_to_list.take' take_map)

lemma L_drop: "L (drop'`{'front,'back,[64]} xs) = drop LEN('front) (L xs)"
  by (simp add: L_def seq_to_list.drop' drop_map)

lemma L_append: "LEN('c) = LEN('a) + LEN('b) \<Longrightarrow>
  L (append_seq (x :: ('a, (64, bool) seq) seq) (y :: ('b, (64, bool) seq) seq) :: ('c, (64, bool) seq) seq) = L x @ L y"
  by (simp add: L_def seq_to_list.append_seq)

lemma L_zero: "L (0 :: ('n, (64, bool) seq) seq) = replicate LEN('n) 0"
  by (simp add: L_def seq_to_list.zero_seq seq_to_word.zero)

lemma s2w_xor: "seq_to_word (map_seq (\<lambda>p. fst p = (\<not> snd p)) (zip_seq u v)) = seq_to_word u XOR seq_to_word v"
  using seq_to_word.xor[of u v] by (simp add: split_def)

lemma L_xor: "L (logic_class.xor (x :: ('n, (64, bool) seq) seq) y) = map2 (XOR) (L x) (L y)"
  by (simp add: L_def seq_to_list.map_seq seq_to_list.zip_seq s2w_xor split_def map2_map_map zip_map_map)

lemma kstep_correct:
  assumes len: "LEN('n0) \<le> LEN('n1)" "1 \<le> LEN('n0)" "LEN('n1) \<le> 1 + LEN('n0)"
    and m0: "\<And>x y. Pl (L (m0 x y)) = Pl (L x) * Pl (L y)"
    and m1: "\<And>x y. Pl (L (m1 x y)) = Pl (L x) * Pl (L y)"
  shows "Pl (L (kstep`{'n0,'n1} m0 m1 a b)) = Pl (L a) * Pl (L b)"
proof -
  define a0 a1 b0 b1 where "a0 = take'`{'n0,'n1,[64]} a" "a1 = drop'`{'n0,'n1,[64]} a"
    "b0 = take'`{'n0,'n1,[64]} b" "b1 = drop'`{'n0,'n1,[64]} b"
  define ta tb where
    "ta = logic_class.xor (append_seq a0 (0 :: ['n1 - 'n0][64]) :: ['n1][64]) a1"
    "tb = logic_class.xor (append_seq b0 (0 :: ['n1 - 'n0][64]) :: ['n1][64]) b1"
  have unf: "L (kstep`{'n0,'n1} m0 m1 a b) =
      map2 (XOR) (L (m0 a0 b0) @ L (m1 a1 b1))
        (replicate LEN('n0) 0 @
         map2 (XOR) (map2 (XOR) (L (m1 ta tb)) (L (m0 a0 b0) @ replicate (2 * (LEN('n1) - LEN('n0))) 0))
           (L (m1 a1 b1)) @ replicate LEN('n0) 0)"
    using len unfolding a0_a1_b0_b1_def ta_tb_def
    by (simp only: kstep_def Let_def) (simp del: xor_logic_seq add: L_xor L_append L_take L_drop L_coerce L_zero)
  have la: "L a = L a0 @ L a1" "L b = L b0 @ L b1"
    using len by (simp_all add: a0_a1_b0_b1_def L_take L_drop)
  have Pt: "Pl (L ta) = Pl (L a0) + Pl (L a1)" "Pl (L tb) = Pl (L b0) + Pl (L b1)"
    using len by (simp_all del: xor_logic_seq add: ta_tb_def L_xor L_append L_zero Pl_xor Pl_append)
  have "Pl (L (kstep`{'n0,'n1} m0 m1 a b)) =
        (Pl (L a0) + monom 1 (64 * LEN('n0)) * Pl (L a1)) * (Pl (L b0) + monom 1 (64 * LEN('n0)) * Pl (L b1))"
    unfolding unf
    by (rule kara_alg) (use len in \<open>simp_all add: m0 m1 Pt\<close>)
  also have "\<dots> = Pl (L a) * Pl (L b)"
    by (simp add: la Pl_append)
  finally show ?thesis .
qed
end

type_synonym w64 = "(64, bool) seq"
type_synonym w128 = "(128, bool) seq"
type_synonym w7 = "(7, bool) seq"

lemma s2w_xor2: "seq_to_word (map_seq (\<lambda>(a', b'). a' = (\<not> b')) (zip_seq u v)) = seq_to_word u XOR seq_to_word v"
  unfolding split_def by (rule s2w_xor)

lemma s2w_zext: "seq_to_word (append_seq (z :: w64) (B :: w64) :: w128) = word_cat (seq_to_word z) (seq_to_word B)"
  by (rule seq_to_word.append_seq) simp

lemma idx7: "k < 64 \<Longrightarrow> to_nat (from_nat k :: w7) = k"
  by simp

lemma idx7_int: "k < 64 \<Longrightarrow> uint_seq (from_nat k :: w7) = int k"
  by (simp add: uint_seq_conv seq_to_word.from_nat unsigned_of_nat take_bit_nat_eq_self)

lemma zext_coerce:
  fixes z B :: w64
  assumes "seq_to_word z = 0"
  shows "seq_to_word (coerce_to TYPE(w128) (append_seq z B :: (64 + 64, bool) seq)) = ucast (seq_to_word B)"
  using assms by (simp add: s2w_zext word_cat_eq)

lemma clmul_step:
  fixes A B z :: w64 and acc :: w128
  assumes "k < 64" "seq_to_word z = 0"
  shows "seq_to_word (if nth_end_seq A (to_nat (from_nat k :: w7))
                      then logic_class.xor acc (left_shift (coerce_to TYPE(w128) (append_seq z B :: (64 + 64, bool) seq))
                                                 (to_int (from_nat k :: w7))) else acc)
         = clw_step (seq_to_word A) (seq_to_word B) (seq_to_word acc) k"
  using assms
  by (simp add: clw_step_def idx7 idx7_int nth_end_seq_conv s2w_xor2 seq_to_word.left_shift s2w_zext word_cat_eq)

lemma fold_bridge:
  fixes A B z :: w64 and acc0 :: w128
  assumes "\<forall>k\<in>set ks. k < 64" "seq_to_word z = 0"
  shows "seq_to_word (foldl (\<lambda>acc i. if nth_end_seq A (to_nat i)
            then logic_class.xor acc (left_shift (coerce_to TYPE(w128) (append_seq z B :: (64 + 64, bool) seq)) (to_int i))
            else acc)
            acc0 (map (from_nat :: nat \<Rightarrow> w7) ks))
         = foldl (clw_step (seq_to_word A) (seq_to_word B)) (seq_to_word acc0) ks"
  using assms(1)
proof (induction ks arbitrary: acc0)
  case Nil then show ?case by simp
next
  case (Cons k ks)
  then show ?case using clmul_step[OF _ assms(2)] by simp
qed

lemma pw_ucast_same: "LENGTH('a) = LENGTH('b) \<Longrightarrow> pw (ucast (w :: 'a::len word) :: 'b::len word) = pw w"
  by (auto simp: poly_eq_iff coeff_pw bit_ucast_iff dest: bit_imp_le_length)

lemma pw_split:
  assumes "LENGTH('a) = 128"
  shows "pw (R :: 'a::len word) = pw (ucast (take_bit 64 R) :: 64 word) + monom 1 64 * pw (ucast (drop_bit 64 R) :: 64 word)"
  using assms by (auto simp: poly_eq_iff coeff_pw coeff_monom_mult bit_ucast_iff bit_take_bit_iff bit_drop_bit_eq
           not_le dest: bit_imp_le_length)

lemma L_one: "L (x :: (1, w64) seq) = [seq_to_word (nth_seq x 0)]"
proof -
  have "length (seq_to_list x) = Suc 0" by simp
  then obtain w where "seq_to_list x = [w]" by (cases "seq_to_list x") auto
  then show ?thesis by (simp add: L_def nth_seq.rep_eq)
qed

lemma km1_correct: "Pl (L (km1 a b)) = Pl (L a) * Pl (L b)"
proof -
  define A B where "A = nth_seq a 0" "B = nth_seq b 0"
  define R where "R = foldl (clw_step (seq_to_word A) (seq_to_word B)) 0 [0..<64]"
  have "L (km1 a b) = [ucast (take_bit 64 (ucast R :: (64 + 64) word)), ucast (drop_bit 64 (ucast R :: (64 + 64) word))]"
    by (simp add: km1_def clmul1_def Let_def L_def list_to_seq.rep_eq seq_to_word.drop' seq_to_word.take'
                  foldl_seq.rep_eq seq_to_list.fromTo seq_to_word.coerce_seq_len fold_bridge seq_to_word.zero
                  A_B_def R_def)
  then have "Pl (L (km1 a b)) = pw (ucast R :: (64 + 64) word)"
    by (simp add: pw_split)
  also have "\<dots> = pw (seq_to_word A) * pw (seq_to_word B)"
    by (simp add: pw_ucast_same R_def clw_correct)
  also have "\<dots> = Pl (L a) * Pl (L b)"
    by (simp add: L_one A_B_def)
  finally show ?thesis .
qed

definition bitsof :: "64 word list \<Rightarrow> nat \<Rightarrow> bool" where
  "bitsof ws j \<longleftrightarrow> j div 64 < length ws \<and> bit (ws ! (j div 64)) (j mod 64)"

lemma coeff_Pl: "coeff (Pl ws) j = of_bool (bitsof ws j)"
proof (induction ws arbitrary: j)
  case Nil then show ?case by (simp add: bitsof_def)
next
  case (Cons w ws)
  show ?case
  proof (cases "j < 64")
    case True
    then show ?thesis by (simp add: coeff_pw coeff_monom_mult bitsof_def)
  next
    case False
    then have "j div 64 = Suc ((j - 64) div 64)" "j mod 64 = (j - 64) mod 64"
      by (simp_all add: div_if mod_if)
    then show ?thesis
      using False Cons[of "j - 64"] bit_imp_le_length[of w j]
      by (auto simp: coeff_pw coeff_monom_mult bitsof_def)
  qed
qed

lemma Pl_eq_pw: "(\<And>j. bitsof ws j = bit (x :: 'a::len word) j) \<Longrightarrow> Pl ws = pw x"
  by (simp add: poly_eq_iff coeff_Pl coeff_pw)

lemma bit_s2w: "bit (seq_to_word (v :: ('n::len, bool) seq)) j \<longleftrightarrow> j < LEN('n) \<and> seq_to_list v ! (LEN('n) - Suc j)"
proof (cases "j < LEN('n)")
  case True
  have "nth_seq v (LEN('n) - Suc j) = bit (seq_to_word v) (LEN('n) - Suc (LEN('n) - Suc j))"
    using True by (simp add: nth_seq_conv)
  then show ?thesis using True by (simp add: nth_seq.rep_eq Suc_diff_Suc)
next
  case False
  then show ?thesis by (auto dest: bit_imp_le_length)
qed

lemma concat_rev_nth:
  assumes "\<forall>x\<in>set xs. length x = k" "j < k * length xs"
  shows "concat (rev xs) ! (k * length xs - Suc j) = (xs ! (j div k)) ! (k - Suc (j mod k))"
  using assms
proof (induction xs arbitrary: j)
  case Nil then show ?case by simp
next
  case (Cons x xs)
  have lc: "length (concat (rev xs)) = k * length xs"
  proof -
    have "map length (rev xs) = replicate (length xs) k"
      using Cons.prems(1) by (simp add: map_replicate_const[symmetric] rev_map[symmetric] cong: map_cong)
                             (metis length_map map_replicate_const rev_replicate)
    then show ?thesis by (simp add: length_concat sum_list_replicate mult.commute)
  qed
  have k0: "0 < k" using Cons.prems(2) by (cases k) auto
  show ?case
  proof (cases "j < k")
    case True
    have "concat (rev (x # xs)) ! (k * length (x # xs) - Suc j)
          = (concat (rev xs) @ x) ! (length (concat (rev xs)) + (k - Suc j))"
      using True lc by (simp add: algebra_simps)
    also have "\<dots> = x ! (k - Suc j)" by (rule nth_append_length_plus)
    finally show ?thesis using True by simp
  next
    case False
    define j' where "j' = j - k"
    have j': "j' < k * length xs" "j = j' + k" using False Cons.prems(2) by (auto simp: j'_def)
    have idx: "k * length (x # xs) - Suc j = k * length xs - Suc j'" using j' by simp
    have "j div k = Suc (j' div k)" "j mod k = j' mod k" using j' k0 by simp_all
    moreover have "k * length xs - Suc j' < k * length xs" using j' by simp
    ultimately show ?thesis
      using Cons.IH[of j'] Cons.prems(1) j' lc idx by (simp add: nth_append)
  qed
qed

lemma toBits_bit:
  fixes p :: "('w::len, w64) seq"
  shows "bit (seq_to_word (toBits TY('w) p)) j \<longleftrightarrow> bitsof (L p) j"
proof -
  define xs where "xs = map seq_to_list (seq_to_list p)"
  have lx: "\<forall>x\<in>set xs. length x = 64" "length xs = LEN('w)" by (auto simp: xs_def)
  have lc: "length (concat (rev xs)) = 64 * LEN('w)"
  proof -
    have "map length (rev xs) = replicate LEN('w) 64"
      using lx by (metis length_rev map_replicate_const rev_map rev_replicate map_cong[OF refl, of xs length "\<lambda>_. 64"])
    then show ?thesis by (simp add: length_concat sum_list_replicate mult.commute)
  qed
  have bits: "seq_to_list (toBits TY('w) p) = concat (rev xs)"
    using lc by (simp add: toBits_def coerce_seq_len.rep_eq seq_to_list.join' seq_to_list.rev_seq xs_def rev_map)
  show ?thesis
  proof (cases "j < 64 * LEN('w)")
    case True
    have "seq_to_list (toBits TY('w) p) ! (64 * LEN('w) - Suc j) = (xs ! (j div 64)) ! (64 - Suc (j mod 64))"
      using concat_rev_nth[OF lx(1), of j] True lx(2) by (simp add: bits)
    moreover have "j div 64 < LEN('w)" using True by (simp add: less_mult_imp_div_less mult.commute)
    ultimately show ?thesis
      using True by (simp add: bit_s2w bitsof_def L_def xs_def)
  next
    case False
    then show ?thesis by (simp add: bit_s2w bitsof_def L_def less_mult_imp_div_less mult.commute div_less_iff_less_mult)
  qed
qed

lemma fromBits_bit:
  fixes u :: "(64 * 'w::len, bool) seq"
  shows "bitsof (L (fromBits TY('w) u)) j \<longleftrightarrow> bit (seq_to_word u) j"
proof -
  define bs where "bs = seq_to_list u"
  have lb: "length bs = LEN('w) * 64" by (simp add: bs_def mult.commute)
  have Lf: "L (fromBits TY('w) u) = map seq_to_word (rev (map list_to_seq (group_list LEN('w) 64 bs)) :: w64 list)"
    by (simp add: fromBits_def L_def coerce_seq_len.rep_eq seq_to_list.groupBy seq_to_list.rev_seq bs_def)
  show ?thesis
  proof (cases "j < 64 * LEN('w)")
    case True
    define i r where "i = j div 64" "r = j mod 64"
    have ir: "i < LEN('w)" "r < 64" "j = 64 * i + r" using True by (auto simp: i_r_def div_less_iff_less_mult mult.commute)
    have g: "group_list LEN('w) 64 bs ! (LEN('w) - Suc i) = take 64 (drop ((LEN('w) - Suc i) * 64) bs)"
      using lb ir by (simp add: group_list_part)
    have lg: "length (group_list LEN('w) 64 bs ! (LEN('w) - Suc i)) = 64" using lb ir by simp
    have idx: "(LEN('w) - Suc i) * 64 + (64 - Suc r) = 64 * LEN('w) - Suc j" using ir by (simp add: algebra_simps)
    have "bitsof (L (fromBits TY('w) u)) j \<longleftrightarrow> (group_list LEN('w) 64 bs ! (LEN('w) - Suc i)) ! (64 - Suc r)"
      using ir lg by (simp add: bitsof_def Lf rev_nth i_r_def[symmetric] bit_s2w list_to_seq.rep_eq)
    also have "\<dots> \<longleftrightarrow> bs ! (64 * LEN('w) - Suc j)"
      using g ir lb idx by (simp add: algebra_simps)
    finally show ?thesis using True by (simp add: bit_s2w bs_def)
  next
    case False
    then show ?thesis by (simp add: bit_s2w bitsof_def Lf div_less_iff_less_mult mult.commute)
  qed
qed

lemma number_int: "(number TY('n::len) TY(int) :: int) = int LEN('n)"
  by (simp add: number_def)

lemma bit_s2w_map_zip:
  "bit (seq_to_word (map_seq f (zip_seq (u :: ('n::len, bool) seq) v))) j \<longleftrightarrow>
     j < LEN('n) \<and> f (bit (seq_to_word u) j, bit (seq_to_word v) j)"
  by (auto simp: bit_s2w seq_to_list.map_seq seq_to_list.zip_seq)

lemma bit_s2w_rshift:
  "bit (seq_to_word (right_shift (x :: ('n::len, bool) seq) (int k))) j \<longleftrightarrow> bit (seq_to_word x) (j + k)"
  by (simp add: seq_to_word.right_shift shiftr_def bit_drop_bit_eq add.commute)

lemma bit_s2w_drop:
  "bit (seq_to_word (drop' TY('f) TY('b::len) TY(bool) (x :: ('f + 'b, bool) seq))) j \<longleftrightarrow>
     j < LEN('b) \<and> bit (seq_to_word x) j"
  by (simp add: seq_to_word.drop' bit_ucast_iff bit_take_bit_iff)

lemma bit_s2w_mask:
  "bit (seq_to_word (left_shift (map_seq Not (0 :: ('n::len, bool) seq)) (int k))) j \<longleftrightarrow> k \<le> j \<and> j < LEN('n)"
  by (auto simp: seq_to_word.left_shift bit_shiftl_iff seq_to_word.not seq_to_word.zero bit_not_iff)

lemma bit_s2w_coerce:
  "LEN('m) = LEN('n) \<Longrightarrow>
   bit (seq_to_word (coerce_seq_len (x :: ('n::len, bool) seq) :: ('m::len, bool) seq)) j \<longleftrightarrow> bit (seq_to_word x) j"
  by (simp add: seq_to_word.coerce_seq_len bit_ucast_iff) (auto dest: bit_imp_le_length)

lemma fold_bit:
  assumes n: "LEN('n::len) \<le> 64 * LEN('w::len)" "1 \<le> LEN('n)"
  shows "bitsof (L (fold TY('n) TY('w) (p :: (2 \<times> 'w, w64) seq))) j \<longleftrightarrow>
         j < LEN('n) \<and> (bitsof (L p) j \<noteq> bitsof (L p) (j + LEN('n)))"
  using n
  apply (simp add: fold_def Let_def fromBits_bit bit_s2w_map_zip bit_s2w_drop number_int bit_s2w_rshift
                   bit_s2w_mask bit_s2w_coerce toBits_bit)
  apply (cases "j < LEN('n)"; auto)
  done

lemma gf2_of_bool_add: "(of_bool a :: gf2) + of_bool b = of_bool (a \<noteq> b)"
  by (cases a; cases b) simp_all

lemma mod_fold_poly:
  fixes P Q :: "gf2 poly"
  assumes n: "1 \<le> n"
    and Q: "\<And>j. coeff Q j = (if j < n then coeff P j + coeff P (j + n) else 0)"
    and deg: "\<And>j. 2 * n \<le> j \<Longrightarrow> coeff P j = 0"
  shows "Q = P mod (monom 1 n - 1)"
proof -
  define D where "D = (monom 1 n + 1 :: gf2 poly)"
  define H where "H = (\<Sum>j<n. monom (coeff P (j + n)) j)"
  have cH: "coeff H j = (if j < n then coeff P (j + n) else 0)" for j
    by (simp add: H_def coeff_sum coeff_monom sum.delta)
  have "P = Q + D * H"
  proof (rule poly_eqI)
    fix j
    have cDH: "coeff (D * H) j = (if n \<le> j then coeff H (j - n) else 0) + coeff H j"
      by (simp add: D_def distrib_right coeff_monom_mult)
    show "coeff P j = coeff (Q + D * H) j"
    proof (cases "j < n")
      case True
      then have "\<not> n \<le> j" by simp
      then show ?thesis
        using True by (simp only: Q cDH cH if_True if_False coeff_add add_0_left add.assoc gf2_add_self add_0_right)
    next
      case False
      then show ?thesis
        using deg[of j] by (cases "j < 2 * n") (auto simp: Q cDH cH)
    qed
  qed
  moreover have "degree D = n" using n by (simp add: D_def degree_add_eq_left degree_monom_eq)
  moreover have "degree Q < n"
  proof -
    have "degree Q \<le> n - 1" by (rule degree_le) (use n in \<open>auto simp: Q\<close>)
    then show ?thesis using n by simp
  qed
  ultimately have "P mod D = Q"
    by (metis mod_mult_self2 mult.commute mod_poly_less)
  moreover have "monom 1 n - 1 = D" by (simp add: D_def gf2_poly_minus)
  ultimately show ?thesis by simp
qed

theorem fold_correct:
  assumes n: "LEN('n::len) \<le> 64 * LEN('w::len)" "1 \<le> LEN('n)"
    and deg: "\<And>j. 2 * LEN('n) \<le> j \<Longrightarrow> coeff (Pl (L p)) j = 0"
  shows "Pl (L (fold TY('n) TY('w) (p :: (2 \<times> 'w, w64) seq))) = Pl (L p) mod (monom 1 LEN('n) - 1)"
proof (rule mod_fold_poly[OF n(2) _ deg])
  fix j
  show "coeff (Pl (L (fold TY('n) TY('w) p))) j =
        (if j < LEN('n) then coeff (Pl (L p)) j + coeff (Pl (L p)) (j + LEN('n)) else 0)"
    using n by (simp add: coeff_Pl fold_bit gf2_of_bool_add)
qed

lemma fold_mult:
  assumes prod: "Pl (L p) = Pl (L a) * Pl (L b)"
    and n: "LEN('n::len) \<le> 64 * LEN('w::len)" "1 \<le> LEN('n)"
    and da: "degree (Pl (L a)) < LEN('n)" and db: "degree (Pl (L b)) < LEN('n)"
  shows "Pl (L (fold TY('n) TY('w) (p :: (2 \<times> 'w, w64) seq))) = (Pl (L a) * Pl (L b)) mod (monom 1 LEN('n) - 1)"
proof -
  have "degree (Pl (L p)) < 2 * LEN('n) - 1"
    using da db n(2) degree_mult_le[of "Pl (L a)" "Pl (L b)"] by (simp add: prod)
  then have "\<And>j. 2 * LEN('n) \<le> j \<Longrightarrow> coeff (Pl (L p)) j = 0"
    by (simp add: coeff_eq_0)
  from fold_correct[OF n this] show ?thesis by (simp add: prod)
qed

lemma fold_mult_k:
  assumes prod: "Pl (L p) = Pl (L a) * Pl (L b)"
    and k: "LEN('n::len) = k" "k \<le> 64 * LEN('w::len)" "1 \<le> k"
    and da: "degree (Pl (L a)) < k" and db: "degree (Pl (L b)) < k"
  shows "Pl (L (fold TY('n) TY('w) (p :: (2 \<times> 'w, w64) seq))) = (Pl (L a) * Pl (L b)) mod (monom 1 k - 1)"
proof -
  have "Pl (L (fold TY('n) TY('w) p)) = (Pl (L a) * Pl (L b)) mod (monom 1 LEN('n) - 1)"
    by (rule fold_mult[OF prod]) (use k da db in simp_all)
  then show ?thesis using k by simp
qed

end
