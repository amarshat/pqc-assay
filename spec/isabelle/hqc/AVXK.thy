    x34 = ((m`{} (a3 ^`{['t][64]} a4) (b3 ^`{['t][64]} b4)) : ([2 * 't][64]));
    c0 = (d0 : ([2 * 't][64]));
    c1 = (((x01 ^`{[2 * 't][64]} d0) ^`{[2 * 't][64]} d1) : ([2 * 't][64]));
    c2 = ((((x02 ^`{[2 * 't][64]} d0) ^`{[2 * 't][64]} d2) ^`{[2 * 't][64]} d1) : ([2 * 't][64]));
    c3 = ((((((x03 ^`{[2 * 't][64]} d0) ^`{[2 * 't][64]} d3) ^`{[2 * 't][64]} x12) ^`{[2 * 't][64]} d1) ^`{[2 * 't][64]} d2) : ([2 * 't][64]));
    c4 = (((((((x04 ^`{[2 * 't][64]} d0) ^`{[2 * 't][64]} d4) ^`{[2 * 't][64]} x13) ^`{[2 * 't][64]} d1) ^`{[2 * 't][64]} d3) ^`{[2 * 't][64]} d2) : ([2 * 't][64]));
    c5 = ((((((x14 ^`{[2 * 't][64]} d1) ^`{[2 * 't][64]} d4) ^`{[2 * 't][64]} x23) ^`{[2 * 't][64]} d2) ^`{[2 * 't][64]} d3) : ([2 * 't][64]));
    c6 = ((((x24 ^`{[2 * 't][64]} d2) ^`{[2 * 't][64]} d4) ^`{[2 * 't][64]} d3) : ([2 * 't][64]));
    c7 = (((x34 ^`{[2 * 't][64]} d3) ^`{[2 * 't][64]} d4) : ([2 * 't][64]));
    c8 = (d4 : ([2 * 't][64]));
    sh0 = ((\<lambda>(x :: [2 * 't][64]). (x #`{2 * 't,8 * 't,[64]} (zero`{[8 * 't][64]}))) : (([2 * 't][64]) \<Rightarrow> ([(2 * 't) + (8 * 't)][64])));
    sh1 = ((\<lambda>(x :: [2 * 't][64]). ((zero`{['t][64]}) #`{'t,(2 * 't) + (7 * 't),[64]} (x #`{2 * 't,7 * 't,[64]} (zero`{[7 * 't][64]})))) : (([2 * 't][64]) \<Rightarrow> ([((2 * 't) + (7 * 't)) + 't][64])));
    sh2 = ((\<lambda>(x :: [2 * 't][64]). ((zero`{[2 * 't][64]}) #`{2 * 't,(2 * 't) + (6 * 't),[64]} (x #`{2 * 't,6 * 't,[64]} (zero`{[6 * 't][64]})))) : (([2 * 't][64]) \<Rightarrow> ([(2 * 't) + ((2 * 't) + (6 * 't))][64])));
    sh3 = ((\<lambda>(x :: [2 * 't][64]). ((zero`{[3 * 't][64]}) #`{3 * 't,(2 * 't) + (5 * 't),[64]} (x #`{2 * 't,5 * 't,[64]} (zero`{[5 * 't][64]})))) : (([2 * 't][64]) \<Rightarrow> ([(3 * 't) + ((2 * 't) + (5 * 't))][64])));
