context includes cryptol_translation_syntax begin
cryptol_definition k3step :: "{'t} ((fin 't,'t \<ge> 1) =?> (((['t][64]) \<Rightarrow> ((['t][64]) \<Rightarrow> ([2 * 't][64]))) \<Rightarrow> (([3 * 't][64]) \<Rightarrow> (([3 * 't][64]) \<Rightarrow> ([6 * 't][64])))))" where
"k3step m a b \<equiv> 
  let
    a0 = ((take`{'t,(3 * 't) - 't,[64]} a) : (['t][64]));
    a1 = ((take`{'t,'t,[64]} (drop`{'t,2 * 't,[64]} a)) : (['t][64]));
    a2 = ((drop`{2 * 't,'t,[64]} a) : (['t][64]));
    b0 = ((take`{'t,(3 * 't) - 't,[64]} b) : (['t][64]));
    b1 = ((take`{'t,'t,[64]} (drop`{'t,2 * 't,[64]} b)) : (['t][64]));
    b2 = ((drop`{2 * 't,'t,[64]} b) : (['t][64]));
    d0 = ((m`{} a0 b0) : ([2 * 't][64]));
    d1 = ((m`{} a1 b1) : ([2 * 't][64]));
    d2 = ((m`{} a2 b2) : ([2 * 't][64]));
    d3 = ((m`{} (a0 ^`{['t][64]} a1) (b0 ^`{['t][64]} b1)) : ([2 * 't][64]));
    d4 = ((m`{} (a0 ^`{['t][64]} a2) (b0 ^`{['t][64]} b2)) : ([2 * 't][64]));
    d5 = ((m`{} (a1 ^`{['t][64]} a2) (b1 ^`{['t][64]} b2)) : ([2 * 't][64]));
    sh0 = ((\<lambda>(x :: [2 * 't][64]). (x #`{2 * 't,4 * 't,[64]} (zero`{[4 * 't][64]}))) : (([2 * 't][64]) \<Rightarrow> ([(2 * 't) + (4 * 't)][64])));
    sh1 = ((\<lambda>(x :: [2 * 't][64]). ((zero`{['t][64]}) #`{'t,(2 * 't) + (3 * 't),[64]} (x #`{2 * 't,3 * 't,[64]} (zero`{[3 * 't][64]})))) : (([2 * 't][64]) \<Rightarrow> ([((2 * 't) + (3 * 't)) + 't][64])));
    sh2 = ((\<lambda>(x :: [2 * 't][64]). ((zero`{[2 * 't][64]}) #`{2 * 't,4 * 't,[64]} (x #`{2 * 't,2 * 't,[64]} (zero`{[2 * 't][64]})))) : (([2 * 't][64]) \<Rightarrow> ([(2 * 't) + (4 * 't)][64])));
    sh3 = ((\<lambda>(x :: [2 * 't][64]). ((zero`{[3 * 't][64]}) #`{3 * 't,(2 * 't) + 't,[64]} (x #`{2 * 't,'t,[64]} (zero`{['t][64]})))) : (([2 * 't][64]) \<Rightarrow> ([(3 * 't) + ((2 * 't) + 't)][64])));
    sh4 = ((\<lambda>(x :: [2 * 't][64]). ((zero`{[4 * 't][64]}) #`{4 * 't,2 * 't,[64]} x)) : (([2 * 't][64]) \<Rightarrow> ([(4 * 't) + (2 * 't)][64])))
  in (((((sh0`{} d0) ^`{[6 * 't][64]} (sh1`{} ((d3 ^`{[2 * 't][64]} d0) ^`{[2 * 't][64]} d1))) ^`{[6 * 't][64]} (sh2`{} (((d4 ^`{[2 * 't][64]} d0) ^`{[2 * 't][64]} d2) ^`{[2 * 't][64]} d1))) ^`{[6 * 't][64]} (sh3`{} ((d5 ^`{[2 * 't][64]} d1) ^`{[2 * 't][64]} d2))) ^`{[6 * 't][64]} (sh4`{} d2))"

cryptol_definition k5step :: "{'t} ((fin 't,'t \<ge> 1) =?> (((['t][64]) \<Rightarrow> ((['t][64]) \<Rightarrow> ([2 * 't][64]))) \<Rightarrow> (([5 * 't][64]) \<Rightarrow> (([5 * 't][64]) \<Rightarrow> ([10 * 't][64])))))" where
"k5step m a b \<equiv> 
  let
    a0 = ((take`{'t,(5 * 't) - 't,[64]} a) : (['t][64]));
    a1 = ((take`{'t,3 * 't,[64]} (drop`{'t,'t + (3 * 't),[64]} a)) : (['t][64]));
    a2 = ((take`{'t,2 * 't,[64]} (drop`{2 * 't,'t + (2 * 't),[64]} a)) : (['t][64]));
    a3 = ((take`{'t,'t,[64]} (drop`{3 * 't,2 * 't,[64]} a)) : (['t][64]));
