theory "AVX5"
imports "Cryptol.Cryptol" AVXK Fold GF2X KM5
begin

context includes cryptol_translation_syntax begin
cryptol_definition km16 :: "([16][64]) \<Rightarrow> (([16][64]) \<Rightarrow> ([32][64]))" where
"km16  \<equiv> GF2X.kstep`{8,8} KM5.km8 KM5.km8"

cryptol_definition km32 :: "([32][64]) \<Rightarrow> (([32][64]) \<Rightarrow> ([64][64]))" where
"km32  \<equiv> GF2X.kstep`{16,16} km16 km16"

cryptol_definition km64 :: "([64][64]) \<Rightarrow> (([64][64]) \<Rightarrow> ([128][64]))" where
"km64  \<equiv> GF2X.kstep`{32,32} km32 km32"

cryptol_definition km320 :: "([320][64]) \<Rightarrow> (([320][64]) \<Rightarrow> ([640][64]))" where
"km320  \<equiv> AVXK.k5step`{64} km64"

cryptol_definition pxorv :: "{'n} ((fin 'n,'n \<ge> 1) =?> (([4 * 'n][64]) \<Rightarrow> ([4 * 'n][64])))" where
"pxorv t \<equiv> join`{'n,4,[64]} (drop`{1,'n,[4][64]} (scanl`{'n,[4][64],[4][64]} (\<lblot>^`{[4][64]}\<rblot>) (zero`{[4][64]}) (split`{'n,4,[64]} t)))"

cryptol_definition tm5 :: "([936][64]) \<Rightarrow> (([936][64]) \<Rightarrow> ([1872][64]))" where
"tm5 a b \<equiv> 
  let
    m = (km320 : (([320][64]) \<Rightarrow> (([320][64]) \<Rightarrow> ([640][64]))));
    pad = ((\<lambda>(x :: [312][64]). (x #`{312,8,[64]} (zero`{[8][64]}))) : (([312][64]) \<Rightarrow> ([320][64])));
    u0 = ((pad`{} (take`{312,624,[64]} a)) : ([320][64]));
    u1 = ((pad`{} (take`{312,312,[64]} (drop`{312,624,[64]} a))) : ([320][64]));
    u2 = ((pad`{} (drop`{624,312,[64]} a)) : ([320][64]));
    v0 = ((pad`{} (take`{312,624,[64]} b)) : ([320][64]));
    v1 = ((pad`{} (take`{312,312,[64]} (drop`{312,624,[64]} b))) : ([320][64]));
    v2 = ((pad`{} (drop`{624,312,[64]} b)) : ([320][64]));
    su = (((u0 ^`{[320][64]} u1) ^`{[320][64]} u2) : ([320][64]));
    sv = (((v0 ^`{[320][64]} v1) ^`{[320][64]} v2) : ([320][64]));
    w1 = ((m`{} sv su) : ([640][64]));
    w0a = (((take`{320,4,[64]} ((zero`{[4][64]}) #`{4,320,[64]} u1)) ^`{[320][64]} (take`{320,8,[64]} ((zero`{[8][64]}) #`{8,320,[64]} u2))) : ([320][64]));
    w4a = (((take`{320,4,[64]} ((zero`{[4][64]}) #`{4,320,[64]} v1)) ^`{[320][64]} (take`{320,8,[64]} ((zero`{[8][64]}) #`{8,320,[64]} v2))) : ([320][64]));
    w3a = ((su ^`{[320][64]} w0a) : ([320][64]));
    w2a = ((sv ^`{[320][64]} w4a) : ([320][64]));
    w0b = ((w0a ^`{[320][64]} u0) : ([320][64]));
    w4b = ((w4a ^`{[320][64]} v0) : ([320][64]));
    p3 = ((m`{} w3a w2a) : ([640][64]));
    p2 = ((m`{} w0b w4b) : ([640][64]));
    p4 = ((m`{} u2 v2) : ([640][64]));
    p0 = ((m`{} u0 v0) : ([640][64]));
    q3 = ((p3 ^`{[640][64]} p2) : ([640][64]));
    q1 = ((w1 ^`{[640][64]} ((take`{624,16,[64]} p0) #`{624,16,[64]} (zero`{[16][64]}))) : ([640][64]));
    q2 = (((drop`{4,636,[64]} (p2 ^`{[640][64]} p0)) #`{636,4,[64]} (zero`{[4][64]})) : ([640][64]));
    t1 = (((((q2 ^`{[640][64]} q3) ^`{[640][64]} p4) #`{640,12,[64]} (zero`{[12][64]})) ^`{[652][64]} ((zero`{[12][64]}) #`{12,640,[64]} ((take`{624,16,[64]} p4) #`{624,16,[64]} (zero`{[16][64]})))) : ([652][64]));
    d2 = ((pxorv`{160} (take`{640,12,[64]} t1)) : ([640][64]));
    t2 = (((drop`{4,636,[64]} (q3 ^`{[640][64]} q1)) #`{636,4,[64]} (zero`{[4][64]})) : ([640][64]));
    d3 = ((pxorv`{160} t2) : ([640][64]));
    e1 = (((q1 ^`{[640][64]} d2) ^`{[640][64]} p4) : ([640][64]));
    e2 = ((d2 ^`{[640][64]} d3) : ([640][64]));
    r0 = (((take`{624,16,[64]} p0) #`{624,1248,[64]} (zero`{[1248][64]})) : ([1872][64]));
    r1 = (((zero`{[312][64]}) #`{312,1560,[64]} ((take`{624,16,[64]} e1) #`{624,936,[64]} (zero`{[936][64]}))) : ([1872][64]));
    r2 = (((zero`{[624][64]}) #`{624,1248,[64]} (e2 #`{640,608,[64]} (zero`{[608][64]}))) : ([1872][64]));
    r3 = (((zero`{[936][64]}) #`{936,936,[64]} (d3 #`{640,296,[64]} (zero`{[296][64]}))) : ([1872][64]));
    r4 = (((zero`{[1248][64]}) #`{1248,624,[64]} (take`{624,16,[64]} p4)) : ([1872][64]))
  in ((((r0 ^`{[1872][64]} r1) ^`{[1872][64]} r2) ^`{[1872][64]} r3) ^`{[1872][64]} r4)"

cryptol_definition vmulA :: "([936][64]) \<Rightarrow> (([936][64]) \<Rightarrow> ([901][64]))" where
"vmulA a b \<equiv> Fold.fold`{57637,901} (take`{1802,70,[64]} (tm5`{} a b))"

cryptol_definition vmulBytes :: "([936][64]) \<Rightarrow> (([936][64]) \<Rightarrow> ([7205][8]))" where
"vmulBytes a b \<equiv> take`{7205,3,[8]} (join`{901,8,[8]} (seq_compr`{901,[64],[8][8]} (\<lambda>(x :: [64]). (reverse`{8,[8]} (split`{8,8,Bit} x))) (vmulA`{} a b)))"

end
end
