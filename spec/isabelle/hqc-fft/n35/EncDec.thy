lemma cidx2_5:
  assumes "i < 256" "j < 32"
  shows "to_nat (drop'`{11,3,bool} (coerce_seq_len ((from_nat j :: (14, bool) seq) * 0x100 + from_nat i))) = i mod 8"
proof -
  define W where "W = (from_nat j :: (14, bool) seq) * 0x100 + from_nat i"
  have "to_nat (drop'`{11,3,bool} (coerce_seq_len W)) = unat (seq_to_word W) mod 8"
    by (simp add: to_nat_seq_to_word seq_to_word.drop' seq_to_word.coerce_seq_len unsigned_take_bit_eq take_bit_eq_mod unsigned_ucast_eq unat_mod mod_mod_cancel)
  moreover have "seq_to_word W = (word_of_nat (256 * j + i) :: 14 word)"
    by (simp add: W_def word_seq_convs seq_to_word.from_nat from_nat_word mult.commute)
  moreover have "unat (word_of_nat (256 * j + i) :: 14 word) = 256 * j + i" using assms by (simp only: u12_5)
  moreover have "(256 * j + i) mod 8 = i mod 8"
  proof -
    have "256 * j + i = i + 8 * (32 * j)" by simp
    then show ?thesis by (simp only: mod_mult_self2)
  qed
  ultimately show ?thesis by (simp add: W_def)
qed

lemma collect256_nth:
  assumes i: "i < 256" and j: "j < 32"
  shows "nth_seq (FFTEnc.collect256 fx (from_nat i)) j
       = FFTEnc.byteOf (nth_seq fx (32 * j + i div 8)) (drop'`{11,3,bool} (coerce_seq_len ((from_nat j :: (14, bool) seq) * 0x100 + from_nat i)))"
  using i j
  apply (simp add: FFTEnc.collect256_def seq_to_list nth_seq.rep_eq)
  apply (subst nth_list_concat_upt[where k=1])
    apply simp_all
  apply (simp add: cidx_5)
  done

lemma flat_bit_5:
  fixes fx :: "(1024, w64) seq"
  assumes p: "p < 65536"
  shows "bit (seq_to_word (FFTEnc.flat5 fx)) p = bit (seq_to_word (nth_seq fx (p div 64))) (p mod 64)"
proof -
  define xs where "xs = map seq_to_list (seq_to_list fx)"
  have lx: "\<forall>x\<in>set xs. length x = 64" by (auto simp: xs_def)
  have lxs: "length xs = 1024" by (simp add: xs_def)
  have "bit (seq_to_word (FFTEnc.flat5 fx)) p = concat (rev xs) ! (64 * length xs - Suc p)"
    using p by (simp add: bit_s2w flat5_list xs_def rev_map lxs)
  also have "\<dots> = (xs ! (p div 64)) ! (64 - Suc (p mod 64))"
    using p lx lxs by (intro concat_rev_nth) simp_all
  also have "\<dots> = bit (seq_to_word (nth_seq fx (p div 64))) (p mod 64)"
    using p by (simp add: xs_def bit_s2w nth_seq.rep_eq)
  finally show ?thesis .
qed

lemma encode_word_5:
  fixes fx :: "(1024, w64) seq"
  assumes e: "e < 2048"
  shows "seq_to_word (nth_seq (FFTEnc.encode5 fx) e)
       = foldl (XOR) 0 (map (\<lambda>j. if bit (seq_to_word (nth_seq fx (32 * j + e div 64))) (e mod 64) then encw ! j else 0) [0..<32])"
proof -
  have "seq_to_word (nth_seq (FFTEnc.encode5 fx) e) = seq_to_word (seq_to_list (FFTEnc.lin8 (FFTEnc.collect256 fx (from_nat (e div 8)))) ! (e mod 8))"
    using e by (simp add: nth_seq.rep_eq encode_nth_5)
  also have "\<dots> = foldl (XOR) 0 (map (\<lambda>j. if bit (seq_to_word (nth_seq (FFTEnc.collect256 fx (from_nat (e div 8))) j)) (e mod 8) then encw ! j else 0) [0..<32])"
    by (simp add: lin8_word)
  also have "\<dots> = foldl (XOR) 0 (map (\<lambda>j. if bit (seq_to_word (nth_seq fx (32 * j + e div 64))) (e mod 64) then encw ! j else 0) [0..<32])"
  proof (intro arg_cong[where f="foldl (XOR) 0"] map_cong refl)
    fix j assume "j \<in> set [0..<32]"
    then have j: "j < 32" by simp
    have i: "e div 8 < 256" using e by simp
    have a: "(e div 8) div 8 = e div 64" using div_mult2_eq[of e 8 8] by simp
    have b: "8 * ((e div 8) mod 8) + e mod 8 = e mod 64" using mod_mult2_eq[of e 8 8] by simp
    show "(if bit (seq_to_word (nth_seq (FFTEnc.collect256 fx (from_nat (e div 8))) j)) (e mod 8) then encw ! j else 0)
        = (if bit (seq_to_word (nth_seq fx (32 * j + e div 64))) (e mod 64) then encw ! j else 0)"
      using i j by (simp add: collect256_nth byteOf_bit cidx2_5 a b)
  qed
  finally show ?thesis .
qed

lemma encodeIdx_word_5:
  fixes fx :: "(1024, w64) seq"
  assumes e: "e < 2048"
  shows "seq_to_word (nth_seq (FFTEnc.encodeIdx5 fx) e)
       = foldl (XOR) 0 (map (\<lambda>j. if bit (seq_to_word (nth_seq fx (32 * j + e div 64))) (e mod 64) then encw ! j else 0) [0..<32])"
proof -
  define V where "V = (rev_seq (coerce_seq_len (map_seq (\<lambda>j. nth_end_list (seq_to_list (FFTEnc.flat5 fx)) (to_nat (0x800 * j + from_nat e)))
            (fromToLessThan TY(0) TY(32) TY((17, bool) seq)))) :: (32, bool) seq)"
  have nt: "nth_seq (FFTEnc.encodeIdx5 fx) e = FFTEnc.linmap TY(32) FFTEnc.encMat V"
    using e by (simp add: FFTEnc.encodeIdx5_def Let_def seq_to_list nth_seq.rep_eq V_def)
  show ?thesis
    unfolding nt linmap_word
  proof (intro arg_cong[where f="foldl (XOR) 0"] map_cong refl)
    fix j assume "j \<in> set [0..<32]"
    then have j: "j < 32" by simp
    have p: "2048 * j + e < 65536" using e j by simp
    have a: "(2048 * j + e) div 64 = 32 * j + e div 64" by simp
    have b: "(2048 * j + e) mod 64 = e mod 64"
    proof -
      have "2048 * j + e = e + 64 * (32 * j)" by simp
      then show ?thesis by (simp only: mod_mult_self2)
    qed
    show "(if bit (seq_to_word V) j then seq_to_word (nth_seq FFTEnc.encMat j) else 0)
        = (if bit (seq_to_word (nth_seq fx (32 * j + e div 64))) (e mod 64) then encw ! j else 0)"
    proof -
      have v: "bit (seq_to_word V) j = bit (seq_to_word (FFTEnc.flat5 fx)) (2048 * j + e)"
        unfolding V_def using e j by (rule encode_bit5)
      have w: "seq_to_word (nth_seq FFTEnc.encMat j) = encw ! j" using j by (simp add: encw_nth)
      show ?thesis by (simp only: v flat_bit_5[OF p] a b w)
    qed
  qed
qed

theorem encode5_eq_encodeIdx5: "FFTEnc.encode5 fx = FFTEnc.encodeIdx5 fx"
proof (rule L_inj, rule nth_equalityI)
  show "length (L (FFTEnc.encode5 fx)) = length (L (FFTEnc.encodeIdx5 fx))" by simp
next
  fix e assume "e < length (L (FFTEnc.encode5 fx))"
  then have e: "e < 2048" by simp
  show "L (FFTEnc.encode5 fx) ! e = L (FFTEnc.encodeIdx5 fx) ! e"
    using e by (simp add: L_nth' encode_word_5 encodeIdx_word_5)
qed

definition qw_5 :: "nat \<Rightarrow> (14, bool) seq" where "qw_5 x = from_nat x"

definition OB_5 :: "(2048, w64) seq \<Rightarrow> nat \<Rightarrow> (8, bool) seq" where
  "OB_5 fx x = nth_list (seq_to_list (FFTEnc.transpose8
     (map_seq (\<lambda>r. FFTEnc.byteOf r (take'`{3,3,bool} (coerce_seq_len (take'`{6,8,bool} (coerce_seq_len (qw_5 x))))))
        (nth_list (map (\<lambda>x. list_to_seq (map (FFTEnc.linmap TY(64) FFTEnc.decMat) (list_len 8 x)) :: (8, w64) seq) (group_list 256 8 (seq_to_list fx)))
          (to_nat (drop'`{6,8,bool} (coerce_seq_len (qw_5 x))))))))
     (to_nat (drop'`{3,3,bool} (coerce_seq_len (take'`{6,8,bool} (coerce_seq_len (qw_5 x))))))"

lemma decode_list_5: "seq_to_list (FFTEnc.decode5 fx)
   = rev (map (list_to_seq :: bool list \<Rightarrow> w64) (group_list 2048 64 (concat (map seq_to_list (rev (map (OB_5 fx) [0..<16384]))))))"
  by (simp add: FFTEnc.decode5_def Let_def FFTEnc.unflat25_def seq_to_list comp_def OB_5_def[abs_def] qw_5_def)

lemma decode_bit_5:
  fixes fx :: "(2048, w64) seq"
  assumes p: "p < 131072"
  shows "bitsof (L (FFTEnc.decode5 fx)) p = bit (seq_to_word (OB_5 fx (p div 8))) (p mod 8)"
proof -
  define xs where "xs = map (seq_to_list \<circ> OB_5 fx) [0..<16384]"
  define BL where "BL = concat (rev xs)"
  have lx: "\<forall>x\<in>set xs. length x = 8" by (auto simp: xs_def)
  have lxs: "length xs = 16384" by (simp add: xs_def)
  have lBL: "length BL = 2048 * 64"
  proof -
    have lc: "length (concat xs) = 16384 * 8" unfolding xs_def by (rule len_concat_upt) simp
    have "length BL = length (concat xs)" by (simp only: BL_def length_concat rev_map[symmetric] sum_list_rev)
    then show ?thesis using lc by simp
  qed
  define G where "G = group_list 2048 64 BL"
  have sl: "seq_to_list (FFTEnc.decode5 fx) = rev (map (list_to_seq :: bool list \<Rightarrow> w64) G)"
    by (simp add: decode_list_5 G_def BL_def xs_def rev_map comp_def)
  define i where "i = p div 64"
  define r where "r = p mod 64"
  have i: "i < 2048" using p by (simp add: i_def)
  have r: "r < 64" by (simp add: r_def)
  have pir: "p = 64 * i + r" by (simp add: i_def r_def)
  have lg: "length (G ! (2047 - i)) = 64" using i lBL by (simp add: G_def)
  have "L (FFTEnc.decode5 fx) ! i = seq_to_word (list_to_seq (G ! (2047 - i)) :: w64)"
    using i by (simp add: L_def sl rev_nth G_def)
  then have "bitsof (L (FFTEnc.decode5 fx)) p = bit (seq_to_word (list_to_seq (G ! (2047 - i)) :: w64)) r"
    using i by (simp add: bitsof_def L_def i_def r_def)
  also have "\<dots> = (G ! (2047 - i)) ! (63 - r)"
    using r lg by (simp add: bit_s2w)
  also have "\<dots> = BL ! ((2047 - i) * 64 + (63 - r))"
    using i r lBL by (simp add: G_def group_list_elem)
  also have "\<dots> = concat (rev xs) ! (8 * length xs - Suc p)"
  proof -
    have "(2047 - i) * 64 + (63 - r) = 8 * length xs - Suc p" using i r pir lxs by simp
    then show ?thesis by (simp add: BL_def)
  qed
  also have "\<dots> = (xs ! (p div 8)) ! (8 - Suc (p mod 8))"
    using p lx lxs by (intro concat_rev_nth) simp_all
  also have "\<dots> = bit (seq_to_word (OB_5 fx (p div 8))) (p mod 8)"
    using p by (simp add: xs_def bit_s2w)
  finally show ?thesis .
qed

lemma q6m_5: "q < 16384 \<Longrightarrow> to_nat (drop'`{6,8,bool} (coerce_seq_len (qw_5 q))) = q mod 256"
  by (simp add: qw_5_def word_seq_convs seq_to_word.from_nat from_nat_word seq_to_word.drop' seq_to_word.coerce_seq_len
      unsigned_take_bit_eq take_bit_eq_mod unsigned_ucast_eq unat_mod unat_of_nat)

lemma q6d_5: "q < 16384 \<Longrightarrow> to_nat (take'`{6,8,bool} (coerce_seq_len (qw_5 q))) = q div 256"
  by (simp add: qw_5_def word_seq_convs seq_to_word.from_nat from_nat_word seq_to_word.take' seq_to_word.coerce_seq_len
      unsigned_ucast_eq unat_drop_bit_eq drop_bit_eq_div unat_div take_bit_eq_mod unat_of_nat)

lemma rows_nth_5:
  fixes fx :: "(2048, w64) seq"
  assumes i: "i < 256" and b: "b < 8"
  shows "nth_seq (nth_list (map (\<lambda>x. list_to_seq (map (FFTEnc.linmap TY(64) FFTEnc.decMat) (list_len 8 x)) :: (8, w64) seq)
                     (group_list 256 8 (seq_to_list fx))) i) b
       = FFTEnc.linmap TY(64) FFTEnc.decMat (nth_seq fx (8 * i + b))"
proof -
  have lg: "length (group_list 256 8 (seq_to_list fx) ! i) = 8" using i by simp
  show ?thesis using i b lg by (simp add: nth_seq.rep_eq group_list_elem mult.commute)
qed

lemma OB_bit_5:
  fixes fx :: "(2048, w64) seq"
  assumes q: "q < 16384" and b: "b < 8"
  shows "bit (seq_to_word (OB_5 fx q)) b
       = bit (seq_to_word (FFTEnc.linmap TY(64) FFTEnc.decMat (nth_seq fx (8 * (q mod 256) + b)))) (q div 256)"
proof -
  define T where "T = (take'`{6,8,bool} (coerce_seq_len (qw_5 q)) :: (6, bool) seq)"
  define KB where "KB = (take'`{3,3,bool} (coerce_seq_len T) :: (3, bool) seq)"
  define RR where "RR = nth_list (map (\<lambda>x. list_to_seq (map (FFTEnc.linmap TY(64) FFTEnc.decMat) (list_len 8 x)) :: (8, w64) seq)
                     (group_list 256 8 (seq_to_list fx))) (q mod 256)"
  have tT: "to_nat T = q div 256" using q by (simp add: T_def q6d_5)
  have kb: "to_nat KB = q div 256 div 8" by (simp add: KB_def t3d tT)
  have jb: "to_nat (drop'`{3,3,bool} (coerce_seq_len T)) = q div 256 mod 8" by (simp add: t3m tT)
  have jl: "q div 256 mod 8 < 8" by simp
  have ob: "OB_5 fx q = nth_seq (FFTEnc.transpose8 (map_seq (\<lambda>r. FFTEnc.byteOf r KB) RR)) (q div 256 mod 8)"
    using q by (simp add: OB_5_def nth_seq.rep_eq q6m_5 jb RR_def KB_def T_def[symmetric])
  have "bit (seq_to_word (OB_5 fx q)) b = bit (seq_to_word (nth_seq (map_seq (\<lambda>r. FFTEnc.byteOf r KB) RR) b)) (q div 256 mod 8)"
    using b jl by (simp add: ob transpose8_bit)
  also have "\<dots> = bit (seq_to_word (FFTEnc.byteOf (nth_seq RR b) KB)) (q div 256 mod 8)"
    using b by simp
  also have "\<dots> = bit (seq_to_word (nth_seq RR b)) (8 * (q div 256 div 8) + q div 256 mod 8)"
    using jl by (simp add: byteOf_bit kb)
  also have "\<dots> = bit (seq_to_word (FFTEnc.linmap TY(64) FFTEnc.decMat (nth_seq fx (8 * (q mod 256) + b)))) (q div 256)"
  proof -
    have "nth_seq RR b = FFTEnc.linmap TY(64) FFTEnc.decMat (nth_seq fx (8 * (q mod 256) + b))"
      unfolding RR_def by (rule rows_nth_5) (simp_all add: b)
    moreover have "8 * (q div 256 div 8) + q div 256 mod 8 = q div 256" by simp
    ultimately show ?thesis by simp
  qed
  finally show ?thesis .
qed

theorem decode5_eq_decodeIdx5: "FFTEnc.decode5 fx = FFTEnc.decodeIdx5 fx"
proof (rule L_inj, rule bitsof_eqI)
  show "length (L (FFTEnc.decode5 fx)) = length (L (FFTEnc.decodeIdx5 fx))" by simp
next
  fix p assume "p < 64 * length (L (FFTEnc.decode5 fx))"
  then have p: "p < 131072" by simp
  have a: "8 * (p div 8 mod 256) + p mod 8 = p mod 2048" using mod_mult2_eq[of p 8 256] by simp
  have b: "p div 8 div 256 = p div 2048" using div_mult2_eq[of p 8 256] by simp
  show "bitsof (L (FFTEnc.decode5 fx)) p = bitsof (L (FFTEnc.decodeIdx5 fx)) p"
    using p by (simp add: decode_bit_5 OB_bit_5 decodeIdx5_bit a b)
qed

