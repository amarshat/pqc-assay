lemma OB_bit_1:
  fixes fx :: "(512, w64) seq"
  assumes q: "q < 4096" and b: "b < 8"
  shows "bit (seq_to_word (OB_1 fx q)) b
       = bit (seq_to_word (FFTEnc.linmap TY(64) FFTEnc.decMat (nth_seq fx (8 * (q mod 64) + b)))) (q div 64)"
proof -
  define T where "T = (take'`{6,6,bool} (coerce_seq_len (qw_1 q)) :: (6, bool) seq)"
  define KB where "KB = (take'`{3,3,bool} (coerce_seq_len T) :: (3, bool) seq)"
  define RR where "RR = nth_list (map (\<lambda>x. list_to_seq (map (FFTEnc.linmap TY(64) FFTEnc.decMat) (list_len 8 x)) :: (8, w64) seq)
                     (group_list 64 8 (seq_to_list fx))) (q mod 64)"
  have tT: "to_nat T = q div 64" using q by (simp add: T_def q6d_1)
  have kb: "to_nat KB = q div 64 div 8" by (simp add: KB_def t3d tT)
  have jb: "to_nat (drop'`{3,3,bool} (coerce_seq_len T)) = q div 64 mod 8" by (simp add: t3m tT)
  have jl: "q div 64 mod 8 < 8" by simp
  have ob: "OB_1 fx q = nth_seq (FFTEnc.transpose8 (map_seq (\<lambda>r. FFTEnc.byteOf r KB) RR)) (q div 64 mod 8)"
    using q by (simp add: OB_1_def nth_seq.rep_eq q6m_1 jb RR_def KB_def T_def[symmetric])
  have "bit (seq_to_word (OB_1 fx q)) b = bit (seq_to_word (nth_seq (map_seq (\<lambda>r. FFTEnc.byteOf r KB) RR) b)) (q div 64 mod 8)"
    using b jl by (simp add: ob transpose8_bit)
  also have "\<dots> = bit (seq_to_word (FFTEnc.byteOf (nth_seq RR b) KB)) (q div 64 mod 8)"
    using b by simp
  also have "\<dots> = bit (seq_to_word (nth_seq RR b)) (8 * (q div 64 div 8) + q div 64 mod 8)"
    using jl by (simp add: byteOf_bit kb)
  also have "\<dots> = bit (seq_to_word (FFTEnc.linmap TY(64) FFTEnc.decMat (nth_seq fx (8 * (q mod 64) + b)))) (q div 64)"
  proof -
    have "nth_seq RR b = FFTEnc.linmap TY(64) FFTEnc.decMat (nth_seq fx (8 * (q mod 64) + b))"
      unfolding RR_def by (rule rows_nth_1) (simp_all add: b)
    moreover have "8 * (q div 64 div 8) + q div 64 mod 8 = q div 64" by simp
    ultimately show ?thesis by simp
  qed
  finally show ?thesis .
qed

theorem decode_eq_decodeIdx: "FFTEnc.decode fx = FFTEnc.decodeIdx fx"
proof (rule L_inj, rule bitsof_eqI)
  show "length (L (FFTEnc.decode fx)) = length (L (FFTEnc.decodeIdx fx))" by simp
next
  fix p assume "p < 64 * length (L (FFTEnc.decode fx))"
  then have p: "p < 32768" by simp
  have a: "8 * (p div 8 mod 64) + p mod 8 = p mod 512" using mod_mult2_eq[of p 8 64] by simp
  have b: "p div 8 div 64 = p div 512" using div_mult2_eq[of p 8 64] by simp
  show "bitsof (L (FFTEnc.decode fx)) p = bitsof (L (FFTEnc.decodeIdx fx)) p"
    using p by (simp add: decode_bit_1 OB_bit_1 decodeIdx_bit a b)
qed


subsection \<open>hqc-3\<close>

lemma encode_list_3: "seq_to_list (FFTEnc.encode3 fx) = concat (map (\<lambda>i. seq_to_list (FFTEnc.lin8 (FFTEnc.collect128 fx (from_nat i)))) [0..<128])"
  by (simp add: FFTEnc.encode3_def seq_to_list comp_def)

lemma encode_nth_3: "e < 1024 \<Longrightarrow> seq_to_list (FFTEnc.encode3 fx) ! e = seq_to_list (FFTEnc.lin8 (FFTEnc.collect128 fx (from_nat (e div 8)))) ! (e mod 8)"
  unfolding encode_list_3 by (subst nth_concat_upt[where k=8]) simp_all

lemma w12_3: "(word_of_nat j * 0x80 + word_of_nat i :: 13 word) = word_of_nat (128 * j + i)"
  by simp

lemma u12_3: "x < 8192 \<Longrightarrow> unat (word_of_nat x :: 13 word) = x"
  by (rule unat_of_nat_eq) simp

lemma cidx_3:
  assumes "i < 128" "j < 32"
  shows "to_nat ((from_nat j :: (13, bool) seq) * 0x80 + from_nat i >> 3) = 16 * j + i div 8"
proof -
  have "to_nat ((from_nat j :: (13, bool) seq) * 0x80 + from_nat i >> 3) = unat (drop_bit 3 (word_of_nat (128 * j + i) :: 13 word))"
    by (simp add: word_seq_convs seq_to_word.from_nat from_nat_word mult.commute seq_to_word.right_shift right_shift_def shiftr_def)
  also have "\<dots> = unat (word_of_nat (128 * j + i) :: 13 word) div 2 ^ 3" by (simp only: unat_drop_bit_eq) (simp only: drop_bit_eq_div)
  also have "\<dots> = (128 * j + i) div 2 ^ 3" using assms by (simp only: u12_3)
  finally show ?thesis using assms by simp
qed

lemma cidx2_3:
  assumes "i < 128" "j < 32"
  shows "to_nat (drop'`{10,3,bool} (coerce_seq_len ((from_nat j :: (13, bool) seq) * 0x80 + from_nat i))) = i mod 8"
proof -
  define W where "W = (from_nat j :: (13, bool) seq) * 0x80 + from_nat i"
  have "to_nat (drop'`{10,3,bool} (coerce_seq_len W)) = unat (seq_to_word W) mod 8"
    by (simp add: to_nat_seq_to_word seq_to_word.drop' seq_to_word.coerce_seq_len unsigned_take_bit_eq take_bit_eq_mod unsigned_ucast_eq unat_mod mod_mod_cancel)
  moreover have "seq_to_word W = (word_of_nat (128 * j + i) :: 13 word)"
    by (simp add: W_def word_seq_convs seq_to_word.from_nat from_nat_word mult.commute)
  moreover have "unat (word_of_nat (128 * j + i) :: 13 word) = 128 * j + i" using assms by (simp only: u12_3)
  moreover have "(128 * j + i) mod 8 = i mod 8"
  proof -
    have "128 * j + i = i + 8 * (16 * j)" by simp
    then show ?thesis by (simp only: mod_mult_self2)
  qed
  ultimately show ?thesis by (simp add: W_def)
qed

lemma collect128_nth:
  assumes i: "i < 128" and j: "j < 32"
  shows "nth_seq (FFTEnc.collect128 fx (from_nat i)) j
       = FFTEnc.byteOf (nth_seq fx (16 * j + i div 8)) (drop'`{10,3,bool} (coerce_seq_len ((from_nat j :: (13, bool) seq) * 0x80 + from_nat i)))"
  using i j
  apply (simp add: FFTEnc.collect128_def seq_to_list nth_seq.rep_eq)
  apply (subst nth_list_concat_upt[where k=1])
    apply simp_all
  apply (simp add: cidx_3)
  done

lemma flat_bit_3:
  fixes fx :: "(512, w64) seq"
  assumes p: "p < 32768"
  shows "bit (seq_to_word (FFTEnc.flat3 fx)) p = bit (seq_to_word (nth_seq fx (p div 64))) (p mod 64)"
proof -
  define xs where "xs = map seq_to_list (seq_to_list fx)"
  have lx: "\<forall>x\<in>set xs. length x = 64" by (auto simp: xs_def)
  have lxs: "length xs = 512" by (simp add: xs_def)
  have "bit (seq_to_word (FFTEnc.flat3 fx)) p = concat (rev xs) ! (64 * length xs - Suc p)"
    using p by (simp add: bit_s2w flat3_list xs_def rev_map lxs)
  also have "\<dots> = (xs ! (p div 64)) ! (64 - Suc (p mod 64))"
    using p lx lxs by (intro concat_rev_nth) simp_all
  also have "\<dots> = bit (seq_to_word (nth_seq fx (p div 64))) (p mod 64)"
    using p by (simp add: xs_def bit_s2w nth_seq.rep_eq)
  finally show ?thesis .
qed

lemma encode_word_3:
  fixes fx :: "(512, w64) seq"
  assumes e: "e < 1024"
  shows "seq_to_word (nth_seq (FFTEnc.encode3 fx) e)
       = foldl (XOR) 0 (map (\<lambda>j. if bit (seq_to_word (nth_seq fx (16 * j + e div 64))) (e mod 64) then encw ! j else 0) [0..<32])"
proof -
  have "seq_to_word (nth_seq (FFTEnc.encode3 fx) e) = seq_to_word (seq_to_list (FFTEnc.lin8 (FFTEnc.collect128 fx (from_nat (e div 8)))) ! (e mod 8))"
    using e by (simp add: nth_seq.rep_eq encode_nth_3)
  also have "\<dots> = foldl (XOR) 0 (map (\<lambda>j. if bit (seq_to_word (nth_seq (FFTEnc.collect128 fx (from_nat (e div 8))) j)) (e mod 8) then encw ! j else 0) [0..<32])"
    by (simp add: lin8_word)
  also have "\<dots> = foldl (XOR) 0 (map (\<lambda>j. if bit (seq_to_word (nth_seq fx (16 * j + e div 64))) (e mod 64) then encw ! j else 0) [0..<32])"
  proof (intro arg_cong[where f="foldl (XOR) 0"] map_cong refl)
    fix j assume "j \<in> set [0..<32]"
    then have j: "j < 32" by simp
    have i: "e div 8 < 128" using e by simp
    have a: "(e div 8) div 8 = e div 64" using div_mult2_eq[of e 8 8] by simp
    have b: "8 * ((e div 8) mod 8) + e mod 8 = e mod 64" using mod_mult2_eq[of e 8 8] by simp
    show "(if bit (seq_to_word (nth_seq (FFTEnc.collect128 fx (from_nat (e div 8))) j)) (e mod 8) then encw ! j else 0)
        = (if bit (seq_to_word (nth_seq fx (16 * j + e div 64))) (e mod 64) then encw ! j else 0)"
      using i j by (simp add: collect128_nth byteOf_bit cidx2_3 a b)
  qed
  finally show ?thesis .
qed

lemma encodeIdx_word_3:
  fixes fx :: "(512, w64) seq"
  assumes e: "e < 1024"
  shows "seq_to_word (nth_seq (FFTEnc.encodeIdx3 fx) e)
       = foldl (XOR) 0 (map (\<lambda>j. if bit (seq_to_word (nth_seq fx (16 * j + e div 64))) (e mod 64) then encw ! j else 0) [0..<32])"
proof -
  define V where "V = (rev_seq (coerce_seq_len (map_seq (\<lambda>j. nth_end_list (seq_to_list (FFTEnc.flat3 fx)) (to_nat (0x400 * j + from_nat e)))
            (fromToLessThan TY(0) TY(32) TY((16, bool) seq)))) :: (32, bool) seq)"
  have nt: "nth_seq (FFTEnc.encodeIdx3 fx) e = FFTEnc.linmap TY(32) FFTEnc.encMat V"
    using e by (simp add: FFTEnc.encodeIdx3_def Let_def seq_to_list nth_seq.rep_eq V_def)
  show ?thesis
    unfolding nt linmap_word
  proof (intro arg_cong[where f="foldl (XOR) 0"] map_cong refl)
    fix j assume "j \<in> set [0..<32]"
    then have j: "j < 32" by simp
    have p: "1024 * j + e < 32768" using e j by simp
    have a: "(1024 * j + e) div 64 = 16 * j + e div 64" by simp
    have b: "(1024 * j + e) mod 64 = e mod 64"
    proof -
      have "1024 * j + e = e + 64 * (16 * j)" by simp
      then show ?thesis by (simp only: mod_mult_self2)
    qed
    show "(if bit (seq_to_word V) j then seq_to_word (nth_seq FFTEnc.encMat j) else 0)
        = (if bit (seq_to_word (nth_seq fx (16 * j + e div 64))) (e mod 64) then encw ! j else 0)"
    proof -
      have v: "bit (seq_to_word V) j = bit (seq_to_word (FFTEnc.flat3 fx)) (1024 * j + e)"
        unfolding V_def using e j by (rule encode_bit3)
      have w: "seq_to_word (nth_seq FFTEnc.encMat j) = encw ! j" using j by (simp add: encw_nth)
      show ?thesis by (simp only: v flat_bit_3[OF p] a b w)
    qed
  qed
qed

theorem encode3_eq_encodeIdx3: "FFTEnc.encode3 fx = FFTEnc.encodeIdx3 fx"
proof (rule L_inj, rule nth_equalityI)
  show "length (L (FFTEnc.encode3 fx)) = length (L (FFTEnc.encodeIdx3 fx))" by simp
next
  fix e assume "e < length (L (FFTEnc.encode3 fx))"
  then have e: "e < 1024" by simp
  show "L (FFTEnc.encode3 fx) ! e = L (FFTEnc.encodeIdx3 fx) ! e"
    using e by (simp add: L_nth' encode_word_3 encodeIdx_word_3)
qed

definition qw_3 :: "nat \<Rightarrow> (13, bool) seq" where "qw_3 x = from_nat x"

definition OB_3 :: "(1024, w64) seq \<Rightarrow> nat \<Rightarrow> (8, bool) seq" where
  "OB_3 fx x = nth_list (seq_to_list (FFTEnc.transpose8
     (map_seq (\<lambda>r. FFTEnc.byteOf r (take'`{3,3,bool} (coerce_seq_len (take'`{6,7,bool} (coerce_seq_len (qw_3 x))))))
        (nth_list (map (\<lambda>x. list_to_seq (map (FFTEnc.linmap TY(64) FFTEnc.decMat) (list_len 8 x)) :: (8, w64) seq) (group_list 128 8 (seq_to_list fx)))
          (to_nat (drop'`{6,7,bool} (coerce_seq_len (qw_3 x))))))))
     (to_nat (drop'`{3,3,bool} (coerce_seq_len (take'`{6,7,bool} (coerce_seq_len (qw_3 x))))))"

lemma decode_list_3: "seq_to_list (FFTEnc.decode3 fx)
   = rev (map (list_to_seq :: bool list \<Rightarrow> w64) (group_list 1024 64 (concat (map seq_to_list (rev (map (OB_3 fx) [0..<8192]))))))"
  by (simp add: FFTEnc.decode3_def Let_def FFTEnc.unflat23_def seq_to_list comp_def OB_3_def[abs_def] qw_3_def)

lemma decode_bit_3:
  fixes fx :: "(1024, w64) seq"
  assumes p: "p < 65536"
  shows "bitsof (L (FFTEnc.decode3 fx)) p = bit (seq_to_word (OB_3 fx (p div 8))) (p mod 8)"
proof -
  define xs where "xs = map (seq_to_list \<circ> OB_3 fx) [0..<8192]"
  define BL where "BL = concat (rev xs)"
  have lx: "\<forall>x\<in>set xs. length x = 8" by (auto simp: xs_def)
  have lxs: "length xs = 8192" by (simp add: xs_def)
  have lBL: "length BL = 1024 * 64"
  proof -
    have lc: "length (concat xs) = 8192 * 8" unfolding xs_def by (rule len_concat_upt) simp
    have "length BL = length (concat xs)" by (simp only: BL_def length_concat rev_map[symmetric] sum_list_rev)
    then show ?thesis using lc by simp
  qed
  define G where "G = group_list 1024 64 BL"
  have sl: "seq_to_list (FFTEnc.decode3 fx) = rev (map (list_to_seq :: bool list \<Rightarrow> w64) G)"
    by (simp add: decode_list_3 G_def BL_def xs_def rev_map comp_def)
  define i where "i = p div 64"
  define r where "r = p mod 64"
  have i: "i < 1024" using p by (simp add: i_def)
  have r: "r < 64" by (simp add: r_def)
  have pir: "p = 64 * i + r" by (simp add: i_def r_def)
  have lg: "length (G ! (1023 - i)) = 64" using i lBL by (simp add: G_def)
  have "L (FFTEnc.decode3 fx) ! i = seq_to_word (list_to_seq (G ! (1023 - i)) :: w64)"
    using i by (simp add: L_def sl rev_nth G_def)
  then have "bitsof (L (FFTEnc.decode3 fx)) p = bit (seq_to_word (list_to_seq (G ! (1023 - i)) :: w64)) r"
    using i by (simp add: bitsof_def L_def i_def r_def)
  also have "\<dots> = (G ! (1023 - i)) ! (63 - r)"
    using r lg by (simp add: bit_s2w)
  also have "\<dots> = BL ! ((1023 - i) * 64 + (63 - r))"
    using i r lBL by (simp add: G_def group_list_elem)
  also have "\<dots> = concat (rev xs) ! (8 * length xs - Suc p)"
  proof -
    have "(1023 - i) * 64 + (63 - r) = 8 * length xs - Suc p" using i r pir lxs by simp
    then show ?thesis by (simp add: BL_def)
  qed
  also have "\<dots> = (xs ! (p div 8)) ! (8 - Suc (p mod 8))"
    using p lx lxs by (intro concat_rev_nth) simp_all
  also have "\<dots> = bit (seq_to_word (OB_3 fx (p div 8))) (p mod 8)"
    using p by (simp add: xs_def bit_s2w)
  finally show ?thesis .
qed

lemma q6m_3: "q < 8192 \<Longrightarrow> to_nat (drop'`{6,7,bool} (coerce_seq_len (qw_3 q))) = q mod 128"
  by (simp add: qw_3_def word_seq_convs seq_to_word.from_nat from_nat_word seq_to_word.drop' seq_to_word.coerce_seq_len
      unsigned_take_bit_eq take_bit_eq_mod unsigned_ucast_eq unat_mod unat_of_nat)

lemma q6d_3: "q < 8192 \<Longrightarrow> to_nat (take'`{6,7,bool} (coerce_seq_len (qw_3 q))) = q div 128"
  by (simp add: qw_3_def word_seq_convs seq_to_word.from_nat from_nat_word seq_to_word.take' seq_to_word.coerce_seq_len
      unsigned_ucast_eq unat_drop_bit_eq drop_bit_eq_div unat_div take_bit_eq_mod unat_of_nat)

lemma rows_nth_3:
  fixes fx :: "(1024, w64) seq"
  assumes i: "i < 128" and b: "b < 8"
  shows "nth_seq (nth_list (map (\<lambda>x. list_to_seq (map (FFTEnc.linmap TY(64) FFTEnc.decMat) (list_len 8 x)) :: (8, w64) seq)
                     (group_list 128 8 (seq_to_list fx))) i) b
       = FFTEnc.linmap TY(64) FFTEnc.decMat (nth_seq fx (8 * i + b))"
proof -
  have lg: "length (group_list 128 8 (seq_to_list fx) ! i) = 8" using i by simp
  show ?thesis using i b lg by (simp add: nth_seq.rep_eq group_list_elem mult.commute)
qed

lemma OB_bit_3:
  fixes fx :: "(1024, w64) seq"
  assumes q: "q < 8192" and b: "b < 8"
  shows "bit (seq_to_word (OB_3 fx q)) b
       = bit (seq_to_word (FFTEnc.linmap TY(64) FFTEnc.decMat (nth_seq fx (8 * (q mod 128) + b)))) (q div 128)"
proof -
  define T where "T = (take'`{6,7,bool} (coerce_seq_len (qw_3 q)) :: (6, bool) seq)"
  define KB where "KB = (take'`{3,3,bool} (coerce_seq_len T) :: (3, bool) seq)"
  define RR where "RR = nth_list (map (\<lambda>x. list_to_seq (map (FFTEnc.linmap TY(64) FFTEnc.decMat) (list_len 8 x)) :: (8, w64) seq)
                     (group_list 128 8 (seq_to_list fx))) (q mod 128)"
  have tT: "to_nat T = q div 128" using q by (simp add: T_def q6d_3)
  have kb: "to_nat KB = q div 128 div 8" by (simp add: KB_def t3d tT)
  have jb: "to_nat (drop'`{3,3,bool} (coerce_seq_len T)) = q div 128 mod 8" by (simp add: t3m tT)
  have jl: "q div 128 mod 8 < 8" by simp
  have ob: "OB_3 fx q = nth_seq (FFTEnc.transpose8 (map_seq (\<lambda>r. FFTEnc.byteOf r KB) RR)) (q div 128 mod 8)"
    using q by (simp add: OB_3_def nth_seq.rep_eq q6m_3 jb RR_def KB_def T_def[symmetric])
  have "bit (seq_to_word (OB_3 fx q)) b = bit (seq_to_word (nth_seq (map_seq (\<lambda>r. FFTEnc.byteOf r KB) RR) b)) (q div 128 mod 8)"
    using b jl by (simp add: ob transpose8_bit)
  also have "\<dots> = bit (seq_to_word (FFTEnc.byteOf (nth_seq RR b) KB)) (q div 128 mod 8)"
    using b by simp
  also have "\<dots> = bit (seq_to_word (nth_seq RR b)) (8 * (q div 128 div 8) + q div 128 mod 8)"
    using jl by (simp add: byteOf_bit kb)
  also have "\<dots> = bit (seq_to_word (FFTEnc.linmap TY(64) FFTEnc.decMat (nth_seq fx (8 * (q mod 128) + b)))) (q div 128)"
  proof -
    have "nth_seq RR b = FFTEnc.linmap TY(64) FFTEnc.decMat (nth_seq fx (8 * (q mod 128) + b))"
      unfolding RR_def by (rule rows_nth_3) (simp_all add: b)
    moreover have "8 * (q div 128 div 8) + q div 128 mod 8 = q div 128" by simp
    ultimately show ?thesis by simp
  qed
  finally show ?thesis .
qed

theorem decode3_eq_decodeIdx3: "FFTEnc.decode3 fx = FFTEnc.decodeIdx3 fx"
proof (rule L_inj, rule bitsof_eqI)
  show "length (L (FFTEnc.decode3 fx)) = length (L (FFTEnc.decodeIdx3 fx))" by simp
next
  fix p assume "p < 64 * length (L (FFTEnc.decode3 fx))"
  then have p: "p < 65536" by simp
  have a: "8 * (p div 8 mod 128) + p mod 8 = p mod 1024" using mod_mult2_eq[of p 8 128] by simp
  have b: "p div 8 div 128 = p div 1024" using div_mult2_eq[of p 8 128] by simp
  show "bitsof (L (FFTEnc.decode3 fx)) p = bitsof (L (FFTEnc.decodeIdx3 fx)) p"
    using p by (simp add: decode_bit_3 OB_bit_3 decodeIdx3_bit a b)
qed


