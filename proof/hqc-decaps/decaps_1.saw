// HQC v5.0.0 crypto_kem_dec, hqc-1: the C equals Decaps1::decaps (FO with implicit rejection) for
// every ciphertext and secret key, with the PKE and the hash functions as assumed, uninterpreted
// specifications. Built from target/hqc/kem (kem.c, vector.c, parsing.c, crypto_memset.c as one
// unit), so vect_compare, hqc_c_kem_from_string and the selection loop are the shipped code.

import "Decaps1.cry";
let check restrict path = do {
    m <- llvm_load_module path;

    let i8 = llvm_int 8;
    let arr n = llvm_array n i8;
    let pke = llvm_alias "struct.ciphertext_pke_t";
    let kemct = llvm_alias "struct.ciphertext_kem_t";
    let UNINT = ["pkeDec", "pkeEncU", "pkeEncV", "hashH", "hashG", "hashJ"];

    let in_bytes name n = do {
        x <- llvm_fresh_var name (arr n);
        p <- llvm_alloc_readonly (arr n);
        llvm_points_to p (llvm_term x);
        return (x, p);
    };

    // Assumed: the hash functions are functions of their inputs (A-HQC-DEC item 1).
    let hash_h_spec = do {
        out <- llvm_alloc (arr 32);
        (ek, ekp) <- in_bytes "ek" 2241;
        llvm_execute_func [out, ekp];
        llvm_points_to out (llvm_term {{ hashH ek }});
    };
    let hash_g_spec = do {
        out <- llvm_alloc (arr 64);
        (h, hp) <- in_bytes "h" 32;
        (mm, mp) <- in_bytes "m" 16;
        (s, sp) <- in_bytes "salt" 16;
        llvm_execute_func [out, hp, mp, sp];
        llvm_points_to out (llvm_term {{ hashG h mm s }});
    };
    let hash_j_spec = do {
        out <- llvm_alloc (arr 32);
        (h, hp) <- in_bytes "h" 32;
        (sg, sgp) <- in_bytes "sigma" 16;
        u <- llvm_fresh_var "u" (llvm_array 277 (llvm_int 64));
        v <- llvm_fresh_var "v" (llvm_array 277 (llvm_int 64));
        s <- llvm_fresh_var "salt" (arr 16);
        cp <- llvm_alloc_readonly kemct;
        llvm_points_to cp (llvm_struct_value [llvm_struct_value [llvm_term u, llvm_term v], llvm_term s]);
        llvm_execute_func [out, hp, sgp, cp];
        llvm_points_to out (llvm_term {{ hashJ h sg u v s }});
    };
    // Assumed: decryption writes a function of the PKE secret seed and the ciphertext, and returns 0
    // (hqc.c ends hqc_pke_decrypt with "return 0;") (A-HQC-DEC item 2).
    let pke_dec_spec = do {
        mp <- llvm_alloc (arr 16);
        (dk, dkp) <- in_bytes "dk" 32;
        u <- llvm_fresh_var "u" (llvm_array 277 (llvm_int 64));
        v <- llvm_fresh_var "v" (llvm_array 277 (llvm_int 64));
        cp <- llvm_alloc_readonly pke;
        llvm_points_to cp (llvm_struct_value [llvm_term u, llvm_term v]);
        llvm_execute_func [mp, dkp, cp];
        llvm_points_to mp (llvm_term {{ pkeDec dk u v }});
        llvm_return (llvm_term {{ 0 : [8] }});
    };
    // Assumed: encryption writes u and v as functions of ek, m and theta (A-HQC-DEC item 3).
    let pke_enc_spec = do {
        cp <- llvm_alloc pke;
        (ek, ekp) <- in_bytes "ek" 2241;
        (mm, mp) <- in_bytes "m" 16;
        (th, thp) <- in_bytes "theta" 32;
        llvm_execute_func [cp, ekp, mp, thp];
        llvm_points_to cp (llvm_struct_value [llvm_term {{ pkeEncU ek mm th }}, llvm_term {{ pkeEncV ek mm th }}]);
    };


    // vect_compare, proved (not assumed) at the three sizes decapsulation uses: 0 iff equal, else 1.
    let vect_compare_spec n = do {
        (a, ap) <- in_bytes "a" n;
        (b, bp) <- in_bytes "b" n;
        llvm_execute_func [ap, bp, llvm_term {{ `n : [32] }}];
        llvm_return (llvm_term {{ if a == b then 0 else 1 : [8] }});
    };
    let vect_compare_mut_spec n = do {
        (a, ap) <- in_bytes "a" n;
        (b, bp) <- in_bytes "b" n;
        llvm_execute_func [ap, bp, llvm_term {{ `n : [32] }}];
        llvm_return (llvm_term {{ if take`{1} a == take`{1} b then 0 else 1 : [8] }});
    };
    vc_u <- llvm_verify m "vect_compare" [] false (vect_compare_spec 2209) z3;
    vc_v <- llvm_verify m "vect_compare" [] false (vect_compare_spec 2208) z3;
    vc_s <- llvm_verify m "vect_compare" [] false (vect_compare_spec 16) z3;

    hh <- llvm_unsafe_assume_spec m "hash_h" hash_h_spec;
    hg <- llvm_unsafe_assume_spec m "hash_g" hash_g_spec;
    hj <- llvm_unsafe_assume_spec m "hash_j" hash_j_spec;
    pd <- llvm_unsafe_assume_spec m "hqc_pke_decrypt" pke_dec_spec;
    pe <- llvm_unsafe_assume_spec m "hqc_pke_encrypt" pke_enc_spec;
    let OV = [hh, hg, hj, pd, pe, vc_u, vc_v, vc_s];

    let dec_spec model = do {
        llvm_alloc_global "memset_volatile";
        llvm_points_to (llvm_global "memset_volatile") (llvm_global_initializer "memset_volatile");
        kp <- llvm_alloc (arr 32);
        (c, cp) <- in_bytes "c" 4433;
        (sk, skp) <- in_bytes "sk" 2321;
        // For the mutants only: a counterexample in a smaller domain refutes too, and pinning
        // c and sk leaves the solver only the hash and PKE interpretations to choose. sk is a
        // byte ramp of period 251, so slices of it at different offsets differ.
        if restrict then llvm_precond {{ c == zero /\ sk == skRamp }} else return ();
        llvm_execute_func [kp, cp, skp];
        llvm_points_to kp (llvm_term (model c sk));
        llvm_return (llvm_term {{ 0 : [32] }});
    };

    llvm_verify m "crypto_kem_dec" OV false (dec_spec (\c sk -> {{ decaps c sk }})) (w4_unint_yices UNINT);
    return ();
};

check false "../../build/hqc-decaps/dec_1.bc";
m0 <- llvm_load_module "../../build/hqc-decaps/dec_1.bc";
let vc_mut = do {
    a <- llvm_fresh_var "a" (llvm_array 16 (llvm_int 8));
    ap <- llvm_alloc_readonly (llvm_array 16 (llvm_int 8));
    llvm_points_to ap (llvm_term a);
    b <- llvm_fresh_var "b" (llvm_array 16 (llvm_int 8));
    bp <- llvm_alloc_readonly (llvm_array 16 (llvm_int 8));
    llvm_points_to bp (llvm_term b);
    llvm_execute_func [ap, bp, llvm_term {{ 16 : [32] }}];
    llvm_return (llvm_term {{ if take`{1} a == take`{1} b then 0 else 1 : [8] }});
};
fails (llvm_verify m0 "vect_compare" [] false vc_mut z3);
print "VERIFIED: hqc-1 crypto_kem_dec == decaps (implicit rejection); vect_compare proved at 2209, 2208, 16";

// CVE-2024-54137 shapes (liboqs advisory GHSA-gpf4-vrrw-r8v7), applied to copies of kem.c in build/:
// bug1, re-encryption reads its public key from the wrong offset of the secret key; bug2, the
// selection mask inverted as in the vulnerable code; both, the combination, which accepts every
// honest ciphertext and so passes functional tests. Each must be refuted.
// Positive control: the restricted check passes on the shipped code, so the precondition the
// mutant runs use type-checks and is satisfiable, and their failures are refutations.
check true "../../build/hqc-decaps/dec_1.bc";
fails (check true "../../build/hqc-decaps/mut/dec_1_bug1.bc");
fails (check true "../../build/hqc-decaps/mut/dec_1_bug2.bc");
fails (check true "../../build/hqc-decaps/mut/dec_1_both.bc");
print "REFUTED: all three CVE-2024-54137 mutants";
