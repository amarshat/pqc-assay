+    // v4: a second, independently computed validity mask.
+    result2 = vect_compare((uint8_t *)c_pke_u, (uint8_t *)c_pke_prime_u, VEC_N_SIZE_BYTES);
+    result2 |= vect_compare((uint8_t *)c_pke_v, (uint8_t *)c_pke_prime_v, VEC_N1N2_SIZE_BYTES);
+    result2 |= vect_compare(salt, salt_prime, SALT_BYTES);
+    result2 -= 1;
+    // v4: hide the 0/1 range of both masks from the optimizer.
+    barrier = result;
+    result = barrier;
+    barrier = result2;
+    result2 = barrier;
+    // v4.1: write the rejection key into the output first, so a fault that ends the selection loop
+    // early leaves rejection-key bytes there instead of the caller's previous buffer.
     for (size_t i = 0; i < SHARED_SECRET_BYTES_KEM; ++i) {
