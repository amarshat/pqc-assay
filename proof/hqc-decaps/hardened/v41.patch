@@ -263,6 +266,16 @@
     // Parse ciphertext c_kem
     hqc_c_kem_from_string(c_pke_u, c_pke_v, salt, c_kem);
 
+    // v4: a skipped re-encryption must not leave buffers that a chosen ciphertext can match. Start
+    // them from the complement of the received u and v; volatile stores so that the compiler cannot
+    // drop them as dead.
+    for (size_t i = 0; i < VEC_N_PKE_WORDS; ++i) {
+        ((volatile uint64_t *)c_pke_prime_u)[i] = ~c_pke_u[i];
+    }
+    for (size_t i = 0; i < VEC_N1N2_PKE_WORDS; ++i) {
+        ((volatile uint64_t *)c_pke_prime_v)[i] = ~c_pke_v[i];
+    }
+
     // Compute message m_prime
     result = hqc_pke_decrypt((uint64_t *)m_prime, dk_pke, c_pke_u, c_pke_v);
 
@@ -275,13 +288,35 @@
 
     // Compute rejection key K_bar
     hash_j(K_bar, hash_ek_pke, sigma, c_pke_u, c_pke_v, salt);
+    // v4: a second, independent computation of the rejection key. Both buffers start at zero, so if
+    // one call is skipped the OR of the two is still J; a corrupted buffer ORed with the other keeps
+    // the secret J bits.
+    hash_j(K_bar2, hash_ek_pke, sigma, c_pke_u, c_pke_v, salt);
     result |= vect_compare((uint8_t *)c_pke_u, (uint8_t *)c_pke_prime_u, VEC_N_SIZE_BYTES);
     result |= vect_compare((uint8_t *)c_pke_v, (uint8_t *)c_pke_prime_v, VEC_N1N2_SIZE_BYTES);
     result |= vect_compare(salt, salt_prime, SALT_BYTES);
