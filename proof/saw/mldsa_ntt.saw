// SAW proof: the vendored PQClean C reduction primitives implement the Cryptol model bit-for-bit.
//
// SCOPE (v1): the reduce.c layer — montgomery_reduce (under its documented precondition) plus
// reduce32, caddq, freeze (unconditionally). The forward NTT is out of scope.
//
// Paths are relative to THIS script's directory (SAW resolves load/import that way):
//   ../../build/mldsa_ntt.bc            <- built by scripts/build_bitcode.sh from target/pqclean
//   ../../model/cryptol/MLDSA_NTT.cry   <- the hand-written model (checkpoint 3)
//
// This script must exit 0 ONLY when llvm_verify genuinely discharges the proof.

enable_experimental;

m <- llvm_load_module "../../build/mldsa_ntt.bc";
import "../../model/cryptol/MLDSA_NTT.cry";

// Spec: for a 64-bit input `a` within the documented range -2^31*Q <= a <= Q*2^31, the C
// function returns exactly `montgomery_reduce a` from the Cryptol model.
let montgomery_reduce_spec = do {
    a <- llvm_fresh_var "a" (llvm_int 64);
    llvm_precond {{ mont_in_range a }};
    llvm_execute_func [llvm_term a];
    llvm_return (llvm_term {{ montgomery_reduce a }});
};

montgomery_reduce_ov <-
    llvm_verify m "PQCLEAN_MLDSA44_CLEAN_montgomery_reduce" [] true montgomery_reduce_spec z3;
// NB: a CVC5 two-solver cross-check was attempted but CVC5 does not terminate in reasonable time on
// this goal (the nonlinear a*QINV / t*Q products; CVC5 spins in --nl-cov). z3 discharges it in
// seconds. We keep z3 only here; non-vacuity is covered by the inline mutants below, and
// additionally by scripts/mutation_test.sh (make mutation-test) for this one function.

print "VERIFIED: PQCLEAN_MLDSA44_CLEAN_montgomery_reduce == Cryptol montgomery_reduce (under -2^31*Q <= a <= Q*2^31)";

// --- the rest of the reduce.c layer: reduce32, caddq, freeze (unconditional [32] -> [32]) ---

// reduce32 carries the documented precondition a <= 2^31-2^22-1 (so the a+(1<<22) add can't overflow).
let reduce32_spec = do {
    a <- llvm_fresh_var "a" (llvm_int 32);
    llvm_precond {{ reduce32_in_range a }};
    llvm_execute_func [llvm_term a];
    llvm_return (llvm_term {{ reduce32 a }});
};
reduce32_ov <- llvm_verify m "PQCLEAN_MLDSA44_CLEAN_reduce32" [] true reduce32_spec z3;

let caddq_spec = do {
    a <- llvm_fresh_var "a" (llvm_int 32);
    llvm_execute_func [llvm_term a];
    llvm_return (llvm_term {{ caddq a }});
};
caddq_ov <- llvm_verify m "PQCLEAN_MLDSA44_CLEAN_caddq" [] true caddq_spec z3;

// freeze calls reduce32 then caddq; use the proven specs as overrides (compositional verification).
// It inherits reduce32's precondition on the input.
let freeze_spec = do {
    a <- llvm_fresh_var "a" (llvm_int 32);
    llvm_precond {{ reduce32_in_range a }};
    llvm_execute_func [llvm_term a];
    llvm_return (llvm_term {{ freeze a }});
};
freeze_ov <- llvm_verify m "PQCLEAN_MLDSA44_CLEAN_freeze" [reduce32_ov, caddq_ov] true freeze_spec z3;

print "VERIFIED: reduce32, caddq, freeze == Cryptol models (the reduce.c layer)";

// --- non-vacuity, one mutant per spec above -------------------------------------------------
// Until now the only guard on this file was scripts/mutation_test.sh, which mutates
// montgomery_reduce and nothing else, so reduce32, caddq, freeze and both transforms had no
// witness that their obligations can fail at all. A result+1 mutant must be REJECTED for each.

let montgomery_reduce_mut_spec = do {
    a <- llvm_fresh_var "a" (llvm_int 64);
    llvm_precond {{ mont_in_range a }};
    llvm_execute_func [llvm_term a];
    llvm_return (llvm_term {{ montgomery_reduce a + 1 }});
};
fails (llvm_verify m "PQCLEAN_MLDSA44_CLEAN_montgomery_reduce" [] true montgomery_reduce_mut_spec z3);

let reduce32_mut_spec = do {
    a <- llvm_fresh_var "a" (llvm_int 32);
    llvm_precond {{ reduce32_in_range a }};
    llvm_execute_func [llvm_term a];
    llvm_return (llvm_term {{ reduce32 a + 1 }});
};
fails (llvm_verify m "PQCLEAN_MLDSA44_CLEAN_reduce32" [] true reduce32_mut_spec z3);

let caddq_mut_spec = do {
    a <- llvm_fresh_var "a" (llvm_int 32);
    llvm_execute_func [llvm_term a];
    llvm_return (llvm_term {{ caddq a + 1 }});
};
fails (llvm_verify m "PQCLEAN_MLDSA44_CLEAN_caddq" [] true caddq_mut_spec z3);

let freeze_mut_spec = do {
    a <- llvm_fresh_var "a" (llvm_int 32);
    llvm_precond {{ reduce32_in_range a }};
    llvm_execute_func [llvm_term a];
    llvm_return (llvm_term {{ freeze a + 1 }});
};
fails (llvm_verify m "PQCLEAN_MLDSA44_CLEAN_freeze" [reduce32_ov, caddq_ov] true freeze_mut_spec z3);

print "NON-VACUOUS: a result+1 mutant of each of montgomery_reduce, reduce32, caddq, freeze is rejected";

// --- forward NTT: C ntt(a[256]) ≡ Cryptol ntt, under two's-complement wrapping -------------
// The forward NTT does UNREDUCED int32 add/sub (a[j] ± t) that overflow int32 for unbounded inputs.
// Proving overflow-freedom needs coefficient-bound composition across the 8 levels (the hard v1.5
// task); here we prove FUNCTIONAL EQUIVALENCE under two's-complement wrapping, which is what the
// code computes and exactly matches the mod-2^n Cryptol model. We therefore load the `-fwrapv`
// bitcode (no nsw poison), so the equivalence holds for ALL inputs without a bound precondition.
// montgomery_reduce is passed as an override and kept UNINTERPRETED (w4_unint_z3) so the 1024
// butterfly calls collapse to a structural array equality instead of re-expanding the reduction.
mw <- llvm_load_module "../../build/mldsa_ntt_wrapv.bc";

// On the -fwrapv module, montgomery_reduce == model unconditionally (a - t*Q wraps, no UB).
let mont_reduce_uncond_spec = do {
    a <- llvm_fresh_var "a" (llvm_int 64);
    llvm_execute_func [llvm_term a];
    llvm_return (llvm_term {{ montgomery_reduce a }});
};
mr_ov_w <- llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_montgomery_reduce" [] true mont_reduce_uncond_spec z3;

let ptr_to_fresh nm ty = do {
    x <- llvm_fresh_var nm ty;
    p <- llvm_alloc ty;
    llvm_points_to p (llvm_term x);
    return (x, p);
};

let mont_reduce_uncond_mut_spec = do {
    a <- llvm_fresh_var "a" (llvm_int 64);
    llvm_execute_func [llvm_term a];
    llvm_return (llvm_term {{ montgomery_reduce a + 1 }});
};
fails (llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_montgomery_reduce" [] true mont_reduce_uncond_mut_spec z3);
print "NON-VACUOUS: the result+1 mutant of the unconditional montgomery_reduce spec is rejected";

let ntt_spec = do {
    (a, pa) <- ptr_to_fresh "a" (llvm_array 256 (llvm_int 32));
    llvm_execute_func [pa];
    llvm_points_to pa (llvm_term {{ ntt a }});
};

ntt_ov <- llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_ntt" [mr_ov_w] true ntt_spec
                      (w4_unint_z3 ["montgomery_reduce"]);

print "VERIFIED: PQCLEAN_MLDSA44_CLEAN_ntt == Cryptol ntt (two's-complement wrapping; montgomery_reduce override)";

// Non-vacuity for the forward transform: perturbing one output coefficient must be REJECTED.
// The override makes this a structural array equality, so a mutant is the only evidence the
// equality has content at all.
let ntt_mut_spec = do {
    (a, pa) <- ptr_to_fresh "a" (llvm_array 256 (llvm_int 32));
    llvm_execute_func [pa];
    llvm_points_to pa (llvm_term {{ update (ntt a) 0 ((ntt a) @ 0 + 1) }});
};
fails (llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_ntt" [mr_ov_w] true ntt_mut_spec
                   (w4_unint_z3 ["montgomery_reduce"]));
print "NON-VACUOUS: the result[0]+1 ntt spec is rejected with a counterexample";

// --- inverse NTT: C invntt_tomont(a[256]) ≡ Cryptol invntt, under two's-complement wrapping -----
// Same setup as the forward NTT. The Gentleman-Sande butterflies do unreduced int32 add/sub that wrap,
// so we use the -fwrapv module (equivalence for ALL inputs, no bound precondition). montgomery_reduce is
// the uninterpreted override, so both its call sites (the butterfly reduce and the final
// f = mont^2/256 scaling loop) collapse to a structural array equality against the Cryptol `invntt`.
let invntt_spec = do {
    (a, pa) <- ptr_to_fresh "a" (llvm_array 256 (llvm_int 32));
    llvm_execute_func [pa];
    llvm_points_to pa (llvm_term {{ invntt a }});
};

invntt_ov <- llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_invntt_tomont" [mr_ov_w] true invntt_spec
                       (w4_unint_z3 ["montgomery_reduce"]);

print "VERIFIED: PQCLEAN_MLDSA44_CLEAN_invntt_tomont == Cryptol invntt (two's-complement wrapping; montgomery_reduce override)";

let invntt_mut_spec = do {
    (a, pa) <- ptr_to_fresh "a" (llvm_array 256 (llvm_int 32));
    llvm_execute_func [pa];
    llvm_points_to pa (llvm_term {{ update (invntt a) 0 ((invntt a) @ 0 + 1) }});
};
fails (llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_invntt_tomont" [mr_ov_w] true invntt_mut_spec
                   (w4_unint_z3 ["montgomery_reduce"]));
print "NON-VACUOUS: the result[0]+1 invntt spec is rejected with a counterexample";

// --- poly_pointwise_montgomery: c[i] = montgomery_reduce(a[i]*b[i])  (ROADMAP v4, O7) ----------
// The operation the NTT exists to make cheap. With ntt/invntt_tomont already proven equivalent to
// the Cryptol model, this is the third leg of invntt_tomont(pointwise(ntt a, ntt b)) = a * b in
// Z_q[X]/(X^256+1). Same recipe as the transforms: -fwrapv module, montgomery_reduce as the proven
// uninterpreted override, so the obligation is the coefficientwise routing.
//
// SCOPE: llvm_alloc gives c, a and b disjoint allocations, so this is the non-aliasing case. The
// reference calls it with c aliasing a in places; that case is NOT covered here (ASSUMPTIONS).
let poly_to_fresh nm = do {
    p <- llvm_alloc (llvm_alias "struct.poly");
    x <- llvm_fresh_var nm (llvm_array 256 (llvm_int 32));
    llvm_points_to (llvm_field p "coeffs") (llvm_term x);
    return (x, p);
};

let pointwise_spec = do {
    (a, pa) <- poly_to_fresh "a";
    (b, pb) <- poly_to_fresh "b";
    pc <- llvm_alloc (llvm_alias "struct.poly");
    llvm_execute_func [pc, pa, pb];
    llvm_points_to (llvm_field pc "coeffs") (llvm_term {{ pointwise a b }});
    // inputs unchanged: an override that does not restate them is taken to clobber them, which
    // the vector loops (same a on every iteration) would trip over
    llvm_points_to (llvm_field pa "coeffs") (llvm_term a);
    llvm_points_to (llvm_field pb "coeffs") (llvm_term b);
};

pointwise_ov <- llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_poly_pointwise_montgomery" [mr_ov_w] true
                           pointwise_spec (w4_unint_z3 ["montgomery_reduce"]);
print "VERIFIED: PQCLEAN_MLDSA44_CLEAN_poly_pointwise_montgomery == Cryptol pointwise";

let pointwise_mut_spec = do {
    (a, pa) <- poly_to_fresh "a";
    (b, pb) <- poly_to_fresh "b";
    pc <- llvm_alloc (llvm_alias "struct.poly");
    llvm_execute_func [pc, pa, pb];
    llvm_points_to (llvm_field pc "coeffs")
                   (llvm_term {{ update (pointwise a b) 0 ((pointwise a b) @ 0 + 1) }});
};
fails (llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_poly_pointwise_montgomery" [mr_ov_w] true
                   pointwise_mut_spec (w4_unint_z3 ["montgomery_reduce"]));
print "NON-VACUOUS: the result[0]+1 pointwise spec is rejected with a counterexample";

// ---------------------------------------------------------------------------------------------
// v4, matrix-vector step: one row of A*y. polyvecl_pointwise_acc_montgomery (polyvec.c) computes
// w = u0*v0, then w = w + ui*vi for i = 1..3 via poly_add(w, w, &t); poly_reduce applies reduce32
// in place before invntt_tomont. All on the -fwrapv module, with proven overrides, so each
// obligation is routing. Models: padd, preduce, acc in model/cryptol/MLDSA_NTT.cry.

// poly_add exactly as the accumulator calls it: the output aliases the first summand.
let poly_add_alias_spec = do {
    (a, pa) <- poly_to_fresh "a";
    (b, pb) <- poly_to_fresh "b";
    llvm_execute_func [pa, pa, pb];
    llvm_points_to (llvm_field pa "coeffs") (llvm_term {{ padd a b }});
};
poly_add_alias_ov <- llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_poly_add" [] true poly_add_alias_spec z3;
print "VERIFIED: PQCLEAN_MLDSA44_CLEAN_poly_add (c aliasing a) == Cryptol padd";

let poly_add_alias_mut_spec = do {
    (a, pa) <- poly_to_fresh "a";
    (b, pb) <- poly_to_fresh "b";
    llvm_execute_func [pa, pa, pb];
    llvm_points_to (llvm_field pa "coeffs") (llvm_term {{ update (padd a b) 0 ((padd a b) @ 0 + 1) }});
};
fails (llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_poly_add" [] true poly_add_alias_mut_spec z3);
print "NON-VACUOUS: the result[0]+1 poly_add spec is rejected with a counterexample";

// reduce32 on the -fwrapv module, unconditionally: wrapping semantics is the model's mod-2^32.
let reduce32_uncond_spec = do {
    a <- llvm_fresh_var "a" (llvm_int 32);
    llvm_execute_func [llvm_term a];
    llvm_return (llvm_term {{ reduce32 a }});
};
r32_ov_w <- llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_reduce32" [] true reduce32_uncond_spec z3;
print "VERIFIED: PQCLEAN_MLDSA44_CLEAN_reduce32 == Cryptol reduce32 (-fwrapv, all inputs)";

let reduce32_uncond_mut_spec = do {
    a <- llvm_fresh_var "a" (llvm_int 32);
    llvm_execute_func [llvm_term a];
    llvm_return (llvm_term {{ reduce32 a + 1 }});
};
fails (llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_reduce32" [] true reduce32_uncond_mut_spec z3);
print "NON-VACUOUS: the result+1 reduce32 (-fwrapv) spec is rejected with a counterexample";

let poly_reduce_spec = do {
    (a, pa) <- poly_to_fresh "a";
    llvm_execute_func [pa];
    llvm_points_to (llvm_field pa "coeffs") (llvm_term {{ preduce a }});
};
poly_reduce_ov <- llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_poly_reduce" [r32_ov_w] true poly_reduce_spec
                              (w4_unint_z3 ["reduce32"]);
print "VERIFIED: PQCLEAN_MLDSA44_CLEAN_poly_reduce == Cryptol preduce";

let poly_reduce_mut_spec = do {
    (a, pa) <- poly_to_fresh "a";
    llvm_execute_func [pa];
    llvm_points_to (llvm_field pa "coeffs") (llvm_term {{ update (preduce a) 0 ((preduce a) @ 0 + 1) }});
};
fails (llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_poly_reduce" [r32_ov_w] true poly_reduce_mut_spec
                   (w4_unint_z3 ["reduce32"]));
print "NON-VACUOUS: the result[0]+1 poly_reduce spec is rejected with a counterexample";

let vec_at p i = llvm_elem (llvm_elem (llvm_field p "vec") i) 0;

let vec4_fresh alias nm = do {
    p <- llvm_alloc (llvm_alias alias);
    x <- llvm_fresh_var nm (llvm_array 4 (llvm_array 256 (llvm_int 32)));
    llvm_points_to (vec_at p 0) (llvm_term {{ x @ 0 }});
    llvm_points_to (vec_at p 1) (llvm_term {{ x @ 1 }});
    llvm_points_to (vec_at p 2) (llvm_term {{ x @ 2 }});
    llvm_points_to (vec_at p 3) (llvm_term {{ x @ 3 }});
    return (x, p);
};

let vec4_post p t = do {
    llvm_points_to (vec_at p 0) (llvm_term {{ t @ 0 }});
    llvm_points_to (vec_at p 1) (llvm_term {{ t @ 1 }});
    llvm_points_to (vec_at p 2) (llvm_term {{ t @ 2 }});
    llvm_points_to (vec_at p 3) (llvm_term {{ t @ 3 }});
};

// polyvecl with L = 4: each vec[i].coeffs points to row i of a fresh [4][256][32]. coeffs is
// addressed as field 0 of struct.poly (its only field): SAW cannot resolve a field name through
// an array element from the debug info.
let polyvecl_to_fresh nm = do {
    p <- llvm_alloc (llvm_alias "struct.polyvecl");
    // one fresh variable per row, so that when this spec is used as an override SAW can match each
    // row directly (a single [4][256][32] variable seen only through x @ i cannot be solved for)
    x0 <- llvm_fresh_var (str_concat nm "0") (llvm_array 256 (llvm_int 32));
    x1 <- llvm_fresh_var (str_concat nm "1") (llvm_array 256 (llvm_int 32));
    x2 <- llvm_fresh_var (str_concat nm "2") (llvm_array 256 (llvm_int 32));
    x3 <- llvm_fresh_var (str_concat nm "3") (llvm_array 256 (llvm_int 32));
    llvm_points_to (vec_at p 0) (llvm_term x0);
    llvm_points_to (vec_at p 1) (llvm_term x1);
    llvm_points_to (vec_at p 2) (llvm_term x2);
    llvm_points_to (vec_at p 3) (llvm_term x3);
    return ({{ [x0, x1, x2, x3] }}, p);
};

let acc_spec = do {
    (u, pu) <- polyvecl_to_fresh "u";
    (v, pv) <- polyvecl_to_fresh "v";
    pw <- llvm_alloc (llvm_alias "struct.poly");
    llvm_execute_func [pw, pu, pv];
    llvm_points_to (llvm_field pw "coeffs") (llvm_term {{ acc u v }});
    // inputs unchanged (the matrix loop passes the same v to every row)
    vec4_post pu u;
    vec4_post pv v;
};
acc_ov <- llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_polyvecl_pointwise_acc_montgomery"
            [pointwise_ov, poly_add_alias_ov] true acc_spec
            (w4_unint_z3 ["pointwise", "padd", "montgomery_reduce"]);
print "VERIFIED: PQCLEAN_MLDSA44_CLEAN_polyvecl_pointwise_acc_montgomery == Cryptol acc";

let acc_mut_spec = do {
    (u, pu) <- polyvecl_to_fresh "u";
    (v, pv) <- polyvecl_to_fresh "v";
    pw <- llvm_alloc (llvm_alias "struct.poly");
    llvm_execute_func [pw, pu, pv];
    llvm_points_to (llvm_field pw "coeffs") (llvm_term {{ update (acc u v) 0 ((acc u v) @ 0 + 1) }});
};
fails (llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_polyvecl_pointwise_acc_montgomery"
                   [pointwise_ov, poly_add_alias_ov] true acc_mut_spec
                   (w4_unint_z3 ["pointwise", "padd", "montgomery_reduce"]));
print "NON-VACUOUS: the result[0]+1 acc spec is rejected with a counterexample";

// ---------------------------------------------------------------------------------------------
// The wrapper and loop layer between sign.c and the functions above. Each is a fixed-count loop
// (or a one-line wrapper) over an already-proven function, verified with that function's spec as
// the override, so the obligation is that the loop applies it to every entry and nothing else.
// The vector-level models are Cryptol comprehensions over the lifted per-polynomial functions, so
// the per-polynomial Isabelle theorems apply entry by entry. Each spec takes a perturbation d
// added to coefficient 0 of entry 0: d = 0 is the claim, d = 1 is its mutant.

let bump1 t d = {{ update t 0 ((t @ 0) + d) }};
let bump4 t d = {{ update t 0 (update (t @ 0) 0 ((t @ 0) @ 0 + d)) }};

// poly_ntt / poly_invntt_tomont: call ntt / invntt_tomont on a->coeffs.
let poly_ntt_d d = do {
    (a, pa) <- poly_to_fresh "a";
    llvm_execute_func [pa];
    llvm_points_to (llvm_field pa "coeffs") (llvm_term (bump1 {{ ntt a }} d));
};
let poly_ntt_spec = poly_ntt_d {{ 0 : [32] }};
let poly_ntt_mut_spec = poly_ntt_d {{ 1 : [32] }};
poly_ntt_ov <- llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_poly_ntt" [ntt_ov] true poly_ntt_spec
                           (w4_unint_z3 ["ntt"]);
print "VERIFIED: PQCLEAN_MLDSA44_CLEAN_poly_ntt == Cryptol ntt";
fails (llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_poly_ntt" [ntt_ov] true poly_ntt_mut_spec (w4_unint_z3 ["ntt"]));
print "NON-VACUOUS: the result[0]+1 poly_ntt spec is rejected";

let poly_invntt_d d = do {
    (a, pa) <- poly_to_fresh "a";
    llvm_execute_func [pa];
    llvm_points_to (llvm_field pa "coeffs") (llvm_term (bump1 {{ invntt a }} d));
};
let poly_invntt_spec = poly_invntt_d {{ 0 : [32] }};
let poly_invntt_mut_spec = poly_invntt_d {{ 1 : [32] }};
poly_invntt_ov <- llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_poly_invntt_tomont" [invntt_ov] true poly_invntt_spec
                              (w4_unint_z3 ["invntt"]);
print "VERIFIED: PQCLEAN_MLDSA44_CLEAN_poly_invntt_tomont == Cryptol invntt";
fails (llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_poly_invntt_tomont" [invntt_ov] true poly_invntt_mut_spec
                   (w4_unint_z3 ["invntt"]));
print "NON-VACUOUS: the result[0]+1 poly_invntt_tomont spec is rejected";

// In-place vector maps: polyvecl_ntt, polyveck_ntt, polyvecl_invntt_tomont, polyveck_invntt_tomont,
// polyveck_reduce.
let vmap_d alias f d = do {
    (x, p) <- vec4_fresh alias "x";
    llvm_execute_func [p];
    vec4_post p (bump4 {{ [ f r | r <- x ] }} d);
};

let polyvecl_ntt_spec = vmap_d "struct.polyvecl" {{ ntt }} {{ 0 : [32] }};
let polyvecl_ntt_mut_spec = vmap_d "struct.polyvecl" {{ ntt }} {{ 1 : [32] }};
llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_polyvecl_ntt" [poly_ntt_ov] true polyvecl_ntt_spec (w4_unint_z3 ["ntt"]);
print "VERIFIED: PQCLEAN_MLDSA44_CLEAN_polyvecl_ntt == map ntt";
fails (llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_polyvecl_ntt" [poly_ntt_ov] true polyvecl_ntt_mut_spec (w4_unint_z3 ["ntt"]));
print "NON-VACUOUS: the perturbed polyvecl_ntt spec is rejected";

let polyveck_ntt_spec = vmap_d "struct.polyveck" {{ ntt }} {{ 0 : [32] }};
let polyveck_ntt_mut_spec = vmap_d "struct.polyveck" {{ ntt }} {{ 1 : [32] }};
llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_polyveck_ntt" [poly_ntt_ov] true polyveck_ntt_spec (w4_unint_z3 ["ntt"]);
print "VERIFIED: PQCLEAN_MLDSA44_CLEAN_polyveck_ntt == map ntt";
fails (llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_polyveck_ntt" [poly_ntt_ov] true polyveck_ntt_mut_spec (w4_unint_z3 ["ntt"]));
print "NON-VACUOUS: the perturbed polyveck_ntt spec is rejected";

let polyvecl_invntt_spec = vmap_d "struct.polyvecl" {{ invntt }} {{ 0 : [32] }};
let polyvecl_invntt_mut_spec = vmap_d "struct.polyvecl" {{ invntt }} {{ 1 : [32] }};
llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_polyvecl_invntt_tomont" [poly_invntt_ov] true polyvecl_invntt_spec (w4_unint_z3 ["invntt"]);
print "VERIFIED: PQCLEAN_MLDSA44_CLEAN_polyvecl_invntt_tomont == map invntt";
fails (llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_polyvecl_invntt_tomont" [poly_invntt_ov] true polyvecl_invntt_mut_spec (w4_unint_z3 ["invntt"]));
print "NON-VACUOUS: the perturbed polyvecl_invntt_tomont spec is rejected";

let polyveck_invntt_spec = vmap_d "struct.polyveck" {{ invntt }} {{ 0 : [32] }};
let polyveck_invntt_mut_spec = vmap_d "struct.polyveck" {{ invntt }} {{ 1 : [32] }};
llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_polyveck_invntt_tomont" [poly_invntt_ov] true polyveck_invntt_spec (w4_unint_z3 ["invntt"]);
print "VERIFIED: PQCLEAN_MLDSA44_CLEAN_polyveck_invntt_tomont == map invntt";
fails (llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_polyveck_invntt_tomont" [poly_invntt_ov] true polyveck_invntt_mut_spec (w4_unint_z3 ["invntt"]));
print "NON-VACUOUS: the perturbed polyveck_invntt_tomont spec is rejected";

let polyveck_reduce_spec = vmap_d "struct.polyveck" {{ preduce }} {{ 0 : [32] }};
let polyveck_reduce_mut_spec = vmap_d "struct.polyveck" {{ preduce }} {{ 1 : [32] }};
llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_polyveck_reduce" [poly_reduce_ov] true polyveck_reduce_spec (w4_unint_z3 ["preduce"]);
print "VERIFIED: PQCLEAN_MLDSA44_CLEAN_polyveck_reduce == map preduce";
fails (llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_polyveck_reduce" [poly_reduce_ov] true polyveck_reduce_mut_spec (w4_unint_z3 ["preduce"]));
print "NON-VACUOUS: the perturbed polyveck_reduce spec is rejected";

// c*s1, c*s2, c*t0 in the signer: polyvec{l,k}_pointwise_poly_montgomery(r, a, v) with r, a, v
// disjoint, as at those call sites. (Verification calls the k version with r aliasing v; that case
// is not covered, see A-POINTWISE.)
let vpw_d alias d = do {
    pr <- llvm_alloc (llvm_alias alias);
    (a, pa) <- poly_to_fresh "a";
    (v, pv) <- vec4_fresh alias "v";
    llvm_execute_func [pr, pa, pv];
    vec4_post pr (bump4 {{ [ pointwise a r | r <- v ] }} d);
};

let polyvecl_pwpoly_spec = vpw_d "struct.polyvecl" {{ 0 : [32] }};
let polyvecl_pwpoly_mut_spec = vpw_d "struct.polyvecl" {{ 1 : [32] }};
llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_polyvecl_pointwise_poly_montgomery" [pointwise_ov] true polyvecl_pwpoly_spec (w4_unint_z3 ["pointwise"]);
print "VERIFIED: PQCLEAN_MLDSA44_CLEAN_polyvecl_pointwise_poly_montgomery == map (pointwise a)";
fails (llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_polyvecl_pointwise_poly_montgomery" [pointwise_ov] true polyvecl_pwpoly_mut_spec (w4_unint_z3 ["pointwise"]));
print "NON-VACUOUS: the perturbed polyvecl_pointwise_poly_montgomery spec is rejected";

let polyveck_pwpoly_spec = vpw_d "struct.polyveck" {{ 0 : [32] }};
let polyveck_pwpoly_mut_spec = vpw_d "struct.polyveck" {{ 1 : [32] }};
llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_polyveck_pointwise_poly_montgomery" [pointwise_ov] true polyveck_pwpoly_spec (w4_unint_z3 ["pointwise"]);
print "VERIFIED: PQCLEAN_MLDSA44_CLEAN_polyveck_pointwise_poly_montgomery == map (pointwise a)";
fails (llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_polyveck_pointwise_poly_montgomery" [pointwise_ov] true polyveck_pwpoly_mut_spec (w4_unint_z3 ["pointwise"]));
print "NON-VACUOUS: the perturbed polyveck_pointwise_poly_montgomery spec is rejected";

// The matrix loop: t.vec[i] = acc(mat[i], v) for the K = 4 rows.
let matrix_d d = do {
    pm <- llvm_alloc (llvm_array 4 (llvm_alias "struct.polyvecl"));
    m <- llvm_fresh_var "m" (llvm_array 4 (llvm_array 4 (llvm_array 256 (llvm_int 32))));
    llvm_points_to (llvm_elem (llvm_elem (llvm_elem (llvm_elem pm 0) 0) 0) 0) (llvm_term {{ m @ 0 @ 0 }});
    llvm_points_to (llvm_elem (llvm_elem (llvm_elem (llvm_elem pm 0) 0) 1) 0) (llvm_term {{ m @ 0 @ 1 }});
    llvm_points_to (llvm_elem (llvm_elem (llvm_elem (llvm_elem pm 0) 0) 2) 0) (llvm_term {{ m @ 0 @ 2 }});
    llvm_points_to (llvm_elem (llvm_elem (llvm_elem (llvm_elem pm 0) 0) 3) 0) (llvm_term {{ m @ 0 @ 3 }});
    llvm_points_to (llvm_elem (llvm_elem (llvm_elem (llvm_elem pm 1) 0) 0) 0) (llvm_term {{ m @ 1 @ 0 }});
    llvm_points_to (llvm_elem (llvm_elem (llvm_elem (llvm_elem pm 1) 0) 1) 0) (llvm_term {{ m @ 1 @ 1 }});
    llvm_points_to (llvm_elem (llvm_elem (llvm_elem (llvm_elem pm 1) 0) 2) 0) (llvm_term {{ m @ 1 @ 2 }});
    llvm_points_to (llvm_elem (llvm_elem (llvm_elem (llvm_elem pm 1) 0) 3) 0) (llvm_term {{ m @ 1 @ 3 }});
    llvm_points_to (llvm_elem (llvm_elem (llvm_elem (llvm_elem pm 2) 0) 0) 0) (llvm_term {{ m @ 2 @ 0 }});
    llvm_points_to (llvm_elem (llvm_elem (llvm_elem (llvm_elem pm 2) 0) 1) 0) (llvm_term {{ m @ 2 @ 1 }});
    llvm_points_to (llvm_elem (llvm_elem (llvm_elem (llvm_elem pm 2) 0) 2) 0) (llvm_term {{ m @ 2 @ 2 }});
    llvm_points_to (llvm_elem (llvm_elem (llvm_elem (llvm_elem pm 2) 0) 3) 0) (llvm_term {{ m @ 2 @ 3 }});
    llvm_points_to (llvm_elem (llvm_elem (llvm_elem (llvm_elem pm 3) 0) 0) 0) (llvm_term {{ m @ 3 @ 0 }});
    llvm_points_to (llvm_elem (llvm_elem (llvm_elem (llvm_elem pm 3) 0) 1) 0) (llvm_term {{ m @ 3 @ 1 }});
    llvm_points_to (llvm_elem (llvm_elem (llvm_elem (llvm_elem pm 3) 0) 2) 0) (llvm_term {{ m @ 3 @ 2 }});
    llvm_points_to (llvm_elem (llvm_elem (llvm_elem (llvm_elem pm 3) 0) 3) 0) (llvm_term {{ m @ 3 @ 3 }});
    (v, pv) <- vec4_fresh "struct.polyvecl" "v";
    pt <- llvm_alloc (llvm_alias "struct.polyveck");
    llvm_execute_func [pt, pm, pv];
    vec4_post pt (bump4 {{ [ acc row v | row <- m ] }} d);
};
let matrix_spec = matrix_d {{ 0 : [32] }};
let matrix_mut_spec = matrix_d {{ 1 : [32] }};
llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_polyvec_matrix_pointwise_montgomery" [acc_ov] true matrix_spec (w4_unint_z3 ["acc"]);
print "VERIFIED: PQCLEAN_MLDSA44_CLEAN_polyvec_matrix_pointwise_montgomery == map (\\row -> acc row v)";
fails (llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_polyvec_matrix_pointwise_montgomery" [acc_ov] true matrix_mut_spec (w4_unint_z3 ["acc"]));
print "NON-VACUOUS: the perturbed polyvec_matrix_pointwise_montgomery spec is rejected";

// ---------------------------------------------------------------------------------------------
// Verification: w1 = invntt(reduce(A*z - c*(t1 << 13))). The new pieces are poly_shiftl, poly_sub
// in the form polyveck_sub(w1, w1, t1) uses (c == a), and poly_pointwise_montgomery in the form
// polyveck_pointwise_poly_montgomery(t1, cp, t1) uses (output aliasing the SECOND operand), plus
// the vector loops over them. Same pattern as above: per-polynomial specs proven, then used as
// overrides for the loops; each spec has a perturbed-postcondition mutant.

// poly_pointwise_montgomery with c == b.
let pointwise_alias_b_d d = do {
    (a, pa) <- poly_to_fresh "a";
    (b, pb) <- poly_to_fresh "b";
    llvm_execute_func [pb, pa, pb];
    llvm_points_to (llvm_field pb "coeffs") (llvm_term (bump1 {{ pointwise a b }} d));
    llvm_points_to (llvm_field pa "coeffs") (llvm_term a);
};
let pointwise_alias_b_spec = pointwise_alias_b_d {{ 0 : [32] }};
let pointwise_alias_b_mut_spec = pointwise_alias_b_d {{ 1 : [32] }};
pointwise_alias_b_ov <- llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_poly_pointwise_montgomery" [mr_ov_w] true
                                    pointwise_alias_b_spec (w4_unint_z3 ["montgomery_reduce"]);
print "VERIFIED: PQCLEAN_MLDSA44_CLEAN_poly_pointwise_montgomery (c aliasing b) == Cryptol pointwise";
fails (llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_poly_pointwise_montgomery" [mr_ov_w] true
                   pointwise_alias_b_mut_spec (w4_unint_z3 ["montgomery_reduce"]));
print "NON-VACUOUS: the perturbed pointwise (c aliasing b) spec is rejected";

// poly_sub with c == a.
let poly_sub_alias_d d = do {
    (a, pa) <- poly_to_fresh "a";
    (b, pb) <- poly_to_fresh "b";
    llvm_execute_func [pa, pa, pb];
    llvm_points_to (llvm_field pa "coeffs") (llvm_term (bump1 {{ psub a b }} d));
    llvm_points_to (llvm_field pb "coeffs") (llvm_term b);
};
let poly_sub_alias_spec = poly_sub_alias_d {{ 0 : [32] }};
let poly_sub_alias_mut_spec = poly_sub_alias_d {{ 1 : [32] }};
poly_sub_alias_ov <- llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_poly_sub" [] true poly_sub_alias_spec z3;
print "VERIFIED: PQCLEAN_MLDSA44_CLEAN_poly_sub (c aliasing a) == Cryptol psub";
fails (llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_poly_sub" [] true poly_sub_alias_mut_spec z3);
print "NON-VACUOUS: the perturbed poly_sub spec is rejected";

// poly_shiftl, in place.
let poly_shiftl_d d = do {
    (a, pa) <- poly_to_fresh "a";
    llvm_execute_func [pa];
    llvm_points_to (llvm_field pa "coeffs") (llvm_term (bump1 {{ pshiftl a }} d));
};
let poly_shiftl_spec = poly_shiftl_d {{ 0 : [32] }};
let poly_shiftl_mut_spec = poly_shiftl_d {{ 1 : [32] }};
poly_shiftl_ov <- llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_poly_shiftl" [] true poly_shiftl_spec z3;
print "VERIFIED: PQCLEAN_MLDSA44_CLEAN_poly_shiftl == Cryptol pshiftl";
fails (llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_poly_shiftl" [] true poly_shiftl_mut_spec z3);
print "NON-VACUOUS: the perturbed poly_shiftl spec is rejected";

// polyveck_shiftl(t1), in place.
let polyveck_shiftl_spec = vmap_d "struct.polyveck" {{ pshiftl }} {{ 0 : [32] }};
let polyveck_shiftl_mut_spec = vmap_d "struct.polyveck" {{ pshiftl }} {{ 1 : [32] }};
llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_polyveck_shiftl" [poly_shiftl_ov] true polyveck_shiftl_spec (w4_unint_z3 ["pshiftl"]);
print "VERIFIED: PQCLEAN_MLDSA44_CLEAN_polyveck_shiftl == map pshiftl";
fails (llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_polyveck_shiftl" [poly_shiftl_ov] true polyveck_shiftl_mut_spec (w4_unint_z3 ["pshiftl"]));
print "NON-VACUOUS: the perturbed polyveck_shiftl spec is rejected";

// polyveck_sub(w1, w1, t1): output aliases the first operand vector.
let vsub_alias_d d = do {
    (u, pu) <- vec4_fresh "struct.polyveck" "u";
    (v, pv) <- vec4_fresh "struct.polyveck" "v";
    llvm_execute_func [pu, pu, pv];
    vec4_post pu (bump4 {{ [ psub x y | x <- u | y <- v ] }} d);
    vec4_post pv v;
};
let polyveck_sub_alias_spec = vsub_alias_d {{ 0 : [32] }};
let polyveck_sub_alias_mut_spec = vsub_alias_d {{ 1 : [32] }};
llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_polyveck_sub" [poly_sub_alias_ov] true polyveck_sub_alias_spec (w4_unint_z3 ["psub"]);
print "VERIFIED: PQCLEAN_MLDSA44_CLEAN_polyveck_sub (w aliasing u) == zipWith psub";
fails (llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_polyveck_sub" [poly_sub_alias_ov] true polyveck_sub_alias_mut_spec (w4_unint_z3 ["psub"]));
print "NON-VACUOUS: the perturbed polyveck_sub spec is rejected";

// polyveck_pointwise_poly_montgomery(t1, cp, t1): output aliases the vector operand.
let vpw_alias_d d = do {
    (a, pa) <- poly_to_fresh "a";
    (v, pv) <- vec4_fresh "struct.polyveck" "v";
    llvm_execute_func [pv, pa, pv];
    vec4_post pv (bump4 {{ [ pointwise a r | r <- v ] }} d);
};
let polyveck_pwpoly_alias_spec = vpw_alias_d {{ 0 : [32] }};
let polyveck_pwpoly_alias_mut_spec = vpw_alias_d {{ 1 : [32] }};
llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_polyveck_pointwise_poly_montgomery" [pointwise_alias_b_ov] true polyveck_pwpoly_alias_spec (w4_unint_z3 ["pointwise"]);
print "VERIFIED: PQCLEAN_MLDSA44_CLEAN_polyveck_pointwise_poly_montgomery (r aliasing v) == map (pointwise a)";
fails (llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_polyveck_pointwise_poly_montgomery" [pointwise_alias_b_ov] true polyveck_pwpoly_alias_mut_spec (w4_unint_z3 ["pointwise"]));
print "NON-VACUOUS: the perturbed polyveck_pointwise_poly_montgomery (aliased) spec is rejected";
