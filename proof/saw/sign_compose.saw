// SAW proof: sign.c's key generation, signing and verification compose the proven functions the
// way model/cryptol/MLDSA_Sign.cry says.
//
// crypto_sign_keypair, crypto_sign_signature and crypto_sign_verify (the ctx = NULL, ctxlen = 0
// entry points) are symbolically executed with every callee replaced by a spec:
//   - the arithmetic on the product paths uses specs proven here or in mldsa_ntt.saw (included
//     below): ntt, the matrix-vector product, shiftl, pointwise, add, sub, reduce, invntt, caddq;
//   - everything else (unpacking, packing, the norm checks, SHAKE256, randombytes, the samplers,
//     matrix expansion, power2round, decompose, make_hint, use_hint, pack_w1) uses an ASSUMED spec
//     whose outputs are opaque Cryptol functions of its inputs, kept uninterpreted. Each assumed
//     spec is listed in docs/ASSUMPTIONS.md (A-SIGN).
// So the obligation is that the C calls these functions in this order, on these buffers, with this
// aliasing, and returns what the composition returns. It holds for every interpretation of the
// opaque functions, which is why none of their bodies matter.
//
// SCOPE: message length fixed at 32 bytes (the absorb spec for the message is per length). Signing
// is proved for the schedules listed in its section (pass 0 accepted; pass 0 rejected at each of
// the four checks and pass 1 accepted), not for every number of passes.

include "mldsa_ntt.saw";
import "../../model/cryptol/MLDSA_Sign.cry";

let bytes_ro nm n = do {
    p <- llvm_alloc_readonly (llvm_array n (llvm_int 8));
    x <- llvm_fresh_var nm (llvm_array n (llvm_int 8));
    llvm_points_to p (llvm_term x);
    return (x, p);
};
let bytes_rw nm n = do {
    p <- llvm_alloc (llvm_array n (llvm_int 8));
    x <- llvm_fresh_var nm (llvm_array n (llvm_int 8));
    llvm_points_to p (llvm_term x);
    return (x, p);
};

// A polyvec{l,k} with one fresh variable per row: a spec used as an override can only bind a fresh
// variable that appears on its own in a points-to, not one seen through x @ i.
let vrow p i = llvm_elem (llvm_elem (llvm_field p "vec") i) 0;
let vec_rows_at p nm = do {
    x0 <- llvm_fresh_var (str_concat nm "0") (llvm_array 256 (llvm_int 32));
    x1 <- llvm_fresh_var (str_concat nm "1") (llvm_array 256 (llvm_int 32));
    x2 <- llvm_fresh_var (str_concat nm "2") (llvm_array 256 (llvm_int 32));
    x3 <- llvm_fresh_var (str_concat nm "3") (llvm_array 256 (llvm_int 32));
    llvm_points_to (vrow p 0) (llvm_term x0);
    llvm_points_to (vrow p 1) (llvm_term x1);
    llvm_points_to (vrow p 2) (llvm_term x2);
    llvm_points_to (vrow p 3) (llvm_term x3);
    return {{ [x0, x1, x2, x3] }};
};
let vec_rows alias nm = do {
    p <- llvm_alloc (llvm_alias alias);
    x <- vec_rows_at p nm;
    return (x, p);
};
let vec_post p t = do {
    llvm_points_to (vrow p 0) (llvm_term {{ t @ 0 }});
    llvm_points_to (vrow p 1) (llvm_term {{ t @ 1 }});
    llvm_points_to (vrow p 2) (llvm_term {{ t @ 2 }});
    llvm_points_to (vrow p 3) (llvm_term {{ t @ 3 }});
};
let mrow pm i j = llvm_elem (llvm_elem (llvm_elem (llvm_elem pm i) 0) j) 0;
let mat_fresh = do {
    pm <- llvm_alloc (llvm_array 4 (llvm_alias "struct.polyvecl"));
    m00 <- llvm_fresh_var "m00" (llvm_array 256 (llvm_int 32));
    llvm_points_to (mrow pm 0 0) (llvm_term m00);
    m01 <- llvm_fresh_var "m01" (llvm_array 256 (llvm_int 32));
    llvm_points_to (mrow pm 0 1) (llvm_term m01);
    m02 <- llvm_fresh_var "m02" (llvm_array 256 (llvm_int 32));
    llvm_points_to (mrow pm 0 2) (llvm_term m02);
    m03 <- llvm_fresh_var "m03" (llvm_array 256 (llvm_int 32));
    llvm_points_to (mrow pm 0 3) (llvm_term m03);
    m10 <- llvm_fresh_var "m10" (llvm_array 256 (llvm_int 32));
    llvm_points_to (mrow pm 1 0) (llvm_term m10);
    m11 <- llvm_fresh_var "m11" (llvm_array 256 (llvm_int 32));
    llvm_points_to (mrow pm 1 1) (llvm_term m11);
    m12 <- llvm_fresh_var "m12" (llvm_array 256 (llvm_int 32));
    llvm_points_to (mrow pm 1 2) (llvm_term m12);
    m13 <- llvm_fresh_var "m13" (llvm_array 256 (llvm_int 32));
    llvm_points_to (mrow pm 1 3) (llvm_term m13);
    m20 <- llvm_fresh_var "m20" (llvm_array 256 (llvm_int 32));
    llvm_points_to (mrow pm 2 0) (llvm_term m20);
    m21 <- llvm_fresh_var "m21" (llvm_array 256 (llvm_int 32));
    llvm_points_to (mrow pm 2 1) (llvm_term m21);
    m22 <- llvm_fresh_var "m22" (llvm_array 256 (llvm_int 32));
    llvm_points_to (mrow pm 2 2) (llvm_term m22);
    m23 <- llvm_fresh_var "m23" (llvm_array 256 (llvm_int 32));
    llvm_points_to (mrow pm 2 3) (llvm_term m23);
    m30 <- llvm_fresh_var "m30" (llvm_array 256 (llvm_int 32));
    llvm_points_to (mrow pm 3 0) (llvm_term m30);
    m31 <- llvm_fresh_var "m31" (llvm_array 256 (llvm_int 32));
    llvm_points_to (mrow pm 3 1) (llvm_term m31);
    m32 <- llvm_fresh_var "m32" (llvm_array 256 (llvm_int 32));
    llvm_points_to (mrow pm 3 2) (llvm_term m32);
    m33 <- llvm_fresh_var "m33" (llvm_array 256 (llvm_int 32));
    llvm_points_to (mrow pm 3 3) (llvm_term m33);
    return ({{ [[m00, m01, m02, m03], [m10, m11, m12, m13], [m20, m21, m22, m23], [m30, m31, m32, m33]] }}, pm);
};
let mat_post pm t = do {
    llvm_points_to (mrow pm 0 0) (llvm_term {{ t @ 0 @ 0 }});
    llvm_points_to (mrow pm 0 1) (llvm_term {{ t @ 0 @ 1 }});
    llvm_points_to (mrow pm 0 2) (llvm_term {{ t @ 0 @ 2 }});
    llvm_points_to (mrow pm 0 3) (llvm_term {{ t @ 0 @ 3 }});
    llvm_points_to (mrow pm 1 0) (llvm_term {{ t @ 1 @ 0 }});
    llvm_points_to (mrow pm 1 1) (llvm_term {{ t @ 1 @ 1 }});
    llvm_points_to (mrow pm 1 2) (llvm_term {{ t @ 1 @ 2 }});
    llvm_points_to (mrow pm 1 3) (llvm_term {{ t @ 1 @ 3 }});
    llvm_points_to (mrow pm 2 0) (llvm_term {{ t @ 2 @ 0 }});
    llvm_points_to (mrow pm 2 1) (llvm_term {{ t @ 2 @ 1 }});
    llvm_points_to (mrow pm 2 2) (llvm_term {{ t @ 2 @ 2 }});
    llvm_points_to (mrow pm 2 3) (llvm_term {{ t @ 2 @ 3 }});
    llvm_points_to (mrow pm 3 0) (llvm_term {{ t @ 3 @ 0 }});
    llvm_points_to (mrow pm 3 1) (llvm_term {{ t @ 3 @ 1 }});
    llvm_points_to (mrow pm 3 2) (llvm_term {{ t @ 3 @ 2 }});
    llvm_points_to (mrow pm 3 3) (llvm_term {{ t @ 3 @ 3 }});
};

// ---------------------------------------------------------------------------------------------
// Proven: the vector-level functions on the verification path, restated with per-row variables
// so they can serve as overrides. Each uses the per-polynomial spec proven in mldsa_ntt.saw, and
// each has a mutant (coefficient 0 of row 0 bumped by one).
let bumpv t d = {{ update t 0 (update (t @ 0) 0 ((t @ 0) @ 0 + d)) }};

let vmap_rows_d alias f d = do {
    (x, p) <- vec_rows alias "x";
    llvm_execute_func [p];
    vec_post p (bumpv {{ [ f r | r <- x ] }} d);
};
let check_vmap fn alias f ovs unint = do {
    ov <- llvm_verify mw fn ovs true (vmap_rows_d alias f {{ 0 : [32] }}) (w4_unint_z3 unint);
    fails (llvm_verify mw fn ovs true (vmap_rows_d alias f {{ 1 : [32] }}) (w4_unint_z3 unint));
    return ov;
};

// caddq on the -fwrapv module (mldsa_ntt.saw proves it on the default one), then poly_caddq and
// polyveck_caddq over it.
let caddq_w_d d = do {
    a <- llvm_fresh_var "a" (llvm_int 32);
    llvm_execute_func [llvm_term a];
    llvm_return (llvm_term {{ caddq a + d }});
};
caddq_ov_w <- llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_caddq" [] true (caddq_w_d {{ 0 : [32] }}) z3;
fails (llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_caddq" [] true (caddq_w_d {{ 1 : [32] }}) z3);
let poly_caddq_d d = do {
    (a, pa) <- poly_to_fresh "a";
    llvm_execute_func [pa];
    llvm_points_to (llvm_field pa "coeffs") (llvm_term (bump1 {{ pcaddq a }} d));
};
poly_caddq_ov <- llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_poly_caddq" [caddq_ov_w] true (poly_caddq_d {{ 0 : [32] }}) (w4_unint_z3 ["caddq"]);
fails (llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_poly_caddq" [caddq_ov_w] true (poly_caddq_d {{ 1 : [32] }}) (w4_unint_z3 ["caddq"]));
print "VERIFIED: PQCLEAN_MLDSA44_CLEAN_poly_caddq == pcaddq (mutant rejected)";

polyveck_caddq_r <- check_vmap "PQCLEAN_MLDSA44_CLEAN_polyveck_caddq" "struct.polyveck" {{ pcaddq }} [poly_caddq_ov] ["pcaddq"];
polyvecl_ntt_r    <- check_vmap "PQCLEAN_MLDSA44_CLEAN_polyvecl_ntt" "struct.polyvecl" {{ ntt }} [poly_ntt_ov] ["ntt"];
polyveck_ntt_r    <- check_vmap "PQCLEAN_MLDSA44_CLEAN_polyveck_ntt" "struct.polyveck" {{ ntt }} [poly_ntt_ov] ["ntt"];
polyveck_invntt_r <- check_vmap "PQCLEAN_MLDSA44_CLEAN_polyveck_invntt_tomont" "struct.polyveck" {{ invntt }} [poly_invntt_ov] ["invntt"];
polyveck_reduce_r <- check_vmap "PQCLEAN_MLDSA44_CLEAN_polyveck_reduce" "struct.polyveck" {{ preduce }} [poly_reduce_ov] ["preduce"];
polyveck_shiftl_r <- check_vmap "PQCLEAN_MLDSA44_CLEAN_polyveck_shiftl" "struct.polyveck" {{ pshiftl }} [poly_shiftl_ov] ["pshiftl"];
print "VERIFIED: per-row polyveck_caddq, polyvecl_ntt, polyveck_ntt, polyveck_invntt_tomont, polyveck_reduce, polyveck_shiftl (each mutant rejected)";


// polyveck_sub(w1, w1, t1): output aliases the first operand.
let vsub_rows_d d = do {
    (u, pu) <- vec_rows "struct.polyveck" "u";
    (v, pv) <- vec_rows "struct.polyveck" "v";
    llvm_execute_func [pu, pu, pv];
    vec_post pu (bumpv {{ [ psub x y | x <- u | y <- v ] }} d);
    vec_post pv v;
};
polyveck_sub_r <- llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_polyveck_sub" [poly_sub_alias_ov] true (vsub_rows_d {{ 0 : [32] }}) (w4_unint_z3 ["psub"]);
fails (llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_polyveck_sub" [poly_sub_alias_ov] true (vsub_rows_d {{ 1 : [32] }}) (w4_unint_z3 ["psub"]));

// polyveck_pointwise_poly_montgomery(t1, cp, t1): output aliases the vector operand.
let vpw_rows_d d = do {
    (a, pa) <- poly_to_fresh "a";
    (v, pv) <- vec_rows "struct.polyveck" "v";
    llvm_execute_func [pv, pa, pv];
    vec_post pv (bumpv {{ [ pointwise a r | r <- v ] }} d);
    llvm_points_to (llvm_field pa "coeffs") (llvm_term a);
};
polyveck_pwpoly_r <- llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_polyveck_pointwise_poly_montgomery" [pointwise_alias_b_ov] true (vpw_rows_d {{ 0 : [32] }}) (w4_unint_z3 ["pointwise"]);
fails (llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_polyveck_pointwise_poly_montgomery" [pointwise_alias_b_ov] true (vpw_rows_d {{ 1 : [32] }}) (w4_unint_z3 ["pointwise"]));

// polyvec_matrix_pointwise_montgomery(w1, mat, z): w1[i] = acc(mat[i], z); mat and z unchanged.
let matrix_rows_d d = do {
    (a, pm) <- mat_fresh;
    (v, pv) <- vec_rows "struct.polyvecl" "v";
    pt <- llvm_alloc (llvm_alias "struct.polyveck");
    llvm_execute_func [pt, pm, pv];
    vec_post pt (bumpv {{ [ acc row v | row <- a ] }} d);
    mat_post pm a;
    vec_post pv v;
};
matrix_r <- llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_polyvec_matrix_pointwise_montgomery" [acc_ov] true (matrix_rows_d {{ 0 : [32] }}) (w4_unint_z3 ["acc"]);
fails (llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_polyvec_matrix_pointwise_montgomery" [acc_ov] true (matrix_rows_d {{ 1 : [32] }}) (w4_unint_z3 ["acc"]));
print "VERIFIED: per-row polyveck_sub (aliased), polyveck_pointwise_poly_montgomery (aliased), polyvec_matrix_pointwise_montgomery (each mutant rejected)";

// ---------------------------------------------------------------------------------------------
// ASSUMED (docs/ASSUMPTIONS.md, A-SIGN): the callees no proof here covers. Each writes exactly the
// outputs listed, as an opaque function of its inputs, and leaves its const inputs unchanged.

let unpack_pk_spec = do {
    prho <- llvm_alloc (llvm_array 32 (llvm_int 8));
    pt1 <- llvm_alloc (llvm_alias "struct.polyveck");
    (pk, ppk) <- bytes_ro "pk" 1312;
    llvm_execute_func [prho, pt1, ppk];
    llvm_points_to prho (llvm_term {{ pkRho pk }});
    vec_post pt1 {{ pkT1 pk }};
};
unpack_pk_ov <- llvm_unsafe_assume_spec mw "PQCLEAN_MLDSA44_CLEAN_unpack_pk" unpack_pk_spec;

let unpack_sig_spec = do {
    pc <- llvm_alloc (llvm_array 32 (llvm_int 8));
    pz <- llvm_alloc (llvm_alias "struct.polyvecl");
    ph <- llvm_alloc (llvm_alias "struct.polyveck");
    (sg, psg) <- bytes_ro "sig" 2420;
    llvm_execute_func [pc, pz, ph, psg];
    llvm_points_to pc (llvm_term {{ sigC sg }});
    vec_post pz {{ sigZ sg }};
    vec_post ph {{ sigH sg }};
    llvm_return (llvm_term {{ sigBad sg }});
};
unpack_sig_ov <- llvm_unsafe_assume_spec mw "PQCLEAN_MLDSA44_CLEAN_unpack_sig" unpack_sig_spec;

let chknorm_z_spec = do {
    (z, pz) <- vec_rows "struct.polyvecl" "z";
    llvm_execute_func [pz, llvm_term {{ 130994 : [32] }}];   // GAMMA1 - BETA
    vec_post pz z;
    llvm_return (llvm_term {{ if chkZ z then 1 else 0 : [32] }});
};
chknorm_ov <- llvm_unsafe_assume_spec mw "PQCLEAN_MLDSA44_CLEAN_polyvecl_chknorm" chknorm_z_spec;

let shake256_tr_spec = do {
    pout <- llvm_alloc (llvm_array 64 (llvm_int 8));
    (pk, ppk) <- bytes_ro "pk" 1312;
    llvm_execute_func [pout, llvm_term {{ 64 : [64] }}, ppk, llvm_term {{ 1312 : [64] }}];
    llvm_points_to pout (llvm_term {{ shakeTr pk }});
};
shake256_ov <- llvm_unsafe_assume_spec mw "shake256" shake256_tr_spec;

// shake256incctx is { uint64_t *ctx; }; fips202.c allocates ctx in init. The state is the 26 words.
let st_type = llvm_array 26 (llvm_int 64);
let inc_state = do {
    pst <- llvm_alloc (llvm_alias "struct.shake256incctx");
    pc <- llvm_alloc st_type;
    s <- llvm_fresh_var "s" st_type;
    llvm_points_to (llvm_field pst "ctx") pc;
    llvm_points_to pc (llvm_term s);
    return (s, pst, pc);
};
let inc_init_spec = do {
    pst <- llvm_alloc (llvm_alias "struct.shake256incctx");
    llvm_execute_func [pst];
    pc <- llvm_alloc st_type;
    llvm_points_to (llvm_field pst "ctx") pc;
    llvm_points_to pc (llvm_term {{ incInit }});
};
inc_init_ov <- llvm_unsafe_assume_spec mw "shake256_inc_init" inc_init_spec;

let absorb_spec n f = do {
    (s, pst, pc) <- inc_state;
    (x, px) <- bytes_ro "in" n;   // const input: a read-only allocation matches either kind
    llvm_execute_func [pst, px, llvm_term {{ `n : [64] }}];
    llvm_points_to (llvm_field pst "ctx") pc;
    llvm_points_to pc (llvm_term {{ f s x }});
};
absorb64_ov  <- llvm_unsafe_assume_spec mw "shake256_inc_absorb" (absorb_spec 64 {{ absorb64 }});
absorb2_ov   <- llvm_unsafe_assume_spec mw "shake256_inc_absorb" (absorb_spec 2 {{ absorb2 }});
absorbM_ov   <- llvm_unsafe_assume_spec mw "shake256_inc_absorb" (absorb_spec 32 {{ absorbM }});
absorb768_ov <- llvm_unsafe_assume_spec mw "shake256_inc_absorb" (absorb_spec 768 {{ absorb768 }});
let absorb0_spec = do {
    (s, pst, pc) <- inc_state;
    llvm_execute_func [pst, llvm_null, llvm_term {{ 0 : [64] }}];
    llvm_points_to (llvm_field pst "ctx") pc;
    llvm_points_to pc (llvm_term {{ absorb0 s }});
};
absorb0_ov <- llvm_unsafe_assume_spec mw "shake256_inc_absorb" absorb0_spec;

let finalize_spec = do {
    (s, pst, pc) <- inc_state;
    llvm_execute_func [pst];
    llvm_points_to (llvm_field pst "ctx") pc;
    llvm_points_to pc (llvm_term {{ finalize s }});
};
finalize_ov <- llvm_unsafe_assume_spec mw "shake256_inc_finalize" finalize_spec;

let squeeze_spec n f = do {
    pout <- llvm_alloc (llvm_array n (llvm_int 8));
    (s, pst, pc) <- inc_state;
    llvm_execute_func [pout, llvm_term {{ `n : [64] }}, pst];
    llvm_points_to pout (llvm_term {{ f s }});
    llvm_points_to (llvm_field pst "ctx") pc;
    llvm_points_to pc (llvm_term {{ squeezeSt s }});
};
squeeze64_ov <- llvm_unsafe_assume_spec mw "shake256_inc_squeeze" (squeeze_spec 64 {{ squeeze64 }});
squeeze32_ov <- llvm_unsafe_assume_spec mw "shake256_inc_squeeze" (squeeze_spec 32 {{ squeeze32 }});

let release_spec = do {
    (s, pst, pc) <- inc_state;
    llvm_execute_func [pst];
};
release_ov <- llvm_unsafe_assume_spec mw "shake256_inc_ctx_release" release_spec;

let challenge_spec = do {
    pcp <- llvm_alloc (llvm_alias "struct.poly");
    (c, pc) <- bytes_rw "c" 32;
    llvm_execute_func [pcp, pc];
    llvm_points_to (llvm_field pcp "coeffs") (llvm_term {{ challenge c }});
    llvm_points_to pc (llvm_term c);
};
challenge_ov <- llvm_unsafe_assume_spec mw "PQCLEAN_MLDSA44_CLEAN_poly_challenge" challenge_spec;

let expand_spec = do {
    pm <- llvm_alloc (llvm_array 4 (llvm_alias "struct.polyvecl"));
    (rho, prho) <- bytes_rw "rho" 32;
    llvm_execute_func [pm, prho];
    mat_post pm {{ expandA rho }};
    llvm_points_to prho (llvm_term rho);
};
expand_ov <- llvm_unsafe_assume_spec mw "PQCLEAN_MLDSA44_CLEAN_polyvec_matrix_expand" expand_spec;

// polyveck_use_hint(w1, w1, h): output aliases the input.
let use_hint_spec = do {
    (u, pu) <- vec_rows "struct.polyveck" "u";
    (h, ph) <- vec_rows "struct.polyveck" "h";
    llvm_execute_func [pu, pu, ph];
    vec_post pu {{ useHint u h }};
    vec_post ph h;
};
use_hint_ov <- llvm_unsafe_assume_spec mw "PQCLEAN_MLDSA44_CLEAN_polyveck_use_hint" use_hint_spec;

let pack_w1_spec = do {
    pr <- llvm_alloc (llvm_array 768 (llvm_int 8));
    (w, pw) <- vec_rows "struct.polyveck" "w";
    llvm_execute_func [pr, pw];
    llvm_points_to pr (llvm_term {{ packW1 w }});
    vec_post pw w;
};
pack_w1_ov <- llvm_unsafe_assume_spec mw "PQCLEAN_MLDSA44_CLEAN_polyveck_pack_w1" pack_w1_spec;

// ---------------------------------------------------------------------------------------------
// The composition. f is the model the return value must equal: MLDSA_Sign::verify for the claim,
// a perturbed composition for each mutant.
let verify_spec f = do {
    (sg, psg) <- bytes_ro "sig" 2420;
    (msg, pm) <- bytes_ro "m" 32;
    (pk, ppk) <- bytes_ro "pk" 1312;
    llvm_execute_func [psg, llvm_term {{ 2420 : [64] }}, pm, llvm_term {{ 32 : [64] }}, ppk];
    llvm_return (llvm_term {{ f sg msg pk }});
};
let verify_ovs = [unpack_pk_ov, unpack_sig_ov, chknorm_ov, shake256_ov, inc_init_ov,
                  absorb64_ov, absorb2_ov, absorbM_ov, absorb768_ov, absorb0_ov, finalize_ov,
                  squeeze64_ov, squeeze32_ov, release_ov, challenge_ov, expand_ov,
                  use_hint_ov, pack_w1_ov,
                  polyvecl_ntt_r, matrix_r, poly_ntt_ov, polyveck_shiftl_r, polyveck_ntt_r,
                  polyveck_pwpoly_r, polyveck_sub_r, polyveck_reduce_r, polyveck_invntt_r,
                  polyveck_caddq_r];
let opaque = ["pkRho", "pkT1", "sigC", "sigZ", "sigH", "sigBad", "chkZ", "expandA", "challenge",
              "useHint", "packW1", "shakeTr", "absorb64", "absorb2", "absorb0",
              "absorbM", "absorb768", "finalize", "squeeze64", "squeeze32", "squeezeSt",
              "ntt", "invntt", "acc", "pointwise", "psub", "preduce", "pshiftl", "pcaddq"];

llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_crypto_sign_verify" verify_ovs false
            (verify_spec {{ verify }}) (w4_unint_z3 opaque);
print "VERIFIED: crypto_sign_verify returns MLDSA_Sign::verify (composition of the proven arithmetic and the assumed steps)";

import "MLDSA_Sign_Mutants.cry";
fails (llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_crypto_sign_verify" verify_ovs false
                   (verify_spec {{ verify_noshift }}) (w4_unint_z3 opaque));
fails (llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_crypto_sign_verify" verify_ovs false
                   (verify_spec {{ verify_swapsub }}) (w4_unint_z3 opaque));
fails (llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_crypto_sign_verify" verify_ovs false
                   (verify_spec {{ verify_zplain }}) (w4_unint_z3 opaque));
fails (llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_crypto_sign_verify" verify_ovs false
                   (verify_spec {{ verify_nocaddq }}) (w4_unint_z3 opaque));
fails (llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_crypto_sign_verify" verify_ovs false
                   (verify_spec {{ verify_nochk }}) (w4_unint_z3 opaque));
fails (llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_crypto_sign_verify" verify_ovs false
                   (verify_spec {{ verify_nomsg }}) (w4_unint_z3 opaque));
fails (llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_crypto_sign_verify" verify_ovs false
                   (verify_spec {{ verify_nobad }}) (w4_unint_z3 opaque));
print "NON-VACUOUS: compositions without the shift, with the subtraction swapped, with z not transformed, without caddq, without the z norm check, without the message absorbed, or without the unpack_sig check are rejected";

// =============================================================================================
// Key generation: crypto_sign_keypair returns MLDSA_Sign::keypair.

// polyveck_add(t1, t1, s2): output aliases the first operand. Proven, over poly_add (c == a).
let vadd_rows_d d = do {
    (u, pu) <- vec_rows "struct.polyveck" "u";
    (v, pv) <- vec_rows "struct.polyveck" "v";
    llvm_execute_func [pu, pu, pv];
    vec_post pu (bumpv {{ [ padd x y | x <- u | y <- v ] }} d);
    vec_post pv v;
};
polyveck_add_r <- llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_polyveck_add" [poly_add_alias_ov] true (vadd_rows_d {{ 0 : [32] }}) (w4_unint_z3 ["padd"]);
fails (llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_polyveck_add" [poly_add_alias_ov] true (vadd_rows_d {{ 1 : [32] }}) (w4_unint_z3 ["padd"]));
print "VERIFIED: per-row polyveck_add (aliased) == zipWith padd (mutant rejected)";

// ASSUMED (A-SIGN), as for verification.
// randombytes: returns the bytes held in ghost state `rng`, which the keypair spec binds as its
// input. (No input at all would leave every term closed; see MLDSA_Sign.cry.)
rng <- declare_ghost_state "rng";
let randombytes_spec = do {
    r <- llvm_fresh_var "r" (llvm_array 32 (llvm_int 8));
    llvm_ghost_value rng r;
    p <- llvm_alloc (llvm_array 32 (llvm_int 8));
    llvm_execute_func [p, llvm_term {{ 32 : [64] }}];
    llvm_ghost_value rng r;
    llvm_points_to p (llvm_term r);
    llvm_return (llvm_term {{ 0 : [32] }});
};
randombytes_ov <- llvm_unsafe_assume_spec mw "PQCLEAN_randombytes" randombytes_spec;

// shake256(seedbuf, 128, seedbuf, 34): output over its own input.
let shake256_seed_spec = do {
    p <- llvm_alloc (llvm_array 128 (llvm_int 8));
    x <- llvm_fresh_var "x" (llvm_array 34 (llvm_int 8));
    llvm_points_to_at_type p (llvm_array 34 (llvm_int 8)) (llvm_term x);
    llvm_execute_func [p, llvm_term {{ 128 : [64] }}, p, llvm_term {{ 34 : [64] }}];
    llvm_points_to p (llvm_term {{ shakeSeed x }});
};
shake256_seed_ov <- llvm_unsafe_assume_spec mw "shake256" shake256_seed_spec;

let eta_spec alias fn f nonce = do {
    pv <- llvm_alloc (llvm_alias alias);
    (seed, ps) <- bytes_ro "seed" 64;
    llvm_execute_func [pv, ps, llvm_term {{ `nonce : [16] }}];
    vec_post pv {{ f seed `nonce }};
};
eta_l_ov <- llvm_unsafe_assume_spec mw "PQCLEAN_MLDSA44_CLEAN_polyvecl_uniform_eta" (eta_spec "struct.polyvecl" "l" {{ etaL }} 0);
eta_k_ov <- llvm_unsafe_assume_spec mw "PQCLEAN_MLDSA44_CLEAN_polyveck_uniform_eta" (eta_spec "struct.polyveck" "k" {{ etaK }} 4);

// polyveck_power2round(t1, t0, t1): v1 aliases v.
let p2r_spec = do {
    (v, pv) <- vec_rows "struct.polyveck" "v";
    p0 <- llvm_alloc (llvm_alias "struct.polyveck");
    llvm_execute_func [pv, p0, pv];
    vec_post pv {{ p2r1 v }};
    vec_post p0 {{ p2r0 v }};
};
p2r_ov <- llvm_unsafe_assume_spec mw "PQCLEAN_MLDSA44_CLEAN_polyveck_power2round" p2r_spec;

let pack_pk_spec = do {
    ppk <- llvm_alloc (llvm_array 1312 (llvm_int 8));
    (rho, prho) <- bytes_ro "rho" 32;
    (t, pt) <- vec_rows "struct.polyveck" "t";
    llvm_execute_func [ppk, prho, pt];
    llvm_points_to ppk (llvm_term {{ packPk rho t }});
    vec_post pt t;
};
pack_pk_ov <- llvm_unsafe_assume_spec mw "PQCLEAN_MLDSA44_CLEAN_pack_pk" pack_pk_spec;

let pack_sk_spec = do {
    psk <- llvm_alloc (llvm_array 2560 (llvm_int 8));
    (rho, prho) <- bytes_ro "rho" 32;
    (tr, ptr) <- bytes_ro "tr" 64;
    (key, pkey) <- bytes_ro "key" 32;
    (t0, pt0) <- vec_rows "struct.polyveck" "t0";
    (s1, ps1) <- vec_rows "struct.polyvecl" "s1";
    (s2, ps2) <- vec_rows "struct.polyveck" "s2";
    llvm_execute_func [psk, prho, ptr, pkey, pt0, ps1, ps2];
    llvm_points_to psk (llvm_term {{ packSk rho tr key t0 s1 s2 }});
    vec_post pt0 t0;
    vec_post ps1 s1;
    vec_post ps2 s2;
};
pack_sk_ov <- llvm_unsafe_assume_spec mw "PQCLEAN_MLDSA44_CLEAN_pack_sk" pack_sk_spec;

let keypair_spec kp = do {
    rb <- llvm_fresh_var "rb" (llvm_array 32 (llvm_int 8));
    llvm_ghost_value rng rb;
    ppk <- llvm_alloc (llvm_array 1312 (llvm_int 8));
    psk <- llvm_alloc (llvm_array 2560 (llvm_int 8));
    llvm_execute_func [ppk, psk];
    llvm_ghost_value rng rb;
    llvm_points_to ppk (llvm_term {{ (kp rb).0 }});
    llvm_points_to psk (llvm_term {{ (kp rb).1 }});
    llvm_return (llvm_term {{ 0 : [32] }});
};
let keypair_ovs = [randombytes_ov, shake256_seed_ov, shake256_ov, expand_ov, eta_l_ov, eta_k_ov,
                   p2r_ov, pack_pk_ov, pack_sk_ov,
                   polyvecl_ntt_r, matrix_r, polyveck_reduce_r, polyveck_invntt_r, polyveck_add_r,
                   polyveck_caddq_r];
let opaque_kp = concat opaque ["shakeSeed", "etaL", "etaK", "p2r1", "p2r0",
                               "packPk", "packSk", "padd"];

llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_crypto_sign_keypair" keypair_ovs false
            (keypair_spec {{ keypair }}) (w4_unint_z3 opaque_kp);
print "VERIFIED: crypto_sign_keypair returns MLDSA_Sign::keypair";

fails (llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_crypto_sign_keypair" keypair_ovs false
                   (keypair_spec {{ keypair_nontt }}) (w4_unint_z3 opaque_kp));
fails (llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_crypto_sign_keypair" keypair_ovs false
                   (keypair_spec {{ keypair_nos2 }}) (w4_unint_z3 opaque_kp));
fails (llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_crypto_sign_keypair" keypair_ovs false
                   (keypair_spec {{ keypair_samenonce }}) (w4_unint_z3 opaque_kp));
fails (llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_crypto_sign_keypair" keypair_ovs false
                   (keypair_spec {{ keypair_rhokey }}) (w4_unint_z3 opaque_kp));
fails (llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_crypto_sign_keypair" keypair_ovs false
                   (keypair_spec {{ keypair_noKL }}) (w4_unint_z3 opaque_kp));
print "NON-VACUOUS: keypair compositions with s1 not transformed, without s2, with s1 and s2 from the same nonce, with rho and key swapped in sk, or without K and L in the seed input are rejected";
// =============================================================================================
// Signing: crypto_sign_signature (signature_ctx with ctx = NULL, ctxlen = 0) on a 32-byte message
// writes MLDSA_Sign::sig_at sk m rb k, where k is the pass of the rejection loop that is accepted.
//
// The loop. Each `goto rej` is taken when an opaque check rejects, so its condition is symbolic and
// SAW would unroll the loop without end. The check functions are therefore given specs that read
// their verdict from ghost state `sched` (one bit per call, top bit first): such a spec asserts, as
// an override precondition, that the opaque check on its actual arguments equals the verdict, and
// returns the verdict as a concrete 1 or 0. The top-level spec sets `sched` and assumes the matching
// fact about the model (pass 0 rejected at check j, pass 1 accepted, ...). Every branch is then
// concrete, and every verdict is an obligation the solver discharges from that assumption.
// One proof per schedule: pass 0 accepted, and pass 0 rejected at each of the four checks with
// pass 1 accepted. A schedule with no top-level assumption must fail (sign_nopre below).

// Proven: the vector functions signing uses that verification and key generation do not.
polyvecl_invntt_r <- check_vmap "PQCLEAN_MLDSA44_CLEAN_polyvecl_invntt_tomont" "struct.polyvecl" {{ invntt }} [poly_invntt_ov] ["invntt"];
polyvecl_reduce_r <- check_vmap "PQCLEAN_MLDSA44_CLEAN_polyvecl_reduce" "struct.polyvecl" {{ preduce }} [poly_reduce_ov] ["preduce"];

// polyvecl_add(z, z, y): output aliases the first operand.
let vadd_l_rows_d d = do {
    (u, pu) <- vec_rows "struct.polyvecl" "u";
    (v, pv) <- vec_rows "struct.polyvecl" "v";
    llvm_execute_func [pu, pu, pv];
    vec_post pu (bumpv {{ [ padd x y | x <- u | y <- v ] }} d);
    vec_post pv v;
};
polyvecl_add_r <- llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_polyvecl_add" [poly_add_alias_ov] true (vadd_l_rows_d {{ 0 : [32] }}) (w4_unint_z3 ["padd"]);
fails (llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_polyvecl_add" [poly_add_alias_ov] true (vadd_l_rows_d {{ 1 : [32] }}) (w4_unint_z3 ["padd"]));

// polyvec{l,k}_pointwise_poly_montgomery(r, cp, v) with r, cp, v distinct (sign.c:159, 169, 178).
let vpw_na_rows_d alias d = do {
    (a, pa) <- poly_to_fresh "a";
    (v, pv) <- vec_rows alias "v";
    pr <- llvm_alloc (llvm_alias alias);
    llvm_execute_func [pr, pa, pv];
    vec_post pr (bumpv {{ [ pointwise a r | r <- v ] }} d);
    llvm_points_to (llvm_field pa "coeffs") (llvm_term a);
    vec_post pv v;
};
polyvecl_pwpoly_r <- llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_polyvecl_pointwise_poly_montgomery" [pointwise_ov] true (vpw_na_rows_d "struct.polyvecl" {{ 0 : [32] }}) (w4_unint_z3 ["pointwise"]);
fails (llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_polyvecl_pointwise_poly_montgomery" [pointwise_ov] true (vpw_na_rows_d "struct.polyvecl" {{ 1 : [32] }}) (w4_unint_z3 ["pointwise"]));
polyveck_pwpoly_na_r <- llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_polyveck_pointwise_poly_montgomery" [pointwise_ov] true (vpw_na_rows_d "struct.polyveck" {{ 0 : [32] }}) (w4_unint_z3 ["pointwise"]);
fails (llvm_verify mw "PQCLEAN_MLDSA44_CLEAN_polyveck_pointwise_poly_montgomery" [pointwise_ov] true (vpw_na_rows_d "struct.polyveck" {{ 1 : [32] }}) (w4_unint_z3 ["pointwise"]));
print "VERIFIED: per-row polyvecl_invntt_tomont, polyvecl_reduce, polyvecl_add (aliased), polyvec{l,k}_pointwise_poly_montgomery (unaliased) (each mutant rejected)";

// ASSUMED (A-SIGN), as for verification and key generation.
let unpack_sk_spec = do {
    prho <- llvm_alloc (llvm_array 32 (llvm_int 8));
    ptr <- llvm_alloc (llvm_array 64 (llvm_int 8));
    pkey <- llvm_alloc (llvm_array 32 (llvm_int 8));
    pt0 <- llvm_alloc (llvm_alias "struct.polyveck");
    ps1 <- llvm_alloc (llvm_alias "struct.polyvecl");
    ps2 <- llvm_alloc (llvm_alias "struct.polyveck");
    (sk, psk) <- bytes_ro "sk" 2560;
    llvm_execute_func [prho, ptr, pkey, pt0, ps1, ps2, psk];
    llvm_points_to prho (llvm_term {{ skRho sk }});
    llvm_points_to ptr (llvm_term {{ skTr sk }});
    llvm_points_to pkey (llvm_term {{ skKey sk }});
    vec_post pt0 {{ skT0 sk }};
    vec_post ps1 {{ skS1 sk }};
    vec_post ps2 {{ skS2 sk }};
};
unpack_sk_ov <- llvm_unsafe_assume_spec mw "PQCLEAN_MLDSA44_CLEAN_unpack_sk" unpack_sk_spec;

// shake256(rhoprime, 64, key, 128): key, rnd and mu are contiguous in seedbuf.
let shake256_rhop_spec = do {
    pout <- llvm_alloc (llvm_array 64 (llvm_int 8));
    (x, px) <- bytes_ro "in" 128;
    llvm_execute_func [pout, llvm_term {{ 64 : [64] }}, px, llvm_term {{ 128 : [64] }}];
    llvm_points_to pout (llvm_term {{ shakeRhop x }});
};
shake256_rhop_ov <- llvm_unsafe_assume_spec mw "shake256" shake256_rhop_spec;

let gamma1_spec = do {
    pv <- llvm_alloc (llvm_alias "struct.polyvecl");
    (seed, ps) <- bytes_ro "seed" 64;
    n <- llvm_fresh_var "n" (llvm_int 16);
    llvm_execute_func [pv, ps, llvm_term n];
    vec_post pv {{ gamma1 seed n }};
};
gamma1_ov <- llvm_unsafe_assume_spec mw "PQCLEAN_MLDSA44_CLEAN_polyvecl_uniform_gamma1" gamma1_spec;

// polyveck_decompose(w1, w0, w1): v1 aliases v.
let decompose_spec = do {
    (v, pv) <- vec_rows "struct.polyveck" "v";
    p0 <- llvm_alloc (llvm_alias "struct.polyveck");
    llvm_execute_func [pv, p0, pv];
    vec_post pv {{ dec1 v }};
    vec_post p0 {{ dec0 v }};
};
decompose_ov <- llvm_unsafe_assume_spec mw "PQCLEAN_MLDSA44_CLEAN_polyveck_decompose" decompose_spec;

// pack_sig(sig, sig, z, h): c is the first 32 bytes of the output buffer.
let pack_sig_spec = do {
    psig <- llvm_alloc (llvm_array 2420 (llvm_int 8));
    c <- llvm_fresh_var "c" (llvm_array 32 (llvm_int 8));
    llvm_points_to_at_type psig (llvm_array 32 (llvm_int 8)) (llvm_term c);
    (z, pz) <- vec_rows "struct.polyvecl" "z";
    (h, ph) <- vec_rows "struct.polyveck" "h";
    llvm_execute_func [psig, psig, pz, ph];
    llvm_points_to psig (llvm_term {{ packSig c z h }});
    vec_post pz z;
    vec_post ph h;
};
pack_sig_ov <- llvm_unsafe_assume_spec mw "PQCLEAN_MLDSA44_CLEAN_pack_sig" pack_sig_spec;

// The four checks. `sched` counts the check calls made so far; for each step k and each check there
// is an override that applies only when sched == k, asserts (as an override precondition) that the
// opaque check on its actual arguments equals the verdict the plan gives step k, returns that
// verdict as a concrete value, and sets sched to k + 1. The norm checks return 1 or 0
// (polyvec.c:152-156, 315-319). make_hint returns a count that sign.c uses only in `n > OMEGA`
// (sign.c:186); its override returns 81 or 0 in its place.
sched <- declare_ghost_state "sched";
let chk_step alias bound f k v = do {
    llvm_ghost_value sched {{ `k : [8] }};
    (x, px) <- vec_rows alias "v";
    llvm_precond {{ f x == v }};
    llvm_execute_func [px, llvm_term {{ `bound : [32] }}];
    llvm_ghost_value sched {{ `k + 1 : [8] }};
    vec_post px x;
    llvm_return (llvm_term {{ if v then 1 else 0 : [32] }});
};
let hint_step k v = do {
    llvm_ghost_value sched {{ `k : [8] }};
    ph <- llvm_alloc (llvm_alias "struct.polyveck");
    (v0, pv0) <- vec_rows "struct.polyveck" "v0";
    (v1, pv1) <- vec_rows "struct.polyveck" "v1";
    llvm_precond {{ hintBad v0 v1 == v }};
    llvm_execute_func [ph, pv0, pv1];
    llvm_ghost_value sched {{ `k + 1 : [8] }};
    vec_post ph {{ hintH v0 v1 }};
    vec_post pv0 v0;
    vec_post pv1 v1;
    llvm_return (llvm_term {{ if v then 81 else 0 : [32] }});
};
// plan: the verdict (True = reject) of each of the first 8 check calls, in call order.
let sched_ovs plan = do {
    oss <- for [0, 1, 2, 3, 4, 5, 6, 7] (\k -> do {
        let v = nth plan k;
        o1 <- llvm_unsafe_assume_spec mw "PQCLEAN_MLDSA44_CLEAN_polyvecl_chknorm" (chk_step "struct.polyvecl" 130994 {{ chkZ }} k v);         // GAMMA1 - BETA
        o2 <- llvm_unsafe_assume_spec mw "PQCLEAN_MLDSA44_CLEAN_polyveck_chknorm" (chk_step "struct.polyveck" 95154 {{ chkK 95154 }} k v);   // GAMMA2 - BETA
        o3 <- llvm_unsafe_assume_spec mw "PQCLEAN_MLDSA44_CLEAN_polyveck_chknorm" (chk_step "struct.polyveck" 95232 {{ chkK 95232 }} k v);   // GAMMA2
        o4 <- llvm_unsafe_assume_spec mw "PQCLEAN_MLDSA44_CLEAN_polyveck_make_hint" (hint_step k v);
        return [o1, o2, o3, o4];
    });
    return (concat (nth oss 0) (concat (nth oss 1) (concat (nth oss 2) (concat (nth oss 3)
           (concat (nth oss 4) (concat (nth oss 5) (concat (nth oss 6) (nth oss 7))))))));
};

// The composition. ncalls: how many check calls the plan makes; pre: what the model says about the
// passes the plan describes; out: the signature the model says is written.
let sign_spec ncalls pre out = do {
    rb <- llvm_fresh_var "rb" (llvm_array 32 (llvm_int 8));
    llvm_ghost_value rng rb;
    llvm_ghost_value sched {{ 0 : [8] }};
    (sk, psk) <- bytes_ro "sk" 2560;
    (msg, pm) <- bytes_ro "m" 32;
    psig <- llvm_alloc (llvm_array 2420 (llvm_int 8));
    plen <- llvm_alloc (llvm_int 64);
    llvm_precond {{ pre sk msg rb }};
    llvm_execute_func [psig, plen, pm, llvm_term {{ 32 : [64] }}, psk];
    llvm_ghost_value rng rb;
    llvm_ghost_value sched {{ `ncalls : [8] }};
    llvm_points_to psig (llvm_term {{ out sk msg rb }});
    llvm_points_to plen (llvm_term {{ 2420 : [64] }});
    llvm_return (llvm_term {{ 0 : [32] }});
};
let sign_ovs = [unpack_sk_ov, inc_init_ov, absorb64_ov, absorb2_ov, absorb0_ov, absorbM_ov,
                absorb768_ov, finalize_ov, squeeze64_ov, squeeze32_ov, release_ov, randombytes_ov,
                shake256_rhop_ov, expand_ov, gamma1_ov, decompose_ov, pack_w1_ov, challenge_ov,
                pack_sig_ov,
                polyvecl_ntt_r, polyveck_ntt_r, matrix_r, polyveck_reduce_r, polyveck_invntt_r,
                polyveck_caddq_r, poly_ntt_ov, polyvecl_pwpoly_r, polyvecl_invntt_r, polyvecl_add_r,
                polyvecl_reduce_r, polyveck_pwpoly_na_r, polyveck_sub_r, polyveck_add_r];
let opaque_sg = concat opaque ["padd", "skRho", "skTr", "skKey", "skT0", "skS1", "skS2",
                               "shakeRhop", "gamma1", "dec1", "dec0", "chkK", "hintH", "hintBad",
                               "packSig"];
let sign_fn = "PQCLEAN_MLDSA44_CLEAN_crypto_sign_signature";

let no = {{ False }};
let yes = {{ True }};
// override lists for the five schedules (verdicts of the first 8 check calls, True = reject)
ovs_acc <- sched_ovs [no, no, no, no, no, no, no, no];
ovs_r1  <- sched_ovs [yes, no, no, no, no, no, no, no];
ovs_r2  <- sched_ovs [no, yes, no, no, no, no, no, no];
ovs_r3  <- sched_ovs [no, no, yes, no, no, no, no, no];
ovs_r4  <- sched_ovs [no, no, no, yes, no, no, no, no];

// pass 0 accepted
llvm_verify mw sign_fn (concat sign_ovs ovs_acc) false
            (sign_spec 4 {{ \sk m rb -> accepts sk m rb 0 }} {{ \sk m rb -> sig_at sk m rb 0 }}) (w4_unint_z3 opaque_sg);
print "VERIFIED: crypto_sign_signature writes sig_at sk m rb 0 when pass 0 is accepted";

// pass 0 rejected at check j (z norm, w0 - c*s2 norm, c*t0 norm, hint count), pass 1 accepted
llvm_verify mw sign_fn (concat sign_ovs ovs_r1) false
            (sign_spec 5 {{ \sk m rb -> rejects_at sk m rb 0 1 && accepts sk m rb 1 }} {{ \sk m rb -> sig_at sk m rb 1 }}) (w4_unint_z3 opaque_sg);
llvm_verify mw sign_fn (concat sign_ovs ovs_r2) false
            (sign_spec 6 {{ \sk m rb -> rejects_at sk m rb 0 2 && accepts sk m rb 1 }} {{ \sk m rb -> sig_at sk m rb 1 }}) (w4_unint_z3 opaque_sg);
llvm_verify mw sign_fn (concat sign_ovs ovs_r3) false
            (sign_spec 7 {{ \sk m rb -> rejects_at sk m rb 0 3 && accepts sk m rb 1 }} {{ \sk m rb -> sig_at sk m rb 1 }}) (w4_unint_z3 opaque_sg);
llvm_verify mw sign_fn (concat sign_ovs ovs_r4) false
            (sign_spec 8 {{ \sk m rb -> rejects_at sk m rb 0 4 && accepts sk m rb 1 }} {{ \sk m rb -> sig_at sk m rb 1 }}) (w4_unint_z3 opaque_sg);
print "VERIFIED: crypto_sign_signature writes sig_at sk m rb 1 when pass 0 is rejected at any of its four checks and pass 1 is accepted";

// Non-vacuity. Without the assumption the verdicts are not provable; a rejected pass followed by
// the signature of pass 0 (nonce not advanced); and wrong compositions of one pass.
fails (llvm_verify mw sign_fn (concat sign_ovs ovs_acc) false
                   (sign_spec 4 {{ \sk m rb -> True }} {{ \sk m rb -> sig_at sk m rb 0 }}) (w4_unint_z3 opaque_sg));
fails (llvm_verify mw sign_fn (concat sign_ovs ovs_r1) false
                   (sign_spec 5 {{ \sk m rb -> rejects_at sk m rb 0 1 && accepts sk m rb 1 }} {{ \sk m rb -> sig_at sk m rb 0 }}) (w4_unint_z3 opaque_sg));
fails (llvm_verify mw sign_fn (concat sign_ovs ovs_acc) false
                   (sign_spec 4 {{ \sk m rb -> accepts sk m rb 0 }} {{ \sk m rb -> sig_mut 1 sk m rb 0 }}) (w4_unint_z3 opaque_sg));
fails (llvm_verify mw sign_fn (concat sign_ovs ovs_acc) false
                   (sign_spec 4 {{ \sk m rb -> accepts sk m rb 0 }} {{ \sk m rb -> sig_mut 2 sk m rb 0 }}) (w4_unint_z3 opaque_sg));
fails (llvm_verify mw sign_fn (concat sign_ovs ovs_acc) false
                   (sign_spec 4 {{ \sk m rb -> accepts sk m rb 0 }} {{ \sk m rb -> sig_mut 3 sk m rb 0 }}) (w4_unint_z3 opaque_sg));
fails (llvm_verify mw sign_fn (concat sign_ovs ovs_acc) false
                   (sign_spec 4 {{ \sk m rb -> accepts sk m rb 0 }} {{ \sk m rb -> sig_mut 4 sk m rb 0 }}) (w4_unint_z3 opaque_sg));
fails (llvm_verify mw sign_fn (concat sign_ovs ovs_acc) false
                   (sign_spec 4 {{ \sk m rb -> accepts sk m rb 0 }} {{ \sk m rb -> sig_mut 5 sk m rb 0 }}) (w4_unint_z3 opaque_sg));
fails (llvm_verify mw sign_fn (concat sign_ovs ovs_acc) false
                   (sign_spec 4 {{ \sk m rb -> accepts sk m rb 0 }} {{ \sk m rb -> sig_mut 6 sk m rb 0 }}) (w4_unint_z3 opaque_sg));
print "NON-VACUOUS: signing without the check assumption, with the nonce not advanced, without y, with s1 for s2, without rnd, with the hint arguments swapped, without c*t0, or with z not reduced is rejected";
