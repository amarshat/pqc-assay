/* Wrong compositions for sign_compose.saw's non-vacuity guards. Each differs from
   MLDSA_Sign::verify in one step; crypto_sign_verify must NOT be provable against any of them. */
module MLDSA_Sign_Mutants where

import MLDSA_NTT
import MLDSA_Sign

// w1_pre with one step changed, selected by k:
//   1  t1 not shifted by 13 before its NTT
//   2  the subtraction swapped (c*t1 - A*z)
//   3  z used without its NTT
//   4  no caddq at the end
w1_mut : [8] -> [4]Vec -> Vec -> Poly -> Vec -> Vec
w1_mut k a z c t1 = [ fin (invntt (preduce r)) | r <- diff ]
  where
    zh   = if k == 3 then z else [ ntt p | p <- z ]
    az   = [ acc row zh | row <- a ]
    ch   = ntt c
    t1h  = [ ntt (if k == 1 then p else pshiftl p) | p <- t1 ]
    ct1  = [ pointwise ch p | p <- t1h ]
    diff = if k == 2 then [ psub y x | x <- az | y <- ct1 ] else [ psub x y | x <- az | y <- ct1 ]
    fin p = if k == 4 then p else pcaddq p

verify_mut : [8] -> Bit -> [SIGB][8] -> [32][8] -> [PKB][8] -> [32]
verify_mut k skipchk sig m pk =
  if sigBad sig != 0 then -1
  else if (~skipchk) && (chkZ (sigZ sig) != 0) then -1
  else if sigC sig == c2 then 0 else -1
  where
    w1  = useHint (w1_mut k (expandA (pkRho pk)) (sigZ sig) (challenge (sigC sig)) (pkT1 pk)) (sigH sig)
    c2  = squeeze32 (finalize (absorb768 (absorb64 incInit (mu_of pk m)) (packW1 w1)))

verify_noshift  = verify_mut 1 False
verify_swapsub  = verify_mut 2 False
verify_zplain   = verify_mut 3 False
verify_nocaddq  = verify_mut 4 False
verify_nochk    = verify_mut 0 True

// The hashing steps: mu without the message absorbed, and no check of unpack_sig's result.
// If the opaque functions were unfolded to their placeholder bodies (absorb s _ = s), the first
// would be indistinguishable from verify and the guard would fail; it is rejected only because
// absorbM is uninterpreted.
mu_nomsg : [PKB][8] -> [64][8]
mu_nomsg pk = squeeze64 (finalize (absorb0 (absorb2 (absorb64 incInit (shakeTr pk)) [0, 0])))

verify_nomsg : [SIGB][8] -> [32][8] -> [PKB][8] -> [32]
verify_nomsg sig m pk =
  if sigBad sig != 0 then -1
  else if chkZ (sigZ sig) != 0 then -1
  else if sigC sig == c2 then 0 else -1
  where
    w1  = useHint (w1_pre (expandA (pkRho pk)) (sigZ sig) (challenge (sigC sig)) (pkT1 pk)) (sigH sig)
    c2  = squeeze32 (finalize (absorb768 (absorb64 incInit (mu_nomsg pk)) (packW1 w1)))

verify_nobad : [SIGB][8] -> [32][8] -> [PKB][8] -> [32]
verify_nobad sig m pk =
  if chkZ (sigZ sig) != 0 then -1
  else if sigC sig == c2 then 0 else -1
  where
    w1  = useHint (w1_pre (expandA (pkRho pk)) (sigZ sig) (challenge (sigC sig)) (pkT1 pk)) (sigH sig)
    c2  = squeeze32 (finalize (absorb768 (absorb64 incInit (mu_of pk m)) (packW1 w1)))

// Key generation, one step changed each.
keypair_mut : [8] -> [32][8] -> ([PKB][8], [SKB][8])
keypair_mut k rb = (pk, sk)
  where
    sb   = shakeSeed (rb # (if k == 5 then [0, 0] else [4, 4]))
    rho  = take`{32} sb
    rhop = take`{64} (drop`{32} sb)
    key  = drop`{96} sb
    s1   = etaL rhop 0
    s2   = etaK rhop (if k == 3 then 0 else 4)
    s1h  = if k == 1 then s1 else [ ntt p | p <- s1 ]
    as1  = [ acc row s1h | row <- expandA rho ]
    t    = [ pcaddq (if k == 2 then invntt (preduce r) else padd (invntt (preduce r)) e) | r <- as1 | e <- s2 ]
    pk   = packPk rho (p2r1 t)
    sk   = if k == 4 then packSk key (shakeTr pk) rho (p2r0 t) s1 s2
           else packSk rho (shakeTr pk) key (p2r0 t) s1 s2

keypair_nontt     = keypair_mut 1
keypair_nos2      = keypair_mut 2
keypair_samenonce = keypair_mut 3
keypair_rhokey    = keypair_mut 4
keypair_noKL      = keypair_mut 5
