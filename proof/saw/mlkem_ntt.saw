// SAW proof: the vendored PQClean ML-KEM-512 forward NTT (ntt.c) implements the Cryptol model
// bit-for-bit. Go-wide slice 2 (see docs/ROADMAP.md): the ML-DSA forward NTT, restated at ML-KEM's
// int16 widths with 7 Cooley-Tukey levels.
//
// Structure mirrors mldsa_ntt.saw. The functional equivalence is proved on the -fwrapv bitcode with
// montgomery_reduce as an uninterpreted override, so the 896 butterfly calls collapse to a
// structural array equality. We load -fwrapv for the same reason ML-DSA does: on the default (nsw)
// bitcode SAW emits a no-signed-overflow side condition for every int-width add/sub and multiply in
// the transform (~2700 of them), and discharging that conjunction together with the equality in one
// solver call is the expensive part. On -fwrapv there is no nsw poison, so only the clean equality
// remains. UB-freedom is a SEPARATE obligation (see the note at the end): unlike ML-DSA, ML-KEM's
// int16 butterfly cannot overflow int, so no coefficient bound is needed for it.
//
// This script must exit 0 ONLY when llvm_verify genuinely discharges the proof.

enable_experimental;

m <- llvm_load_module "../../build/mlkem_ntt.bc";
import "../../model/cryptol/MLKEM_NTT.cry";

// montgomery_reduce on the default bitcode, under its documented input range (the honest reduce-layer
// result; this also establishes no signed-overflow UB inside the range on the nsw bitcode).
let montgomery_reduce_spec = do {
    a <- llvm_fresh_var "a" (llvm_int 32);
    llvm_precond {{ mont_in_range a }};
    llvm_execute_func [llvm_term a];
    llvm_return (llvm_term {{ montgomery_reduce a }});
};
mr_ov <- llvm_verify m "PQCLEAN_MLKEM512_CLEAN_montgomery_reduce" [] true montgomery_reduce_spec z3;
print "VERIFIED: PQCLEAN_MLKEM512_CLEAN_montgomery_reduce == Cryptol montgomery_reduce (default nsw bitcode, documented range)";

// --- forward NTT equivalence on the -fwrapv bitcode -----------------------------------------
mw <- llvm_load_module "../../build/mlkem_ntt_wrapv.bc";

// On -fwrapv, montgomery_reduce == model unconditionally (its internal a - t*Q wraps, no UB).
let mont_reduce_uncond_spec = do {
    a <- llvm_fresh_var "a" (llvm_int 32);
    llvm_execute_func [llvm_term a];
    llvm_return (llvm_term {{ montgomery_reduce a }});
};
mr_ov_w <- llvm_verify mw "PQCLEAN_MLKEM512_CLEAN_montgomery_reduce" [] true mont_reduce_uncond_spec z3;

let ptr_to_fresh nm ty = do {
    x <- llvm_fresh_var nm ty;
    p <- llvm_alloc ty;
    llvm_points_to p (llvm_term x);
    return (x, p);
};

// C ntt(a[256]) rewrites the array in place to the Cryptol `ntt a`. montgomery_reduce is the
// uninterpreted override (w4_unint_z3), so both sides reduce to the same structural array equality.
let ntt_spec = do {
    (a, pa) <- ptr_to_fresh "a" (llvm_array 256 (llvm_int 16));
    llvm_execute_func [pa];
    llvm_points_to pa (llvm_term {{ ntt a }});
};
// The SBV unint_z3 backend discharges this goal; the what4 w4_unint_z3 backend does not terminate
// within 10 min on it (measured 2026-07-16), the reverse of the reduce-layer experience. Kept as a
// solver-choice datum. Non-vacuity for the NTT is covered by the mutation-test harness (make
// mutation-test), matching mldsa_ntt.saw, not by an inline output mutant here.
ntt_ov <- llvm_verify mw "PQCLEAN_MLKEM512_CLEAN_ntt" [mr_ov_w] true ntt_spec
                      (unint_z3 ["montgomery_reduce"]);
print "VERIFIED: PQCLEAN_MLKEM512_CLEAN_ntt == Cryptol ntt (two's-complement wrapping; montgomery_reduce override)";

// --- inverse NTT: C invntt(a[256]) == Cryptol invntt, under two's-complement wrapping -------
// invntt's low leg goes through barrett_reduce every level (unlike ML-DSA's inverse, which
// leaves it unreduced), so this also needs a barrett_reduce override on the -fwrapv module,
// re-proved here the same way montgomery_reduce was above (an override must be proved against
// the specific module it overrides calls in).
let barrett_reduce_spec = do {
    a <- llvm_fresh_var "a" (llvm_int 16);
    llvm_execute_func [llvm_term a];
    llvm_return (llvm_term {{ barrett_reduce a }});
};
br_ov_w <- llvm_verify mw "PQCLEAN_MLKEM512_CLEAN_barrett_reduce" [] true barrett_reduce_spec z3;

// C invntt(a[256]) rewrites the array in place to the Cryptol `invntt a`. montgomery_reduce
// and barrett_reduce are both uninterpreted overrides, so the fqmul/barrett_reduce calls in the
// 7-level transform plus the final scale collapse to a structural array equality, mirroring the
// forward proof above.
let invntt_spec = do {
    (a, pa) <- ptr_to_fresh "a" (llvm_array 256 (llvm_int 16));
    llvm_execute_func [pa];
    llvm_points_to pa (llvm_term {{ invntt a }});
};
invntt_ov <- llvm_verify mw "PQCLEAN_MLKEM512_CLEAN_invntt" [mr_ov_w, br_ov_w] true invntt_spec
                         (unint_z3 ["montgomery_reduce", "barrett_reduce"]);
print "VERIFIED: PQCLEAN_MLKEM512_CLEAN_invntt == Cryptol invntt (two's-complement wrapping; montgomery_reduce+barrett_reduce overrides)";

// Non-vacuity: a wrong (result[0]+1) invntt spec must be REJECTED. Unlike the forward proof
// above, this isn't left to scripts/mutation_test.sh -- that script only mutates ML-DSA's
// montgomery_reduce, so it gives ML-KEM no coverage at all despite the forward proof's comment
// implying it does. Checked inline instead, the same way mlkem_reduce.saw does it.
let invntt_mut_spec = do {
    (a, pa) <- ptr_to_fresh "a" (llvm_array 256 (llvm_int 16));
    llvm_execute_func [pa];
    llvm_points_to pa (llvm_term {{ update (invntt a) 0 ((invntt a) @ 0 + 1) }});
};
fails (llvm_verify mw "PQCLEAN_MLKEM512_CLEAN_invntt" [mr_ov_w, br_ov_w] true invntt_mut_spec
                   (unint_z3 ["montgomery_reduce", "barrett_reduce"]));
print "NON-VACUOUS: the result[0]+1 invntt spec is rejected with a counterexample";

// --- note on UB-freedom (the boundary datum vs ML-DSA) --------------------------------------
// ML-DSA's forward NTT needs a separate coefficient-bound proof (make ntt-nsw, ~12.5 h bitwuzla)
// because its int32 butterfly add/sub genuinely overflows for unbounded inputs. ML-KEM's int16
// coefficients promote to int for the add/sub, so |r +/- t| < 2^16 never overflows int32: the C is
// UB-free with no precondition. The same argument covers invntt (its low leg is additionally
// re-reduced by barrett_reduce every level, so it never even approaches int16's range, let alone
// int32's). Mechanizing that on the nsw bitcode is tracked separately; the ~2700 nsw side
// conditions are individually trivial (17-bit sums, 30-bit products) but do not discharge as one
// monolithic z3 goal, so it needs splitting rather than a bound.
