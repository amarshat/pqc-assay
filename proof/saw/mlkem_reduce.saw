// SAW proof: the vendored PQClean ML-KEM-512 C reduction primitives implement the Cryptol model
// bit-for-bit. Go-wide slice 1 (see docs/ROADMAP.md): same pipeline as the ML-DSA reduce layer,
// second algorithm, 16-bit widths.
//
// Paths are relative to THIS script's directory (SAW resolves load/import that way):
//   ../../build/mlkem_ntt.bc            <- built by scripts/build_bitcode.sh from target/pqclean-mlkem
//   ../../model/cryptol/MLKEM_NTT.cry   <- the hand-written model
//
// This script must exit 0 ONLY when llvm_verify genuinely discharges the proof.

enable_experimental;

m <- llvm_load_module "../../build/mlkem_ntt.bc";
import "../../model/cryptol/MLKEM_NTT.cry";

// montgomery_reduce: for a 32-bit input within the documented range -q*2^15 <= a <= q*2^15 - 1,
// the C returns exactly the model. Default (nsw) bitcode: the proof also establishes the C has no
// signed-overflow UB inside the range.
let montgomery_reduce_spec = do {
    a <- llvm_fresh_var "a" (llvm_int 32);
    llvm_precond {{ mont_in_range a }};
    llvm_execute_func [llvm_term a];
    llvm_return (llvm_term {{ montgomery_reduce a }});
};

montgomery_reduce_ov <-
    llvm_verify m "PQCLEAN_MLKEM512_CLEAN_montgomery_reduce" [] true montgomery_reduce_spec z3;

print "VERIFIED: PQCLEAN_MLKEM512_CLEAN_montgomery_reduce == Cryptol montgomery_reduce (under -q*2^15 <= a <= q*2^15 - 1)";

// barrett_reduce: unconditional. The C's arithmetic never overflows at int width (the v*a product
// is < 2^30); the int-to-int16 narrowing it does rely on is implementation-defined conversion,
// not UB, and matches the model's mod-2^16 arithmetic.
let barrett_reduce_spec = do {
    a <- llvm_fresh_var "a" (llvm_int 16);
    llvm_execute_func [llvm_term a];
    llvm_return (llvm_term {{ barrett_reduce a }});
};

barrett_reduce_ov <- llvm_verify m "PQCLEAN_MLKEM512_CLEAN_barrett_reduce" [] true barrett_reduce_spec z3;

print "VERIFIED: PQCLEAN_MLKEM512_CLEAN_barrett_reduce == Cryptol barrett_reduce (all int16 inputs)";

// --- math-level correctness, direct SMT (the boundary datum) --------------------------------
// The same statements at ML-DSA widths needed Isabelle (montgomery_reduce_correct, 64/32-bit) or
// bitwuzla (the Rust 2^46 Barrett). At ML-KEM widths z3 discharges them here directly, with one
// measured wrinkle recorded in the model: the INTEGER form of the Montgomery congruence
// (mont_correct) stalls z3 and cvc5 even at these widths (nonlinear Integer + mod), while the
// [48] bit-vector form (mont_correct_bv, same integer fact, nothing wraps, multiply-by-2^16 is a
// shift) discharges in ~11 s. Composed with the llvm_verify results above, the C functions
// inherit the math: C montgomery_reduce is a Montgomery reduction on its documented range, C
// barrett_reduce returns the centered representative mod q for every int16 input.
mont_math <- prove_print z3 {{ mont_correct_bv }};
print "PROVED (z3, direct, ~11s): 2^16 * montgomery_reduce(a) == a (mod q), |result| < q, on the documented range";

barrett_math <- prove_print z3 {{ barrett_correct }};
print "PROVED (z3, direct, ~13s): barrett_reduce(a) == a (mod q), centered in [-(q-1)/2, (q-1)/2], all int16 (Integer form, no restatement needed)";

// --- non-vacuity: a result+1 mutant of each equivalence must be rejected --------------------
let montgomery_reduce_mut_spec = do {
    a <- llvm_fresh_var "a" (llvm_int 32);
    llvm_precond {{ mont_in_range a }};
    llvm_execute_func [llvm_term a];
    llvm_return (llvm_term {{ montgomery_reduce a + 1 }});
};
fails (llvm_verify m "PQCLEAN_MLKEM512_CLEAN_montgomery_reduce" [] true montgomery_reduce_mut_spec z3);
print "NON-VACUOUS: the result+1 montgomery_reduce spec is rejected with a counterexample";

let barrett_reduce_mut_spec = do {
    a <- llvm_fresh_var "a" (llvm_int 16);
    llvm_execute_func [llvm_term a];
    llvm_return (llvm_term {{ barrett_reduce a + 1 }});
};
fails (llvm_verify m "PQCLEAN_MLKEM512_CLEAN_barrett_reduce" [] true barrett_reduce_mut_spec z3);
print "NON-VACUOUS: the result+1 barrett_reduce spec is rejected with a counterexample";
