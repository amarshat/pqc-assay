// Additive-FFT reference, hqc-3: encode_64 and decode_64 at this length (linear_map_x8 and
// transpose_8x8 proved on their own and used as overrides; A-HQC-FFT items 7 and 8).
import "FFTRef.cry";
import "FFTEnc.cry";
import "FFTBC.cry";
m <- llvm_load_module "../../build/hqc-fft/fft_ref.bc";
let w n = llvm_array n (llvm_int 64);
let w32 n = llvm_array n (llvm_int 32);
let flip = {{ [1] # zero }};
let mats = do {
  llvm_alloc_global "_enc_mat";
  llvm_points_to (llvm_global "_enc_mat") (llvm_global_initializer "_enc_mat");
  llvm_alloc_global "_dec_mat";
  llvm_points_to (llvm_global "_dec_mat") (llvm_global_initializer "_dec_mat");
};

// encode_64(rfx, 1024, fx, 32) and decode_64(rfx, fx, 1024); the matrices are the real globals; the
// decode spec allocates 8 extra words (A-HQC-FFT item 7); transpose_8x8 is an override.
let enc3_spec post = do {
  mats;
  rp <- llvm_alloc (w 1024);
  fp <- llvm_alloc_readonly (w 512);
  x <- llvm_fresh_var "fx" (w 512);
  llvm_points_to fp (llvm_term x);
  llvm_execute_func [rp, llvm_term {{ 1024 : [32] }}, fp, llvm_term {{ 32 : [32] }}];
  llvm_points_to rp (llvm_term (post x));
};
let lin_spec post = do {
  mats;
  rr <- llvm_alloc (w 8);
  ip <- llvm_alloc_readonly (llvm_array 32 (llvm_int 8));
  bits <- llvm_fresh_var "inbits" (llvm_array 32 (llvm_int 8));
  llvm_points_to ip (llvm_term bits);
  llvm_execute_func [rr, ip, llvm_term {{ 32 : [32] }}, llvm_global "_enc_mat"];
  llvm_points_to rr (llvm_term (post bits));
  // unchanged by the call, and restated so that SAW does not treat them as clobbered for the next batch
  llvm_points_to ip (llvm_term bits);
  llvm_points_to (llvm_global "_enc_mat") (llvm_global_initializer "_enc_mat");
  llvm_points_to (llvm_global "_dec_mat") (llvm_global_initializer "_dec_mat");
};
lin <- llvm_verify m "linear_map_x8" [] false (lin_spec (\b -> {{ lin8 b }})) rme;
fails (llvm_verify m "linear_map_x8" [] false (lin_spec (\b -> {{ lin8 b ^ flip }})) abc);
enc3 <- llvm_verify m "encode_64" [lin] false (enc3_spec (\x -> {{ encode3 x }})) (w4_unint_z3 ["lin8"]);
fails (llvm_verify m "encode_64" [lin] false (enc3_spec (\x -> {{ encode3 x ^ flip }})) (w4_unint_z3 ["lin8"]));
let tr_spec post = do {
  p <- llvm_alloc (llvm_array 8 (llvm_int 8));
  x <- llvm_fresh_var "mat0" (llvm_array 8 (llvm_int 8));
  llvm_points_to p (llvm_term x);
  llvm_execute_func [p];
  llvm_points_to p (llvm_term (post x));
};
tr <- llvm_verify m "transpose_8x8" [] false (tr_spec (\x -> {{ transpose8 x }})) (w4_unint_z3 []);
fails (llvm_verify m "transpose_8x8" [] false (tr_spec (\x -> {{ transpose8 x ^ [1, 0, 0, 0, 0, 0, 0, 0] }})) (w4_unint_z3 []));
let dec3_spec post = do {
  mats;
  rp <- llvm_alloc (w 1040);
  fp <- llvm_alloc_readonly (w 1024);
  x <- llvm_fresh_var "fx" (w 1024);
  llvm_points_to fp (llvm_term x);
  llvm_execute_func [rp, fp, llvm_term {{ 1024 : [32] }}];
  llvm_points_to_untyped rp (llvm_term (post x));
};
// decode_64 at 1024 elements under rme needs more memory than one process gets (the hqc-5 goal needed more than 45 GB), so
// the postcondition is proved in 2 parts of 512 words, each a separate obligation with the same
// precondition (the rest of the output unconstrained in that part). The function is deterministic, so
// the parts together are the full contract, which fft_3.saw assumes (A-HQC-FFT item 8).
let dec3_part_spec off post = do {
  mats;
  rp <- llvm_alloc (w 1040);
  fp <- llvm_alloc_readonly (w 1024);
  x <- llvm_fresh_var "fx" (w 1024);
  llvm_points_to fp (llvm_term x);
  llvm_execute_func [rp, fp, llvm_term {{ 1024 : [32] }}];
  llvm_points_to_untyped (llvm_elem rp off) (llvm_term (post x));
};
dec3_p0 <- llvm_verify m "decode_64" [tr] false (dec3_part_spec 0 (\x -> {{ take`{512} (drop`{0} (decode3 x)) }})) rme;
fails (llvm_verify m "decode_64" [tr] false (dec3_part_spec 0 (\x -> {{ take`{512} (drop`{0} (decode3 x)) ^ flip }})) abc);
dec3_p1 <- llvm_verify m "decode_64" [tr] false (dec3_part_spec 512 (\x -> {{ take`{512} (drop`{512} (decode3 x)) }})) rme;
fails (llvm_verify m "decode_64" [tr] false (dec3_part_spec 512 (\x -> {{ take`{512} (drop`{512} (decode3 x)) ^ flip }})) abc);
print "VERIFIED: hqc-3 decode_64(1024) == decode3, in 2 parts of 512 words";

