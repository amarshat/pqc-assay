// The GF(2^64) additive-FFT multiplier, reference C, hqc-1 sizes. Script 3: encode_64 and decode_64
// (dencoder.c) against the F2-linear maps encode / decode in FFTEnc.cry: 256 words to 512 field
// elements and 512 elements to 512 words, through the constant matrices _enc_mat and _dec_mat (the
// real globals). Both are linear, so rme proves them (z3 did not finish encode in 40 minutes).
import "FFTEnc.cry";
m <- llvm_load_module "../../build/hqc-fft/fft_ref.bc";
let w n = llvm_array n (llvm_int 64);
let flip = {{ [1] # zero }};

let mats = do {
  llvm_alloc_global "_enc_mat";
  llvm_points_to (llvm_global "_enc_mat") (llvm_global_initializer "_enc_mat");
  llvm_alloc_global "_dec_mat";
  llvm_points_to (llvm_global "_dec_mat") (llvm_global_initializer "_dec_mat");
};

// encode_64(rfx, n_u64 = 512, fx, src_bits = 32): the C reads fx byte by byte.
let enc_spec post = do {
  mats;
  rp <- llvm_alloc (w 512);
  fp <- llvm_alloc_readonly (w 256);
  x <- llvm_fresh_var "fx" (w 256);
  llvm_points_to fp (llvm_term x);
  llvm_execute_func [rp, llvm_term {{ 512 : [32] }}, fp, llvm_term {{ 32 : [32] }}];
  llvm_points_to rp (llvm_term (post x));
};
// linear_map_x8(rrx8, inbits, 32, _enc_mat): 32 bytes to 8 words, proved on its own (256 input bits) and
// used as an override, so that encode_64's obligation is the byte gathers and the assembly of 64
// batches with lin8 uninterpreted. (encode_64 against the index statement under rme passed once but
// needs more than 33 GB; z3 did not finish it in 40 minutes.)
let lin_spec post = do {
  mats;
  rr <- llvm_alloc (w 8);
  ip <- llvm_alloc_readonly (llvm_array 32 (llvm_int 8));
  bits <- llvm_fresh_var "inbits" (llvm_array 32 (llvm_int 8));
  llvm_points_to ip (llvm_term bits);
  llvm_execute_func [rr, ip, llvm_term {{ 32 : [32] }}, llvm_global "_enc_mat"];
  llvm_points_to rr (llvm_term (post bits));
  // unchanged by the call, and restated so that SAW does not treat them as clobbered for the next batch
  llvm_points_to ip (llvm_term bits);
  llvm_points_to (llvm_global "_enc_mat") (llvm_global_initializer "_enc_mat");
  llvm_points_to (llvm_global "_dec_mat") (llvm_global_initializer "_dec_mat");
};
lin <- llvm_verify m "linear_map_x8" [] false (lin_spec (\b -> {{ lin8 b }})) rme;
fails (llvm_verify m "linear_map_x8" [] false (lin_spec (\b -> {{ lin8 b ^ flip }})) abc);
enc <- llvm_verify m "encode_64" [lin] false (enc_spec (\x -> {{ encode x }})) (w4_unint_z3 ["lin8"]);
fails (llvm_verify m "encode_64" [lin] false (enc_spec (\x -> {{ encode x ^ flip }})) (w4_unint_z3 ["lin8"]));
print "VERIFIED: encode_64(512, 32) == encode";

// decode_64(rfx, fx, n_u64 = 512): 512 words out (32768 bits), written byte by byte. Both linear maps
// are proved by rme (encode: 2026-10-25; decode with transpose_8x8 as an override: 110 s on the M4 Pro,
// 2026-10-26; z3 did not finish either in 40 minutes, and rme on decode without the override ran out of
// memory). The spec
// allocates 8 extra words after the output, never written and unconstrained by the postcondition;
// without them symbolic execution does not complete (A-HQC-FFT item 7).
let dec_spec post = do {
  mats;
  rp <- llvm_alloc (w 520);
  fp <- llvm_alloc_readonly (w 512);
  x <- llvm_fresh_var "fx" (w 512);
  llvm_points_to fp (llvm_term x);
  llvm_execute_func [rp, fp, llvm_term {{ 512 : [32] }}];
  llvm_points_to_untyped rp (llvm_term (post x));
};
// transpose_8x8(mat0): in place on 8 bytes.
let tr_spec post = do {
  p <- llvm_alloc (llvm_array 8 (llvm_int 8));
  x <- llvm_fresh_var "mat0" (llvm_array 8 (llvm_int 8));
  llvm_points_to p (llvm_term x);
  llvm_execute_func [p];
  llvm_points_to p (llvm_term (post x));
};
tr <- llvm_verify m "transpose_8x8" [] false (tr_spec (\x -> {{ transpose8 x }})) (w4_unint_z3 []);
fails (llvm_verify m "transpose_8x8" [] false (tr_spec (\x -> {{ transpose8 x ^ [1, 0, 0, 0, 0, 0, 0, 0] }})) (w4_unint_z3 []));
dec <- llvm_verify m "decode_64" [tr] false (dec_spec (\x -> {{ decode x }})) rme;
fails (llvm_verify m "decode_64" [tr] false (dec_spec (\x -> {{ decode x ^ flip }})) abc);
print "VERIFIED: decode_64(512) == decode (transpose_8x8 as override)";
// The model lemma: the C-shaped decode is the index statement.
decode_lemma <- prove_print rme {{ \x -> decode x == decodeIdx x }};
print "VERIFIED: decode == decodeIdx (model lemma)";
