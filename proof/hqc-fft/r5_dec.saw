// Additive-FFT reference, hqc-5: decode_64 at 2048 elements against decode5 (FFTEnc.cry), proved in
// 8 parts by batch range (A-HQC-FFT item 8). Output byte i + 256 (8 kb + jj) comes from batch i, so for
// a part of 32 batches [i0, i0 + 32) the expected bytes are 64 contiguous runs of 32 bytes at offsets
// i0 + 256 t, t < 64 (dbytes5 x i0 t); each part's goal depends on the part's 256 input words only.
// One obligation for the whole output needed more than 45 GB under rme at hqc-5; a part takes about
// 13 GB. transpose_8x8 is proved on its own and used as an override. The output buffer is a byte
// array with 32 words of slack (item 7). Each part has a mutant (one byte run flipped) that must fail.
import "FFTRef.cry";
import "FFTEnc.cry";
m <- llvm_load_module "../../build/hqc-fft/fft_ref.bc";
let w n = llvm_array n (llvm_int 64);
let mats = do {
  llvm_alloc_global "_enc_mat";
  llvm_points_to (llvm_global "_enc_mat") (llvm_global_initializer "_enc_mat");
  llvm_alloc_global "_dec_mat";
  llvm_points_to (llvm_global "_dec_mat") (llvm_global_initializer "_dec_mat");
};
let tr_spec post = do {
  p <- llvm_alloc (llvm_array 8 (llvm_int 8));
  x <- llvm_fresh_var "mat0" (llvm_array 8 (llvm_int 8));
  llvm_points_to p (llvm_term x);
  llvm_execute_func [p];
  llvm_points_to p (llvm_term (post x));
};
tr <- llvm_verify m "transpose_8x8" [] false (tr_spec (\x -> {{ transpose8 x }})) (w4_unint_z3 []);
fails (llvm_verify m "transpose_8x8" [] false (tr_spec (\x -> {{ transpose8 x ^ [1, 0, 0, 0, 0, 0, 0, 0] }})) (w4_unint_z3 []));
