// The artifact's HQC wiring (target/hqc-fft/hqc_wiring/gf2x.c, hqc-5 parameters) linked with the
// GF(2^64) reference: vect_mul(o, v1, v2) == vmulF5 (FFTWire.cry), the padded operands' FFT product
// folded mod x^57637 - 1. At hqc-5 the wiring calls the generic entry points at 1024 words directly.
// They are ASSUMED here and PROVED by fft_5.saw with the same expressions over specs.saw
// (scripts/hqc_fft_links.py); their models stay uninterpreted.
import "Fold.cry";
import "FFTTop5.cry";
import "FFTWire.cry";
m <- llvm_load_module "../../build/hqc-fft/wire_5.bc";
include "specs.saw";

pin5 <- llvm_unsafe_assume_spec m "polymul_input_transform" (in5_spec (\a -> {{ inputT5 a }}));
pm5 <- llvm_unsafe_assume_spec m "polymul_output" (out5_spec (\af bf -> {{ mulT5 af bf }}));

// vect_mul(o, v1, v2): 901 words out, two 901-word operands in separate buffers.
let vmul5_spec post = do {
  mats;
  op <- llvm_alloc (w 901);
  ap <- llvm_alloc_readonly (w 901);
  bp <- llvm_alloc_readonly (w 901);
  a <- llvm_fresh_var "a" (w 901);
  b <- llvm_fresh_var "b" (w 901);
  llvm_points_to ap (llvm_term a);
  llvm_points_to bp (llvm_term b);
  llvm_execute_func [op, ap, bp];
  llvm_points_to op (llvm_term (post a b));
};
vm <- llvm_verify m "vect_mul" [pin5, pm5] false (vmul5_spec (\a b -> {{ vmulF5 a b }})) (w4_unint_z3 ["inputT5", "mulT5"]);
fails (llvm_verify m "vect_mul" [pin5, pm5] false (vmul5_spec (\a b -> {{ vmulF5 a b ^ flip }})) (w4_unint_z3 ["inputT5", "mulT5"]));
print "VERIFIED: the HQC wiring's vect_mul (hqc-5) == vmulF5 = fold mod x^57637 - 1 of mulT5 on the padded operands (entry points assumed, proved by fft_5)";
