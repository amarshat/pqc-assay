// The artifact's HQC wiring (target/hqc-fft/hqc_wiring/gf2x.c, hqc-1 parameters) linked with the
// GF(2^64) reference: vect_mul(o, v1, v2) == vmulF1 (FFTWire.cry), the padded operands' FFT product
// folded mod x^17669 - 1. The two entry points are ASSUMED here (llvm_unsafe_assume_spec) and PROVED
// by fft_1.saw with the same expressions over specs.saw (scripts/hqc_fft_links.py checks this, as for
// fft_1's own assumptions); their models stay uninterpreted, so the obligations are the wrappers'
// buffer offsets, the padding of ring_to_fftform and ring_reduce.
import "Fold.cry";
import "FFTTop.cry";
import "FFTWire.cry";
m <- llvm_load_module "../../build/hqc-fft/wire_1.bc";
include "specs.saw";

pin <- llvm_unsafe_assume_spec m "polymul_280U64_input" (in_spec (\a -> {{ inputT a }}));
pm <- llvm_unsafe_assume_spec m "polymul_280U64_mul" (mul_spec (\a b af bf -> {{ mulT a b af bf }}));

// polymul_17920_input(a_fft, a): the transform, then a copy of a after it.
let in17920_spec post = do {
  mats;
  op <- llvm_alloc (w 792);
  ap <- llvm_alloc_readonly (w 280);
  a <- llvm_fresh_var "a" (w 280);
  llvm_points_to ap (llvm_term a);
  llvm_execute_func [op, ap];
  llvm_points_to op (llvm_term (post a));
  mats_post;
};
p17i <- llvm_verify m "polymul_17920_input" [pin] false (in17920_spec (\a -> {{ input17920 a }})) (w4_unint_z3 ["inputT"]);
fails (llvm_verify m "polymul_17920_input" [pin] false (in17920_spec (\a -> {{ input17920 a ^ flip }})) (w4_unint_z3 ["inputT"]));

// polymul_17920_mul(c, a_fft, b_fft): polymul_280U64_mul on the two halves.
let mul17920_spec post = do {
  mats;
  cp <- llvm_alloc (w 560);
  afp <- llvm_alloc_readonly (w 792);
  bfp <- llvm_alloc_readonly (w 792);
  af <- llvm_fresh_var "a_fft" (w 792);
  bf <- llvm_fresh_var "b_fft" (w 792);
  llvm_points_to afp (llvm_term af);
  llvm_points_to bfp (llvm_term bf);
  llvm_execute_func [cp, afp, bfp];
  llvm_points_to cp (llvm_term (post af bf));
  mats_post;
};
p17m <- llvm_verify m "polymul_17920_mul" [pm] false (mul17920_spec (\af bf -> {{ mul17920 af bf }})) (w4_unint_z3 ["mulT"]);
fails (llvm_verify m "polymul_17920_mul" [pm] false (mul17920_spec (\af bf -> {{ mul17920 af bf ^ flip }})) (w4_unint_z3 ["mulT"]));

// vect_mul(o, v1, v2): 277 words out, two 277-word operands in separate buffers.
let vmul_spec post = do {
  mats;
  op <- llvm_alloc (w 277);
  ap <- llvm_alloc_readonly (w 277);
  bp <- llvm_alloc_readonly (w 277);
  a <- llvm_fresh_var "a" (w 277);
  b <- llvm_fresh_var "b" (w 277);
  llvm_points_to ap (llvm_term a);
  llvm_points_to bp (llvm_term b);
  llvm_execute_func [op, ap, bp];
  llvm_points_to op (llvm_term (post a b));
};
vm <- llvm_verify m "vect_mul" [p17i, p17m] false (vmul_spec (\a b -> {{ vmulF1 a b }})) (w4_unint_z3 ["inputT", "mulT"]);
fails (llvm_verify m "vect_mul" [p17i, p17m] false (vmul_spec (\a b -> {{ vmulF1 a b ^ flip }})) (w4_unint_z3 ["inputT", "mulT"]));
print "VERIFIED: the HQC wiring's vect_mul (hqc-1) == vmulF1 = fold mod x^17669 - 1 of mulT on the padded operands (entry points assumed, proved by fft_1)";
