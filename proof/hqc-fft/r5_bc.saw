// Additive-FFT reference, hqc-5: the basis conversions this size uses, each as its routines against
// their layers (FFTBC.cry), then the composition.
import "FFTRef.cry";
import "FFTEnc.cry";
import "FFTBC.cry";
m <- llvm_load_module "../../build/hqc-fft/fft_ref.bc";
include "specs.saw";

rp5 <- llvm_verify m "repr_s8_1_65536" [] false (bc_spec 2048 [] (\x -> {{ repr64W x }})) rme;
fails (llvm_verify m "repr_s8_1_65536" [] false (bc_spec 2048 [] (\x -> {{ repr64W x ^ flip }})) abc);
b25 <- llvm_verify m "bc_256" [] false (bc_spec 2048 [n256] (\x -> {{ bc256of64W x }})) rme;
fails (llvm_verify m "bc_256" [] false (bc_spec 2048 [n256] (\x -> {{ bc256of64W x ^ flip }})) abc);
b15 <- llvm_verify m "bc_1_256" [] false (bc_spec 2048 [n256] (\x -> {{ bc1of256of64W x }})) rme;
fails (llvm_verify m "bc_1_256" [] false (bc_spec 2048 [n256] (\x -> {{ bc1of256of64W x ^ flip }})) abc);
bc5 <- llvm_verify m "bc_1" [rp5, b25, b15] false (bc_spec 2048 [n8192] (\x -> {{ bc1_65536wc x }})) (w4_unint_z3 ["repr64W", "bc256of64W", "bc1of256of64W"]);
fails (llvm_verify m "bc_1" [rp5, b25, b15] false (bc_spec 2048 [n8192] (\x -> {{ bc1_65536wc x ^ flip }})) (w4_unint_z3 ["repr64W", "bc256of64W", "bc1of256of64W"]));
irp5 <- llvm_verify m "irepr_s8_1" [] false (bc_spec 4096 [n16384] (\x -> {{ irepr128W x }})) rme;
fails (llvm_verify m "irepr_s8_1" [] false (bc_spec 4096 [n16384] (\x -> {{ irepr128W x ^ flip }})) abc);
ib25 <- llvm_verify m "ibc_256" [] false (bc_spec 4096 [n512] (\x -> {{ icvt128W x }})) rme;
fails (llvm_verify m "ibc_256" [] false (bc_spec 4096 [n512] (\x -> {{ icvt128W x ^ flip }})) abc);
ib15 <- llvm_verify m "ibc_1_256" [] false (bc_spec 4096 [n512] (\x -> {{ ibc1of256of128W x }})) rme;
fails (llvm_verify m "ibc_1_256" [] false (bc_spec 4096 [n512] (\x -> {{ ibc1of256of128W x ^ flip }})) abc);
ibc5 <- llvm_verify m "ibc_1" [irp5, ib25, ib15] false (bc_spec 4096 [n16384] (\x -> {{ ibc1_131072w x }})) (w4_unint_z3 ["irepr128W", "icvt128W", "ibc1of256of128W"]);
fails (llvm_verify m "ibc_1" [irp5, ib25, ib15] false (bc_spec 4096 [n16384] (\x -> {{ ibc1_131072w x ^ flip }})) (w4_unint_z3 ["irepr128W", "icvt128W", "ibc1of256of128W"]));
print "VERIFIED: hqc-5 bc_1(8192) == bc1_65536wc and ibc_1(16384) == ibc1_131072w, with their routines";

