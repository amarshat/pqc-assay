// Additive-FFT reference, hqc-5: the entry points against FFTTop5.cry with the routines' specs
// ASSUMED (proved by r5_net.saw, r5_enc.saw, r5_bc.saw and ref_1.saw, which `make hqc-fft-5` runs
// first in their own processes). Each assumed spec is an expression over specs.saw that those scripts
// pass to llvm_verify verbatim; scripts/hqc_fft_links.py checks this (A-HQC-FFT item 8).
import "FFTRef.cry";
import "FFTEnc.cry";
import "FFTBC.cry";
import "FFTTop5.cry";
m <- llvm_load_module "../../build/hqc-fft/fft_ref.bc";
include "specs.saw";

gfv5 <- llvm_unsafe_assume_spec m "gf264v_mul" (gfv_spec 2048 {{ 2048 : [32] }} (\a b -> {{ gf264v a b }}));
bt5 <- llvm_unsafe_assume_spec m "btfy_64" (btfy_spec 2048 {{ 11 : [32] }} {{ 1 << 43 : [64] }} (\x -> {{ btfy11 (1 << 43) x }}));
ibt5 <- llvm_unsafe_assume_spec m "ibtfy_64" (btfy_spec 2048 {{ 11 : [32] }} {{ 1 << 43 : [64] }} (\x -> {{ ibtfy11 (1 << 43) x }}));
enc5 <- llvm_unsafe_assume_spec m "encode_64" (enc_spec 2048 1024 {{ 2048 : [32] }} (\x -> {{ encode5 x }}));
dec5 <- llvm_unsafe_assume_spec m "decode_64" (dec_spec 2048 0 {{ 2048 : [32] }} (\x -> {{ decode5 x }}));
bc5 <- llvm_unsafe_assume_spec m "bc_1" (bc_spec 2048 [n8192] (\x -> {{ bc1_65536wc x }}));
ibc5 <- llvm_unsafe_assume_spec m "ibc_1" (bc_spec 4096 [n16384] (\x -> {{ ibc1_131072w x }}));

// The entry points. polymul_output writes 2048 words; the buffer is exactly that size.
let in5_spec post = do {
  mats;   // the encode/decode overrides read the matrices, so the caller allocates them
  op <- llvm_alloc (w 2048);
  ap <- llvm_alloc_readonly (w 1024);
  a <- llvm_fresh_var "a" (w 1024);
  llvm_points_to ap (llvm_term a);
  llvm_execute_func [op, ap, llvm_term {{ 1024 : [32] }}];
  llvm_points_to op (llvm_term (post a));
};
pin5 <- llvm_verify m "polymul_input_transform" [bc5, enc5, bt5] false (in5_spec (\a -> {{ inputT5 a }})) (w4_unint_z3 ["bc1_65536wc", "encode5", "btfy11"]);
fails (llvm_verify m "polymul_input_transform" [bc5, enc5, bt5] false (in5_spec (\a -> {{ inputT5 a ^ flip }})) (w4_unint_z3 ["bc1_65536wc", "encode5", "btfy11"]));
let out5_spec post = do {
  mats;   // the encode/decode overrides read the matrices, so the caller allocates them
  cp <- llvm_alloc (w 2048);
  afp <- llvm_alloc_readonly (w 2048);
  bfp <- llvm_alloc_readonly (w 2048);
  af <- llvm_fresh_var "a_fft" (w 2048);
  bf <- llvm_fresh_var "b_fft" (w 2048);
  llvm_points_to afp (llvm_term af);
  llvm_points_to bfp (llvm_term bf);
  llvm_execute_func [cp, afp, bfp, llvm_term {{ 1024 : [32] }}];
  llvm_points_to_untyped cp (llvm_term (post af bf));
};
let stages5 = ["gf264v", "ibtfy11", "decode5", "ibc1_131072w"];
pm5 <- llvm_verify m "polymul_output" [gfv5, ibt5, dec5, ibc5] false (out5_spec (\af bf -> {{ mulT5 af bf }})) (w4_unint_z3 stages5);
fails (llvm_verify m "polymul_output" [gfv5, ibt5, dec5, ibc5] false (out5_spec (\af bf -> {{ mulT5 af bf ^ flip }})) (w4_unint_z3 stages5));
print "VERIFIED: hqc-5 polymul_input_transform(1024) / polymul_output(1024) == inputT5 / mulT5";
