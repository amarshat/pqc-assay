// Additive-FFT reference, hqc-5: encode_64 and decode_64 at this length (linear_map_x8 and
// transpose_8x8 proved on their own and used as overrides; A-HQC-FFT items 7 and 8).
import "FFTRef.cry";
import "FFTEnc.cry";
import "FFTBC.cry";
m <- llvm_load_module "../../build/hqc-fft/fft_ref.bc";
include "specs.saw";

lin <- llvm_verify m "linear_map_x8" [] false (lin_spec (\b -> {{ lin8 b }})) rme;
fails (llvm_verify m "linear_map_x8" [] false (lin_spec (\b -> {{ lin8 b ^ flip }})) abc);
enc5 <- llvm_verify m "encode_64" [lin] false (enc_spec 2048 1024 {{ 2048 : [32] }} (\x -> {{ encode5 x }})) (w4_unint_z3 ["lin8"]);
fails (llvm_verify m "encode_64" [lin] false (enc_spec 2048 1024 {{ 2048 : [32] }} (\x -> {{ encode5 x ^ flip }})) (w4_unint_z3 ["lin8"]));
// decode_64 at this length is proved by r5_dec.saw, in parts by batch range.
