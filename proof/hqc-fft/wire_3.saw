// The artifact's HQC wiring (target/hqc-fft/hqc_wiring/gf2x.c, hqc-3 parameters) linked with the
// GF(2^64) reference: vect_mul(o, v1, v2) == vmulF3 (FFTWire.cry), the padded operands' FFT product
// folded mod x^35851 - 1. The two entry points are ASSUMED here (llvm_unsafe_assume_spec) and PROVED
// by fft_3.saw with the same expressions over specs.saw (scripts/hqc_fft_links.py checks this, as for
// fft_3's own assumptions); their models stay uninterpreted, so the obligations are the wrappers'
// buffer offsets, the padding of ring_to_fftform and ring_reduce.
import "Fold.cry";
import "FFTTop3.cry";
import "FFTWire.cry";
m <- llvm_load_module "../../build/hqc-fft/wire_3.bc";
include "specs.saw";

pin <- llvm_unsafe_assume_spec m "polymul_576U64_input" (in3_spec (\a -> {{ inputT3 a }}));
pm <- llvm_unsafe_assume_spec m "polymul_576U64_mul" (mul3_spec (\a b af bf -> {{ mulT3 a b af bf }}));

// polymul_36864_input(a_fft, a): the transform, then a copy of a after it.
let in36864_spec post = do {
  mats;
  op <- llvm_alloc (w 1600);
  ap <- llvm_alloc_readonly (w 576);
  a <- llvm_fresh_var "a" (w 576);
  llvm_points_to ap (llvm_term a);
  llvm_execute_func [op, ap];
  llvm_points_to op (llvm_term (post a));
  mats_post;
};
p17i <- llvm_verify m "polymul_36864_input" [pin] false (in36864_spec (\a -> {{ input36864 a }})) (w4_unint_z3 ["inputT3"]);
fails (llvm_verify m "polymul_36864_input" [pin] false (in36864_spec (\a -> {{ input36864 a ^ flip }})) (w4_unint_z3 ["inputT3"]));

// polymul_36864_mul(c, a_fft, b_fft): polymul_280U64_mul on the two halves.
let mul36864_spec post = do {
  mats;
  cp <- llvm_alloc (w 1152);
  afp <- llvm_alloc_readonly (w 1600);
  bfp <- llvm_alloc_readonly (w 1600);
  af <- llvm_fresh_var "a_fft" (w 1600);
  bf <- llvm_fresh_var "b_fft" (w 1600);
  llvm_points_to afp (llvm_term af);
  llvm_points_to bfp (llvm_term bf);
  llvm_execute_func [cp, afp, bfp];
  llvm_points_to cp (llvm_term (post af bf));
  mats_post;
};
p17m <- llvm_verify m "polymul_36864_mul" [pm] false (mul36864_spec (\af bf -> {{ mul36864 af bf }})) (w4_unint_z3 ["mulT3"]);
fails (llvm_verify m "polymul_36864_mul" [pm] false (mul36864_spec (\af bf -> {{ mul36864 af bf ^ flip }})) (w4_unint_z3 ["mulT3"]));

// vect_mul(o, v1, v2): 277 words out, two 277-word operands in separate buffers.
let vmul_spec post = do {
  mats;
  op <- llvm_alloc (w 561);
  ap <- llvm_alloc_readonly (w 561);
  bp <- llvm_alloc_readonly (w 561);
  a <- llvm_fresh_var "a" (w 561);
  b <- llvm_fresh_var "b" (w 561);
  llvm_points_to ap (llvm_term a);
  llvm_points_to bp (llvm_term b);
  llvm_execute_func [op, ap, bp];
  llvm_points_to op (llvm_term (post a b));
};
vm <- llvm_verify m "vect_mul" [p17i, p17m] false (vmul_spec (\a b -> {{ vmulF3 a b }})) (w4_unint_z3 ["inputT3", "mulT3"]);
fails (llvm_verify m "vect_mul" [p17i, p17m] false (vmul_spec (\a b -> {{ vmulF3 a b ^ flip }})) (w4_unint_z3 ["inputT3", "mulT3"]));
print "VERIFIED: the HQC wiring's vect_mul (hqc-3) == vmulF3 = fold mod x^35851 - 1 of mulT on the padded operands (entry points assumed, proved by fft_3)";
