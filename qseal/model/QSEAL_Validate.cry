// Q-SEAL request validation: the applet rejects a malformed request BEFORE signing (section 16
// property 7, "any malformed length, version, suite, or origin fails before signing"). Section 11.2
// CREATE_ASSERTION requires the applet to validate the requested suite and assertion type and reject
// unsupported origins. We model that gate and prove a malformed request never produces a transcript.
//
// The field enumerations are from the spec: version = 0x01 (TBS-V1, section 7); suite_id = 0x0001
// (HYB-1, the only mandatory suite, section 4); assertion_type in 0x01..0x06 (section 8);
// assertion_origin in 0x01..0x03 (section 9); object_hash_algorithm = 0x01 (SHA-256, the suite digest).
//
// Verified with cryptol :prove (z3). The C reference is qseal/ref/validate.c, proved equal to `valid`
// and `create_checked` by qseal/proof/validate.saw.

module QSEAL_Validate where

import QSEAL_Assertion   // Request, AppletId, create

// The spec-defined well-formedness gate over the fields the applet checks before signing.
valid : Request -> AppletId -> Bit
valid r a =
     (a.version == [0x01])
  && (r.suite_id == [0x00, 0x01])
  && (t >= 0x01) && (t <= 0x06)
  && (t != 0x04)                        // PROFILE_ACTION_OBSERVED is not host-callable (spec 8.4)
  && (o >= 0x01) && (o <= 0x03)
  && (r.object_hash_algorithm == [0x01])
  where
    t = r.assertion_type   @ 0
    o = r.assertion_origin @ 0

// The observed assertion type the host CREATE_ASSERTION must refuse. This is the code-level counterpart
// of the ProVerif guard in proof/proverif/property5.pv (`if t <> OBSERVED`): property 5 proves the
// observed type is reachable only via the trusted internal callback given that the host path rejects it,
// and this gate is where the verified C enforces that rejection.
OBSERVED : [8]
OBSERVED = 0x04

// The applet signs only after validation. The outcome is (signed?, transcript); a rejected request
// produces no transcript (the applet does not sign).
type Signed = { ok : Bit, tbs : [231][8] }

create_checked : Request -> AppletId -> Signed
create_checked r a =
  if valid r a then { ok = True,  tbs = create r a }
               else { ok = False, tbs = zero }

// ---- Section 16 property 7 ----------------------------------------------------------------------

// The headline: any malformed version / suite / assertion_type / origin / hash algorithm fails before
// signing. If the request is not valid, the applet emits no transcript.
// DEFINITIONAL. `create_checked` is defined as `if valid r a then ... else {ok = False, ...}`, so this
// unfolds to `~p ==> ~p`. It is not independent content and should not be counted as one of the
// protocol properties. It is kept because it is a specification-mutation regression check: an edit to
// the else branch of create_checked breaks it. What carries weight here is the SAW obligation that the
// C reference computes create_checked, which is not definitional.
property malformed_never_signs r a = (~ valid r a) ==> (~ (create_checked r a).ok)

// DEFINITIONAL for the same reason: it unfolds to `valid ==> valid /\ (x == x)`. Kept as a
// specification-mutation regression check, not as evidence about the design. An earlier comment here
// called it "the other direction, with content", which was wrong.
property signed_is_validated r a =
  (create_checked r a).ok ==> (valid r a /\ ((create_checked r a).tbs == create r a))

// ---- Mutation / non-vacuity ---------------------------------------------------------------------

// The buggy validator drops the suite check, so it would sign a request under an unsupported suite
// (exactly what section 4 says the verifier MUST reject: "an unsupported suite identifier").
valid_nosuite : Request -> AppletId -> Bit
valid_nosuite r a =
     (a.version == [0x01])
  && (t >= 0x01) && (t <= 0x06)
  && (o >= 0x01) && (o <= 0x03)
  && (r.object_hash_algorithm == [0x01])
  where
    t = r.assertion_type   @ 0
    o = r.assertion_origin @ 0

// A witness that the bug is real: the buggy gate accepts a request the spec rejects. `:sat` must be
// Satisfiable, which catches the mutant and shows the good properties are non-vacuous (valid is
// reachable, since valid_nosuite is a relaxation of valid).
bug_signs_malformed : Request -> AppletId -> Bit
bug_signs_malformed r a = valid_nosuite r a && (~ valid r a)

// A second buggy validator that keeps the suite check but drops the observed-type rejection, so it would
// let the host sign a PROFILE_ACTION_OBSERVED (0x04) assertion (spec 8.4 forbids this; property 5).
valid_allowobserved : Request -> AppletId -> Bit
valid_allowobserved r a =
     (a.version == [0x01])
  && (r.suite_id == [0x00, 0x01])
  && (t >= 0x01) && (t <= 0x06)
  && (o >= 0x01) && (o <= 0x03)
  && (r.object_hash_algorithm == [0x01])
  where
    t = r.assertion_type   @ 0
    o = r.assertion_origin @ 0

// The observed-type bug accepts a host request the spec rejects (type 0x04). `:sat` must be Satisfiable.
bug_signs_observed : Request -> AppletId -> Bit
bug_signs_observed r a = valid_allowobserved r a && (~ valid r a)
