// GENERATED-BY-HAND COUNTERPART to hybrid.saw, kept so the claim in the paper can be run rather than
// read. It differs from hybrid.saw in exactly five places: the tactic argument at three llvm_verify
// sites, and the two `fails (...)` wrappers, which must go because the mutants no longer fail.
//
// Under w4_unint_z3 ["vE","vM"] the obligation says both signatures are required over the same
// transcript, and both mutants are rejected. Under the default z3 the Cryptol placeholders for vE and
// vM (constantly False, QSEAL_Verify.cry) unfold, every acceptance term collapses to False, and the
// obligation is satisfied by the honest function AND by both mutants. Expected output: three
// "Proof succeeded!" lines and exit 0. That is the point: the result depends on the tactic.
//
// Run by `make qseal-tactic-collapse`, which fails if any of the three stops verifying.
enable_experimental;

m <- llvm_load_module "../build/hybrid.bc";
import "../model/QSEAL_Verify.cry";

let arr n = llvm_array n (llvm_int 8);
let ro nm n = do {
    x <- llvm_fresh_var nm (arr n);
    p <- llvm_alloc_readonly (arr n);
    llvm_points_to p (llvm_term x);
    return (x, p);
};

// Uninterpreted verifier overrides: return 1 iff the abstract verifier holds.
let vE_spec = do {
    (pk, ppk)   <- ro "pk_c" 64;
    (tbs, ptbs) <- ro "tbs" 231;
    (sig, psig) <- ro "sig_c" 64;
    llvm_execute_func [ppk, ptbs, psig];
    llvm_return (llvm_term {{ if vE pk tbs sig then (1 : [32]) else 0 }});
};
vE_ov <- llvm_unsafe_assume_spec m "qseal_verify_ecdsa" vE_spec;

let vM_spec = do {
    (pk, ppk)   <- ro "pk_pq" 1312;
    (tbs, ptbs) <- ro "tbs" 231;
    (sig, psig) <- ro "sig_pq" 2420;
    llvm_execute_func [ppk, ptbs, psig];
    llvm_return (llvm_term {{ if vM pk tbs sig then (1 : [32]) else 0 }});
};
vM_ov <- llvm_unsafe_assume_spec m "qseal_verify_mldsa" vM_spec;

// The both-required spec: accept iff vE(pk_c, tbs, sig_c) AND vM(pk_pq, tbs, sig_pq), same tbs.
let accept_spec = do {
    (tbs, ptbs) <- ro "tbs" 231;
    (pkc, ppkc) <- ro "pk_c" 64;
    (sc,  psc)  <- ro "sig_c" 64;
    (pkq, ppkq) <- ro "pk_pq" 1312;
    (sq,  psq)  <- ro "sig_pq" 2420;
    llvm_execute_func [ptbs, ppkc, psc, ppkq, psq];
    llvm_return (llvm_term {{ if (vE pkc tbs sc /\ vM pkq tbs sq) then (1 : [32]) else 0 }});
};

accept_ov <- llvm_verify m "qseal_hybrid_accept" [vE_ov, vM_ov] true accept_spec
                         z3;
print "VERIFIED: qseal_hybrid_accept == vE(pk_c,tbs,sig_c) AND vM(pk_pq,tbs,sig_pq) -- both required, same transcript";

// The downgrade variant must NOT satisfy the both-required spec. `fails` succeeds iff the verify fails.
llvm_verify m "qseal_hybrid_accept_downgrade" [vE_ov, vM_ov] true accept_spec
                   z3;
print "PLAIN Z3: the downgrade variant VERIFIED against the both-required spec";

// A conjunction is not enough: this mutant also requires both signatures, but over different bytes.
// The tactic matters here. Under plain z3 the placeholder bodies of vE and vM (both constantly False)
// unfold, every acceptance term collapses to False and ANY implementation satisfies the spec. Only
// w4_unint_z3, keeping vE and vM uninterpreted, makes this a statement about the acceptance structure.
llvm_verify m "qseal_hybrid_accept_othertbs" [vE_ov, vM_ov] true accept_spec
                   z3;
print "PLAIN Z3: the split-transcript variant VERIFIED";
