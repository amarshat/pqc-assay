(* Reachability witness for property 5 (see property5.pv). Q-SEAL section 16 property 5: PROFILE_ACTION_OBSERVED (assertion type 0x04) cannot be reached
   through a host-exposed APDU path. Spec 8.4: that assertion type is produced ONLY from a trusted
   internal eUICC event callback after a profile state transition, and "MUST NOT be callable directly by
   a handset application."

   This is a reachability property over the command surface, not a fixed-format identity, so it is
   modelled and checked in ProVerif (symbolic / Dolev-Yao). The host APDU channel is attacker-controlled;
   the internal callback is a private channel the attacker cannot use. The correspondence is INJECTIVE
   and PARAMETERISED by the event data (id, subject, object digest, policy): each observed-action signing
   is preceded by a distinct trusted internal callback carrying the same data, so the host can neither
   originate an observed assertion nor replay one internal callback into several assertions.

   property5_mutant.pv drops the host-path guard and ProVerif falsifies the same query, and
   property5_reachable.pv witnesses that SignedObserved is reachable here at all.

   WHAT THIS MODEL DOES AND DOES NOT ESTABLISH. It shows that in this model the host command path
   cannot produce an observed-action assertion, and (with the witness file) that the observed path is
   live. It does not show much more than that: InternalFired and SignedObserved are consecutive
   statements in the only process that emits either, so the correspondence is close to syntactic. There
   is no applet state, no transcript and no signature verification in here. Rebuilding it with those is
   tracked as F1-1 in paper/notes/QSEAL-REVIEW-PLAN.md, and until that lands this file should be
   described as what it is. *)

free host: channel.                  (* host-exposed APDU path: attacker-controlled *)
free internalCb: channel [private].  (* trusted internal event callback: not attacker-reachable *)

type key.
fun sign(bitstring, key): bitstring.

free sk: key [private].              (* applet signing key *)

const OBSERVED: bitstring.           (* assertion type PROFILE_ACTION_OBSERVED (0x04) *)

(* Event data: a callback/assertion carries an event id, subject, object digest, and policy. *)
event SignedObserved(bitstring, bitstring, bitstring, bitstring).
event InternalFired(bitstring, bitstring, bitstring, bitstring).
event SignedOther(bitstring).

(* Host-callable CREATE_ASSERTION: the handset supplies the assertion type and request. The applet must
   NOT sign an OBSERVED assertion on this path (spec 8.4). *)
let hostCreate =
  in(host, (t: bitstring, req: bitstring));
  if t <> OBSERVED then
  (
    event SignedOther(t);
    out(host, sign((t, req), sk))
  ).

(* Trusted internal callback: fires only after a real profile state transition, then signs the OBSERVED
   assertion for that specific event. Reached over a private channel, so the attacker cannot invoke it. *)
(* The eUICC's profile state machine. A real profile state transition inside the card hands the event to
   the applet over the private callback channel. The attacker may influence WHICH profile operation
   happens (it supplies the subject, digest and policy over the host channel) but cannot write to
   internalCb itself. Without this process nothing ever outputs on internalCb, `internalObserved` never
   runs, and the correspondence below holds vacuously. That defect was found in an audit of the
   submitted artifact on 2026-08-22; see docs/ASSUMPTIONS.md OF-3. *)
let profileTransition =
  in(host, (subject: bitstring, digest: bitstring, policy: bitstring));
  new id: bitstring;
  out(internalCb, (id, subject, digest, policy)).

let internalObserved =
  in(internalCb, (id: bitstring, subject: bitstring, digest: bitstring, policy: bitstring));
  event InternalFired(id, subject, digest, policy);
  event SignedObserved(id, subject, digest, policy);
  out(host, sign((OBSERVED, id, subject, digest, policy), sk)).

(* Reachability witness. This file exists so the positive result in property5.pv cannot be vacuous: it
   asks whether SignedObserved is reachable at all. ProVerif answers by trying to prove the event is
   never emitted, so the expected output is "RESULT not event(SignedObserved(...)) is false.", meaning a
   trace exists that emits it. If this file ever reports true, the honest model has gone dead again and
   the correspondence in property5.pv means nothing. *)
query id: bitstring, subject: bitstring, digest: bitstring, policy: bitstring;
  event(SignedObserved(id, subject, digest, policy)).

process
  ( (!hostCreate) | (!internalObserved) | (!profileTransition) )
