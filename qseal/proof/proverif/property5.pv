(* Q-SEAL section 16 property 5: PROFILE_ACTION_OBSERVED (assertion type 0x04) cannot be reached
   through a host-exposed APDU path. Spec 8.4: that assertion type is produced ONLY from a trusted
   internal eUICC event callback after a profile state transition, and "MUST NOT be callable directly by
   a handset application."

   This is a reachability property over the command surface, not a fixed-format identity, so it is
   modelled and checked in ProVerif (symbolic / Dolev-Yao). The host APDU channel is attacker-controlled;
   the internal callback is a private channel the attacker cannot use. The correspondence is INJECTIVE
   and PARAMETERISED by the event data (id, subject, object digest, policy): each observed-action signing
   is preceded by a distinct trusted internal callback carrying the same data, so the host can neither
   originate an observed assertion nor replay one internal callback into several assertions.

   property5_mutant.pv drops the host-path guard and ProVerif falsifies the same query. *)

free host: channel.                  (* host-exposed APDU path: attacker-controlled *)
free internalCb: channel [private].  (* trusted internal event callback: not attacker-reachable *)

type key.
fun sign(bitstring, key): bitstring.

free sk: key [private].              (* applet signing key *)

const OBSERVED: bitstring.           (* assertion type PROFILE_ACTION_OBSERVED (0x04) *)

(* Event data: a callback/assertion carries an event id, subject, object digest, and policy. *)
event SignedObserved(bitstring, bitstring, bitstring, bitstring).
event InternalFired(bitstring, bitstring, bitstring, bitstring).
event SignedOther(bitstring).

(* Host-callable CREATE_ASSERTION: the handset supplies the assertion type and request. The applet must
   NOT sign an OBSERVED assertion on this path (spec 8.4). *)
let hostCreate =
  in(host, (t: bitstring, req: bitstring));
  if t <> OBSERVED then
  (
    event SignedOther(t);
    out(host, sign((t, req), sk))
  ).

(* Trusted internal callback: fires only after a real profile state transition, then signs the OBSERVED
   assertion for that specific event. Reached over a private channel, so the attacker cannot invoke it. *)
let internalObserved =
  in(internalCb, (id: bitstring, subject: bitstring, digest: bitstring, policy: bitstring));
  event InternalFired(id, subject, digest, policy);
  event SignedObserved(id, subject, digest, policy);
  out(host, sign((OBSERVED, id, subject, digest, policy), sk)).

(* Injective correspondence: every observed-action signing, with its event data, is preceded by a
   distinct internal callback carrying the same data. *)
query id: bitstring, subject: bitstring, digest: bitstring, policy: bitstring;
  inj-event(SignedObserved(id, subject, digest, policy)) ==>
  inj-event(InternalFired(id, subject, digest, policy)).

process
  ( (!hostCreate) | (!internalObserved) )
