(* Mutant of property5.pv: the host-callable CREATE_ASSERTION drops the guard, so on an OBSERVED request
   it signs and emits SignedObserved with host-supplied event data and no internal callback. ProVerif
   must FALSIFY the injective correspondence (an observed-action assertion with no matching
   InternalFired), which is the host-exposed reachability the property forbids. The runner treats "query
   is true" here as a failure. *)

free host: channel.
free internalCb: channel [private].

type key.
fun sign(bitstring, key): bitstring.

free sk: key [private].

const OBSERVED: bitstring.

event SignedObserved(bitstring, bitstring, bitstring, bitstring).
event InternalFired(bitstring, bitstring, bitstring, bitstring).
event SignedOther(bitstring).

(* BUG: no `if t <> OBSERVED` guard. On an OBSERVED request the host obtains an observed-action assertion
   directly, with event data it chose. *)
let hostCreate =
  in(host, (t: bitstring, req: bitstring));
  if t = OBSERVED then
  (
    event SignedObserved(req, req, req, req);
    out(host, sign((OBSERVED, req), sk))
  )
  else
  (
    event SignedOther(t);
    out(host, sign((t, req), sk))
  ).

(* The eUICC's profile state machine. A real profile state transition inside the card hands the event to
   the applet over the private callback channel. The attacker may influence WHICH profile operation
   happens (it supplies the subject, digest and policy over the host channel) but cannot write to
   internalCb itself. Without this process nothing ever outputs on internalCb, `internalObserved` never
   runs, and the correspondence below holds vacuously. That defect was found in an audit of the
   submitted artifact on 2026-08-22; see docs/ASSUMPTIONS.md OF-3. *)
let profileTransition =
  in(host, (subject: bitstring, digest: bitstring, policy: bitstring));
  new id: bitstring;
  out(internalCb, (id, subject, digest, policy)).

let internalObserved =
  in(internalCb, (id: bitstring, subject: bitstring, digest: bitstring, policy: bitstring));
  event InternalFired(id, subject, digest, policy);
  event SignedObserved(id, subject, digest, policy);
  out(host, sign((OBSERVED, id, subject, digest, policy), sk)).

query id: bitstring, subject: bitstring, digest: bitstring, policy: bitstring;
  inj-event(SignedObserved(id, subject, digest, policy)) ==>
  inj-event(InternalFired(id, subject, digest, policy)).

process
  ( (!hostCreate) | (!internalObserved) | (!profileTransition) )
